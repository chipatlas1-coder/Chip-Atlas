---
/** Card for one article: its plate as a thumbnail, where it sits in the atlas, and its title.
    The thumbnail carries the same view-transition name as the article's hero plate, so it
    grows into the header when the reader opens the page. */
import Plate from './plates/Plate.astro';
import Emblem from './Emblem.astro';
import { hasPlate } from '../data/plates';
import { href, t } from '../i18n';
import { sections } from '../data/sections';
import { articlePath, type Article } from '../lib/articles';
interface Props { a: Article; showDesc?: boolean }
const { a, showDesc = false } = Astro.props;
const locale = a.data.locale;
const ui = t(locale);
const sec = sections.find((s) => s.n === a.data.section)!;
const sub = sec.subsections.find((s) => s.slug.en === a.data.subsection);
---
<a class="acard" href={href(articlePath(a))}>
  {hasPlate(a.data.key) ? <Plate k={a.data.key} locale={locale} mode="thumb" /> : <div class="plate thumb blank"><span class="bl-em"><Emblem n={sec.n} size="100%" /></span></div>}
  <span class="where">{String(sec.n).padStart(2, '0')} {sub ? sub.name[locale] : sec.name[locale]}</span>
  <span class="ttl">{a.data.title}</span>
  {showDesc && <span class="dsc">{a.data.description}</span>}
  {a.data.status === 'review' && <span class="mark mark-review">{ui.status.review}</span>}
</a>

<style>
  .acard { display: grid; gap: 0.45rem; align-content: start; color: inherit; }
  .acard :global(.plate) { transition: border-color 200ms, transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .acard:hover :global(.plate), .acard:focus-visible :global(.plate) { border-color: var(--accent); transform: translateY(-3px); }
  .blank { aspect-ratio: 3 / 2; display: grid; place-items: center; background-image: radial-gradient(60% 70% at 50% 45%, color-mix(in oklab, var(--color-temper-straw) 14%, white), white 72%) !important; }
  .bl-em { width: 34%; display: block; }
  .where { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-3); margin-top: 0.35rem; }
  .ttl { font-weight: 600; font-size: 1.02rem; line-height: 1.3; transition: color 160ms; }
  .acard:hover .ttl { color: var(--color-spark-400); }
  .dsc { font-size: 0.88rem; color: var(--ink-3); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
