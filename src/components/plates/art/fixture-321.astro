---
/* A prismatic part on the 3-2-1 locators, isometric: three under the first plane, two on the second, one on the
   third, each touching at a point; a clamp pushes the part down onto the locators. Schematic. */
interface Props { locale: 'en' | 'tr'; label?: string }
const { locale, label } = Astro.props;
const tr = locale === 'tr';
const T = tr ? { p: '3', s: '2', t: '1', clamp: 'bağlama' } : { p: '3', s: '2', t: '1', clamp: 'clamp' };
const L = 200, W = 100, H = 64, K = 0.866;
type V = [number, number, number];
const P0 = ([x, y, z]: V) => [(x - y) * K, -(x + y) * 0.5 - z];
// fit the drawing (base plate, part, clamp and its label) into the 480 × 320 plate with a margin
const ext: V[] = [[-56, -56, -36], [L + 26, -56, -36], [-56, W + 26, -36], [L + 26, W + 26, -24], [L, W, H], [L - 26, W / 2, H + 66]];
const xs = ext.map((v) => P0(v)[0]), ys = ext.map((v) => P0(v)[1]);
const SC = Math.min(452 / (Math.max(...xs) - Math.min(...xs)), 292 / (Math.max(...ys) - Math.min(...ys)));
const OX = 240 - SC * (Math.max(...xs) + Math.min(...xs)) / 2, OY = 160 - SC * (Math.max(...ys) + Math.min(...ys)) / 2;
const P = (v: V) => { const [a, b] = P0(v); return [OX + SC * a, OY + SC * b]; };
const pt = (v: V) => P(v).map((n) => n.toFixed(1)).join(',');
const V8 = (i: number): V => [i & 1 ? L : 0, i & 2 ? W : 0, i & 4 ? H : 0];
const face = (ix: number[]) => `M${ix.map((i) => pt(V8(i))).join(' L')} Z`;
const B = (x: number, y: number, z = -24): V => [x, y, z];
const prim: V[] = [[26, 22, 0], [26, W - 22, 0], [L - 26, W / 2, 0]];
const sec: V[] = [[36, 0, H / 2], [L - 36, 0, H / 2]];
const ter: V = [0, W / 2 + 14, H / 2];
const seg = (a: V, b: V) => { const [x1, y1] = P(a), [x2, y2] = P(b); return { x1, y1, x2, y2 }; };
---
<svg viewBox="0 0 480 320" role="img" aria-label={label}>
  <g class="f" style="--i:0">
    <path d={`M${pt(B(-56, -56))} L${pt(B(L + 26, -56))} L${pt(B(L + 26, W + 26))} L${pt(B(-56, W + 26))} Z`} fill="#e7ecf1" stroke="#9aa6b2" />
    <path d={`M${pt(B(-56, -56))} L${pt(B(L + 26, -56))} L${pt(B(L + 26, -56, -36))} L${pt(B(-56, -56, -36))} Z`} fill="#cfd7df" stroke="#9aa6b2" />
    <path d={`M${pt(B(-56, -56))} L${pt(B(-56, W + 26))} L${pt(B(-56, W + 26, -36))} L${pt(B(-56, -56, -36))} Z`} fill="#dbe2e9" stroke="#9aa6b2" />
  </g>
  <g class="f" style="--i:1" stroke-linecap="round">
    {prim.map((c) => { const s = seg(B(c[0], c[1]), c); return <line {...s} stroke="#13998a" stroke-width="8" />; })}
  </g>
  <g class="f" style="--i:2" stroke="#364554" stroke-width="1.4" stroke-linejoin="round">
    <path d={face([0, 1, 3, 2])} fill="#b9c4cf" />
    <path d={face([1, 3, 7, 5])} fill="#c3cdd7" />
    <path d={face([2, 3, 7, 6])} fill="#c3cdd7" />
    <path d={face([0, 2, 6, 4])} fill="#a9b6c3" fill-opacity="0.92" />
    <path d={face([0, 1, 5, 4])} fill="#c9d2db" fill-opacity="0.92" />
    <path d={face([4, 5, 7, 6])} fill="#eef2f6" fill-opacity="0.92" />
  </g>
  <g class="f" style="--i:3" stroke-linecap="round">
    {prim.map((c) => { const s = seg(B(c[0], c[1]), c); return <line {...s} stroke="#13998a" stroke-width="2.5" stroke-dasharray="4 3" />; })}
    {sec.map((c) => { const o: V = [c[0], -36, c[2]]; return <><line {...seg([o[0], o[1], -24], o)} stroke="#7d8a97" stroke-width="6" /><line {...seg(o, c)} stroke="#1e5fc4" stroke-width="8" /></>; })}
    <line {...seg([-36, ter[1], -24], [-36, ter[1], ter[2]])} stroke="#7d8a97" stroke-width="6" />
    <line {...seg([-36, ter[1], ter[2]], ter)} stroke="#8b52c9" stroke-width="8" />
    {[...prim, ...sec, ter].map((c) => { const [x, y] = P(c); return <circle cx={x} cy={y} r="4.5" fill="#e2601a" stroke="#fff" stroke-width="1.5" />; })}
  </g>
  <g class="f" style="--i:4">
    <line {...seg([L - 26, W / 2, H + 56], [L - 26, W / 2, H + 8])} stroke="#e2601a" stroke-width="4" marker-end="url(#ca-arr-acc)" />
  </g>
  <g class="lbl">
    <text class="t-acc" x={P([L - 26, W / 2, H + 56])[0] - 8} y={P([L - 26, W / 2, H + 56])[1] + 10} text-anchor="end">{T.clamp}</text>
    <text class="t-mid" x={P([L - 26, W / 2, 0])[0] + 14} y={P(B(L - 26, W / 2))[1] + 4} style="fill:#0f7a6e">{T.p}</text>
    <text class="t-mid" x={P([L - 36, -36, H / 2])[0] + 10} y={P([L - 36, -36, H / 2])[1] + 16} style="fill:#1e5fc4">{T.s}</text>
    <text class="t-mid" x={P([-36, ter[1], ter[2]])[0] - 18} y={P([-36, ter[1], ter[2]])[1] + 4} style="fill:#8b52c9">{T.t}</text>
  </g>
</svg>
