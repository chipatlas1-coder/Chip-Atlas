---
/* Minimum quantity lubrication, 1-channel internal feed. One channel through the spindle splits into the drill's two
   coolant channels at the shank; a fine aerosol leaves the tip and stays inside the hole. Schematic. */
interface Props { locale: 'en' | 'tr'; label?: string }
const { locale, label } = Astro.props;
const tr = locale === 'tr';
const T = tr ? { rate: '5–50 ml/saat (DGUV)', aer: 'aerosol' } : { rate: '5–50 ml/h (DGUV)', aer: 'aerosol' };
const x = 240;
const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
const dots = Array.from({ length: 26 }, (_, k) => ({ a: Math.PI / 2 + ((k % 9) - 4) * 0.33, r: 10 + ((k * 37) % 40), s: 1.4 + (k % 3) * 0.6 }))
  .map((d) => ({ cx: x + clamp(Math.cos(d.a) * d.r * 0.9, -22, 22), cy: clamp(258 + Math.sin(d.a) * d.r * 0.25, 252, 265), s: d.s }));
---
<svg viewBox="0 0 480 320" role="img" aria-label={label}>
  <rect class="metal-h f" style="--i:0" x="20" y="196" width="440" height="104" rx="3" />
  <path class="f" style="--i:1" d={`M${x - 26},196 L${x - 26},268 L${x + 26},268 L${x + 26},196 Z`} fill="#f7f9fb" stroke="#5f6c79" />
  <rect class="metal f" style="--i:1" x={x - 50} y="14" width="100" height="58" rx="6" />
  <rect class="carbide f" style="--i:2" x={x - 20} y="72" width="40" height="176" rx="3" stroke="#5f6c79" stroke-width="1.2" />
  <path class="carbide f" style="--i:2" d={`M${x - 20},248 L${x},262 L${x + 20},248 Z`} stroke="#5f6c79" stroke-width="1.2" />
  <path class="d" style="--i:3" pathLength="1" d={`M${x},34 L${x},72 L${x - 8},82 L${x - 8},250 M${x},72 L${x + 8},82 L${x + 8},250`} stroke="#e3b23c" stroke-width="3" fill="none" />
  <g class="f" style="--i:5">
    {dots.map((d) => <circle cx={d.cx} cy={d.cy} r={d.s} fill="#e3b23c" opacity="0.85" />)}
  </g>
  <line class="flow" x1={x - 8} y1="84" x2={x - 8} y2="246" stroke="#c98a1e" stroke-width="3" />
  <line class="flow" x1={x + 8} y1="84" x2={x + 8} y2="246" stroke="#c98a1e" stroke-width="3" />
  <g class="lbl">
    <text class="t-acc t-sm" x={x + 64} y="44">{T.rate}</text>
    <line x1={x + 16} y1="258" x2={x + 38} y2="258" stroke="#1e5fc4" stroke-width="1" />
    <text class="t-data t-sm" x={x + 42} y="262">{T.aer}</text>
  </g>
</svg>
