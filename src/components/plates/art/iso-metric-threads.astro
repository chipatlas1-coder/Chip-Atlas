---
/* ISO 68-1 basic profile to scale, P = 100 units: crest flat P/8 on the major diameter,
   root flat P/4 on the minor diameter, basic depth 5H/8, pitch line 3H/8 below the major line. */
interface Props { locale: 'en' | 'tr'; label?: string }
const { locale, label } = Astro.props;
const P = 100, H = (Math.sqrt(3) / 2) * P;
const yM = 112, ym = yM + (5 / 8) * H, y2 = yM + (3 / 8) * H;
const x0 = 34;
const pts: string[] = [];
for (let k = 0; k < 4; k++) {
  const b = x0 + k * P;
  pts.push(`${b},${yM}`, `${b + P / 8},${yM}`, `${b + P / 8 + (5 * P) / 16},${ym}`, `${b + P / 8 + (5 * P) / 16 + P / 4},${ym}`);
}
pts.push(`${x0 + 4 * P},${yM}`);
const line = 'M' + pts.join(' L');
const nut = line + ` L${x0 + 4 * P},40 L${x0},40 Z`;
const bolt = line + ` L${x0 + 4 * P},250 L${x0},250 Z`;
// fundamental triangle over the second tooth gap: apexes H/8 above the major line and H/4 below the minor line
const tb = x0 + P;
const tri = `M${tb + P / 16},${yM - H / 8} L${tb + P / 16 + P / 2},${yM - H / 8 + H} M${tb + P / 16 + P},${yM - H / 8} L${tb + P / 16 + P / 2},${yM - H / 8 + H}`;
const tl = locale === 'tr';
const apex: [number, number] = [tb + P / 16 + P / 2, yM - H / 8 + H];
const triFill = `M${tb + P / 16},${yM - H / 8} L${apex[0]},${apex[1]} L${tb + P / 16 + P},${yM - H / 8} Z`;
const ar = 22, arc = `M${apex[0] - ar * Math.sin(Math.PI / 6)},${apex[1] - ar * Math.cos(Math.PI / 6)} A${ar},${ar} 0 0,1 ${apex[0] + ar * Math.sin(Math.PI / 6)},${apex[1] - ar * Math.cos(Math.PI / 6)}`;
---
<svg viewBox="0 0 480 320" role="img" aria-label={label}>
  <path class="hatch f" style="--i:0" d={nut} />
  <path class="hatch-x f" style="--i:1" d={bolt} />
  <path class="f" style="--i:1" d={bolt} fill="url(#ca-metal)" fill-opacity="0.16" />
  <path class="f" style="--i:3" d={triFill} fill="#e2601a" fill-opacity="0.1" />
  <path class="o2 d" style="--i:2" pathLength="1" d={line} />
  <path class="dash f" style="--i:4" d={tri} />
  <path class="a f" style="--i:5; stroke-width:1.4" d={arc} />
  <line class="h f" style="--i:3" x1="20" y1={yM} x2="470" y2={yM} stroke-dasharray="2 3" />
  <line class="b f" style="--i:4" x1="20" y1={y2} x2="470" y2={y2} stroke-width="1.4" stroke-dasharray="6 4" />
  <line class="h f" style="--i:5" x1="20" y1={ym} x2="470" y2={ym} stroke-dasharray="2 3" />
  <g class="lbl">
    <text class="t-sm" x="440" y={yM - 6}>d, D</text>
    <text class="t-data t-sm" x="432" y={y2 - 6}>d₂, D₂</text>
    <text class="t-sm" x="446" y={ym + 16}>D₁</text>
    <line class="h" x1={x0 + 2 * P + P / 8} y1="58" x2={x0 + 3 * P + P / 8} y2="58" marker-start="url(#ca-arr)" marker-end="url(#ca-arr)" />
    <line class="h" x1={x0 + 2 * P + P / 8} y1="62" x2={x0 + 2 * P + P / 8} y2={yM - 4} />
    <line class="h" x1={x0 + 3 * P + P / 8} y1="62" x2={x0 + 3 * P + P / 8} y2={yM - 4} />
    <text class="it t-ink" x={x0 + 2.5 * P + P / 8 - 5} y="52">P</text>
    <line class="h" x1="26" y1={yM - H / 8} x2="26" y2={yM - H / 8 + H} marker-start="url(#ca-arr)" marker-end="url(#ca-arr)" />
    <text class="it t-ink" x="8" y={yM + H / 2 - 4}>H</text>
    <text class="t-acc" x={apex[0] - 11} y={apex[1] + 17}>60°</text>
    <text class="t-sm" x="40" y="286">{tl ? 'üstte somun (iç diş), altta cıvata (dış diş)' : 'nut (internal thread) above, bolt (external) below'}</text>
    <text class="t-sm" x="40" y="304">H = {tl ? '0,866025' : '0.866025'} P</text>
    <text class="t-sm" x="236" y="304">5H/8 = {tl ? '0,541266' : '0.541266'} P</text>
  </g>
</svg>
