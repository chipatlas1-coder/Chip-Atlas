---
/* vc · T^n = C on log–log axes: a straight line of slope −n. Points scatter about it. */
interface Props { locale: 'en' | 'tr'; label?: string }
const { locale, label } = Astro.props;
const tr = locale === 'tr';
// x = log10 T from 0 to 2.5, y = log10 vc; slope −n with n = 0.25 (illustrative).
const X = (lt: number) => 70 + lt * 156;
const Y = (lv: number) => 270 - (lv - 1.6) * 260;
const n = 0.25, lc = 2.45;
const line = (lt: number) => lc - n * lt;
const pts = [0.2, 0.55, 0.9, 1.3, 1.75, 2.2].map((lt, i) => [lt, line(lt) + [0.018, -0.022, 0.012, 0.02, -0.015, 0.01][i]]);
const tri = { a: 1, b: 2 }; // one decade of T: the drop in log vc is n
const ticksT = [0, 1, 2];
---
<svg viewBox="0 0 480 320" role="img" aria-label={label}>
  <g class="f" style="--i:0">
    {ticksT.map((t) => <line class="h" x1={X(t)} y1="40" x2={X(t)} y2="270" opacity="0.35" />)}
    {[1.8, 2.0, 2.2, 2.4].map((v) => <line class="h" x1="70" y1={Y(v)} x2="460" y2={Y(v)} opacity="0.25" />)}
  </g>
  <path class="o d" style="--i:1" pathLength="1" d="M70,34 L70,270 L462,270" />
  <line class="a d" style="--i:3" pathLength="1" x1={X(0.05)} y1={Y(line(0.05))} x2={X(2.45)} y2={Y(line(2.45))} />
  {pts.map(([lt, lv], i) => <circle class="f" style={`--i:${4 + i}`} cx={X(lt)} cy={Y(lv)} r="5" fill="#fbfdff" stroke="#1e6fd6" stroke-width="2" />)}
  <path class="h d" style="--i:6" pathLength="1" d={`M${X(tri.a)},${Y(line(tri.a))} L${X(tri.b)},${Y(line(tri.a))} L${X(tri.b)},${Y(line(tri.b))}`} stroke="#1b1d1e" />
  <g class="lbl">
    {ticksT.map((t) => <text x={X(t) - 8} y="290">{`10${['⁰', '¹', '²'][t]}`}</text>)}
    <text x="400" y="306">T (min)</text>
    <text x="76" y="22">v<tspan font-size="9" dy="3">c</tspan><tspan dy="-3"> (m/min)</tspan></text>
    <text class="it t-ink" x={X(tri.b) + 8} y={(Y(line(tri.a)) + Y(line(tri.b))) / 2 + 5}>n</text>
    <text class="t-sm" x={(X(tri.a) + X(tri.b)) / 2 - 3} y={Y(line(tri.a)) - 8}>1</text>
    <text class="t-mid" x="286" y="240">v<tspan font-size="11" dy="4">c</tspan><tspan dy="-4"> · T</tspan><tspan font-size="11" dy="-8">n</tspan><tspan dy="8"> = C</tspan></text>
    <text class="t-sm" x="286" y="262">log v<tspan font-size="8" dy="3">c</tspan><tspan dy="-3"> = log C − n · log T</tspan></text>
  </g>
</svg>
