---
/**
 * The Chip Atlas logo: a blue rounded square with a white C and A split by a diagonal. The same mark as the
 * YouTube channel avatar and the Instagram posts (geometry checked against the channel avatar: C arc r 16.5 with
 * radial cuts at ±50°, stroke 9 with butt caps, A with a mitred apex, diagonal stroke 4, rect rx 30, #1747E6).
 * The viewBox trims the 6-unit margin of the 120-unit original so the square fills the box.
 * Also the favicon (public/favicon.svg).
 */
interface Props { size?: number; class?: string }
const { size = 28, class: className = '' } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="6 6 108 108" aria-hidden="true" focusable="false">
  <rect x="6" y="6" width="108" height="108" rx="30" fill="#1747E6" />
  <path d="M50.6 32.4 A16.5 16.5 0 1 0 50.6 57.6 M68 98 L82 64 L96 98 M72 88 H92" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="butt" stroke-linejoin="miter" />
  <path d="M104 16 L16 104" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="butt" />
</svg>
