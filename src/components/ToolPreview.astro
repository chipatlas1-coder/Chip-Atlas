---
/** Static SVG thumbnails for the flagship tools. One drawing per route. */
import type { RouteKey } from '../i18n';
interface Props { route: RouteKey }
const { route } = Astro.props;
---
<div class="preview" aria-hidden="true">
  {route === 'decoder' && (
    <svg viewBox="0 0 320 180">
      <g transform="translate(160 90)">
        <path d="M0 -58 L54 0 L0 58 L-54 0 Z" fill="none" stroke="var(--color-steel-500)" stroke-width="2" stroke-linejoin="round" />
        <circle r="13" fill="none" stroke="var(--color-steel-500)" stroke-width="1.5" />
        <circle r="49" fill="none" stroke="var(--data)" stroke-width="1" stroke-dasharray="4 4" />
        <circle cx="0" cy="56" r="4" fill="var(--accent)" />
        <text x="62" y="-40" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--ink-2)">C · 80°</text>
        <text x="62" y="-22" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--data)">d 12.7</text>
        <text x="62" y="-4" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--accent)">rε 0.8</text>
      </g>
    </svg>
  )}
  {route === 'holder' && (
    <svg viewBox="0 0 320 180">
      <rect x="40" y="26" width="200" height="34" fill="url(#ca-hatch)" stroke="var(--color-steel-500)" stroke-width="1.5" />
      <path d="M150 60 L200 60 L200 160 L160 160 L160 92 L150 82 Z" fill="color-mix(in oklab, var(--color-steel-500) 16%, transparent)" stroke="var(--color-steel-500)" stroke-width="2" stroke-linejoin="round" />
      <path d="M140 62 L168 60 L170 84 L152 86 Z" fill="var(--bg-raised)" stroke="var(--ink-2)" stroke-width="1.5" stroke-linejoin="round" />
      <circle cx="158" cy="72" r="4" fill="none" stroke="var(--ink-2)" stroke-width="1.2" />
      <line x1="141" y1="61" x2="152" y2="86" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
      <path d="M126 60 A22 22 0 0 0 146 80" fill="none" stroke="var(--accent)" stroke-width="1.5" />
      <text x="96" y="92" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--accent)">κr 95°</text>
      <text x="214" y="110" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--ink-2)">PCLNR</text>
      <text x="214" y="128" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--data)">2525 M12</text>
    </svg>
  )}
  {route === 'roughness' && (
    <svg viewBox="0 0 320 180">
      <path d="M20 120 A52 52 0 0 1 100 120 A52 52 0 0 1 180 120 A52 52 0 0 1 260 120 A52 52 0 0 1 300 100" fill="none" stroke="var(--data)" stroke-width="2" />
      <line x1="20" y1="120" x2="300" y2="120" stroke="var(--line-strong)" stroke-dasharray="3 4" />
      <line x1="100" y1="120" x2="100" y2="140" stroke="var(--ink-3)" />
      <line x1="180" y1="120" x2="180" y2="140" stroke="var(--ink-3)" />
      <path d="M100 136 H180" stroke="var(--accent)" stroke-width="1.5" />
      <text x="140" y="156" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--accent)">f</text>
      <line x1="238" y1="120" x2="238" y2="90" stroke="var(--accent)" stroke-width="1.5" />
      <text x="246" y="104" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--accent)">Rt</text>
    </svg>
  )}
  {route === 'turning' && (
    <svg viewBox="0 0 320 180">
      <g fill="none" stroke="var(--color-steel-500)" stroke-width="2">
        <path d="M30 70 h60 v-12 h110 v12 h40 l20 14 v32 l-20 14 h-40 v12 h-110 v-12 h-60 z" />
      </g>
      <line x1="20" y1="104" x2="300" y2="104" stroke="var(--ink-3)" stroke-dasharray="12 5 3 5" />
      <path d="M160 58 l-9 -16 h18 z" fill="var(--accent)" />
      <path d="M160 42 v-18" stroke="var(--accent)" stroke-width="1.5" />
      <text x="168" y="30" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--data)">vc = π·D·n / 1000</text>
      <text x="36" y="160" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--ink-3)">Ø40 · n 1200 · f 0.20</text>
    </svg>
  )}
  {route === 'milling' && (
    <svg viewBox="0 0 320 180">
      <rect x="150" y="96" width="150" height="60" fill="color-mix(in oklab, var(--color-steel-500) 16%, transparent)" stroke="var(--color-steel-500)" stroke-width="1.5" />
      <circle cx="150" cy="80" r="46" fill="var(--bg-raised)" stroke="var(--ink-2)" stroke-width="1.5" />
      <path d="M193.1 96 A46 46 0 0 1 150 126" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" />
      <path d="M20 160 C 60 120, 90 128, 120 160" fill="none" stroke="var(--accent)" stroke-width="1.5" />
      <text x="206" y="40" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--data)">hex &lt; fz</text>
      <text x="206" y="58" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--ink-3)">ae / Dc = 0.2</text>
    </svg>
  )}
  {route === 'drilling' && (
    <svg viewBox="0 0 320 180">
      <path d="M40 70 H136 V126 L160 144 L184 126 V70 H280 V170 H40 Z" fill="color-mix(in oklab, var(--color-steel-500) 14%, transparent)" stroke="var(--color-steel-500)" stroke-width="1.5" />
      <path d="M136 14 V126 L160 144 L184 126 V14" fill="color-mix(in oklab, var(--accent) 16%, transparent)" stroke="var(--accent)" stroke-width="1.5" />
      <line x1="160" y1="8" x2="160" y2="160" stroke="var(--ink-3)" stroke-dasharray="8 4 2 4" />
      <text x="196" y="40" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--data)">Q = Dc·fn·vc / 4</text>
      <text x="196" y="140" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--accent)">σ 140°</text>
    </svg>
  )}
  {route === 'fits' && (
    <svg viewBox="0 0 320 180">
      <defs><pattern id="pv-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="7" stroke="var(--accent)" stroke-width="1.4" stroke-opacity="0.6" /></pattern></defs>
      <line x1="24" y1="96" x2="296" y2="96" stroke="var(--ink-2)" stroke-width="1.5" />
      <rect x="70" y="52" width="80" height="44" fill="url(#pv-hatch)" stroke="var(--accent)" stroke-width="1.5" />
      <rect x="180" y="108" width="80" height="28" fill="color-mix(in oklab, var(--data) 28%, transparent)" stroke="var(--data)" stroke-width="1.5" />
      <text x="110" y="42" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--accent)">H7</text>
      <text x="220" y="156" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--data)">g6</text>
      <text x="290" y="88" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--ink-3)">Ø25</text>
    </svg>
  )}
  {route === 'tapdrill' && (
    <svg viewBox="0 0 320 180">
      <defs><pattern id="pv-tap" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="7" stroke="var(--accent)" stroke-width="1.3" stroke-opacity="0.55" /></pattern></defs>
      <path d="M24 70 L37 70 L69 124 L95 124 L127 70 L140 70 L172 124 L198 124 L230 70 L243 70 L275 124 L296 124 L296 40 L24 40 Z" fill="url(#pv-tap)" />
      <path d="M24 70 L37 70 L69 124 L95 124 L127 70 L140 70 L172 124 L198 124 L230 70 L243 70 L275 124 L296 124 L296 150 L24 150 Z" fill="color-mix(in oklab, var(--data) 22%, transparent)" />
      <path d="M24 70 L37 70 L69 124 L95 124 L127 70 L140 70 L172 124 L198 124 L230 70 L243 70 L275 124 L296 124" fill="none" stroke="var(--ink)" stroke-width="2" />
      <line x1="20" y1="124" x2="300" y2="124" stroke="var(--accent)" stroke-dasharray="5 4" />
      <text x="290" y="168" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--accent)">M10 → Ø8.5</text>
      <text x="30" y="30" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--ink-2)">6H · D1 8.376 … 8.676</text>
    </svg>
  )}
  {route === 'climbMilling' && (
    <svg viewBox="0 0 320 180">
      <path d="M20 122 H160 V96 H300 V160 H20 Z" fill="color-mix(in oklab, var(--color-steel-500) 14%, transparent)" stroke="var(--color-steel-500)" />
      <circle cx="160" cy="76" r="46" fill="var(--bg-panel)" stroke="var(--ink-2)" stroke-width="1.5" />
      <path d="M160 122 A46 46 0 0 0 195 105" fill="none" stroke="var(--accent)" stroke-width="7" stroke-linecap="round" />
      <path d="M124 40 A52 52 0 0 1 196 40" fill="none" stroke="var(--ink-2)" stroke-width="1.5" />
      <path d="M196 40 l-9 -2 l5 8 z" fill="var(--ink-2)" />
      <line x1="280" y1="146" x2="230" y2="146" stroke="var(--ink-2)" stroke-width="1.5" />
      <path d="M230 146 l9 -4 v8 z" fill="var(--ink-2)" />
      <text x="30" y="148" font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--data)">h: thick → thin</text>
    </svg>
  )}
  {route === 'micrometer' && (
    <svg viewBox="0 0 320 180">
      <rect x="16" y="66" width="140" height="48" fill="color-mix(in oklab, var(--color-steel-500) 16%, var(--bg-sunk))" />
      <line x1="16" y1="90" x2="140" y2="90" stroke="var(--ink)" stroke-width="1.6" />
      <line x1="24" y1="90" x2="24" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="36" y1="90" x2="36" y2="66" stroke="var(--ink)" stroke-width="1.6" /><line x1="48" y1="90" x2="48" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="60" y1="90" x2="60" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="72" y1="90" x2="72" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="84" y1="90" x2="84" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="96" y1="90" x2="96" y2="66" stroke="var(--ink)" stroke-width="1.6" /><line x1="108" y1="90" x2="108" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="120" y1="90" x2="120" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="132" y1="90" x2="132" y2="74" stroke="var(--ink)" stroke-width="1.6" /><line x1="30" y1="90" x2="30" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="42" y1="90" x2="42" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="54" y1="90" x2="54" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="66" y1="90" x2="66" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="78" y1="90" x2="78" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="90" y1="90" x2="90" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="102" y1="90" x2="102" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="114" y1="90" x2="114" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="126" y1="90" x2="126" y2="106" stroke="var(--ink)" stroke-width="1.6" /><line x1="138" y1="90" x2="138" y2="106" stroke="var(--ink)" stroke-width="1.6" />
      <line x1="96" y1="90" x2="96" y2="66" stroke="#e2601a" stroke-width="3.4" />
      <line x1="108" y1="90" x2="108" y2="74" stroke="#8b52c9" stroke-width="3" /><line x1="120" y1="90" x2="120" y2="74" stroke="#8b52c9" stroke-width="3" /><line x1="132" y1="90" x2="132" y2="74" stroke="#8b52c9" stroke-width="3" />
      <line x1="138" y1="90" x2="138" y2="106" stroke="#d99a0b" stroke-width="3" />
      <text x="36" y="60" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="13" font-weight="600" fill="var(--ink-2)">25</text>
      <text x="96" y="60" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="13" font-weight="600" fill="#c94f0c">30</text>
      <rect x="172" y="52" width="132" height="76" fill="color-mix(in oklab, var(--color-steel-500) 24%, var(--bg-sunk))" />
      <path d="M140 74 L172 52 L172 128 L140 106 Z" fill="color-mix(in oklab, var(--color-steel-500) 34%, var(--bg-sunk))" stroke="var(--ink-2)" stroke-width="1" />
      <line x1="141" y1="115.2" x2="172" y2="126" stroke="var(--ink)" stroke-width="1.3" /><line x1="141" y1="108.9" x2="172" y2="117" stroke="var(--ink)" stroke-width="1.3" /><line x1="141" y1="102.6" x2="172" y2="108" stroke="var(--ink)" stroke-width="1.3" /><line x1="141" y1="96.3" x2="172" y2="99" stroke="var(--ink)" stroke-width="1.3" /><line x1="141" y1="83.7" x2="172" y2="81" stroke="var(--ink)" stroke-width="1.3" /><line x1="141" y1="77.4" x2="172" y2="72" stroke="var(--ink)" stroke-width="1.3" /><line x1="141" y1="71.1" x2="172" y2="63" stroke="var(--ink)" stroke-width="1.3" /><line x1="141" y1="64.8" x2="172" y2="54" stroke="var(--ink)" stroke-width="1.3" />
      <line x1="141" y1="90" x2="186" y2="90" stroke="#1e5fc4" stroke-width="3" />
      <text x="190" y="94.5" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" fill="#1e5fc4">15</text>
      <text x="20" y="158" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600"><tspan fill="#c94f0c">30</tspan><tspan fill="var(--ink-3)"> + </tspan><tspan fill="#7440ad">3</tspan><tspan fill="var(--ink-3)"> + </tspan><tspan fill="#9a6c05">0.5</tspan><tspan fill="var(--ink-3)"> + </tspan><tspan fill="#1e5fc4">0.15</tspan><tspan fill="var(--ink)"> = 33.65 mm</tspan></text>
    </svg>
  )}
</div>

<style>
  .preview { background: var(--bg-sunk); border-bottom: 1px solid var(--line); aspect-ratio: 16 / 9; }
  .preview svg { width: 100%; height: 100%; }
</style>
