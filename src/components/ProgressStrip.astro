---
/**
 * How far a section has been written: one segment per subsection, its width the planned page
 * count, its fill the share already live. Pages under review count as live (they are published).
 */
interface Seg { name: string; pages: number; live: number }
interface Props { segs: Seg[]; label: string; size?: 'sm' | 'lg' }
const { segs, label, size = 'sm' } = Astro.props;
---
<span class:list={['strip', size]} role="img" aria-label={label}>
  {segs.map((s) => (
    <span class="seg" style={`flex-grow:${Math.max(1, s.pages)}`} title={`${s.name} · ${s.live}/${s.pages}`}>
      {s.live > 0 && <span class="fill" style={`width:${Math.min(100, (s.live / Math.max(1, s.pages)) * 100).toFixed(1)}%`} />}
    </span>
  ))}
</span>

<style>
  .strip { display: flex; gap: 2px; width: 100%; }
  .seg { position: relative; flex-basis: 0; min-width: 3px; height: 5px; border-radius: 1px; background: color-mix(in oklab, var(--line-strong) 70%, transparent); overflow: hidden; }
  .lg .seg { height: 9px; border-radius: 2px; }
  .fill { position: absolute; inset: 0 auto 0 0; min-width: 3px; background: var(--accent); box-shadow: 0 0 8px color-mix(in oklab, var(--accent) 55%, transparent); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    .fill { animation: grow 900ms cubic-bezier(0.3, 0.7, 0.2, 1) both; animation-delay: 150ms; }
  }
  @keyframes grow { from { transform: scaleX(0); } }
</style>
