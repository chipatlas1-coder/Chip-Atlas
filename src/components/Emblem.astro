---
/**
 * Emblems for the 18 sections of the atlas, drawn in the plates' vocabulary (metal and carbide
 * gradients, section hatching, orange for the cut, blue for data). One moving detail per emblem
 * runs when the emblem's host (.em-host) is hovered or focused; nothing moves with reduced motion.
 */
interface Props { n: number; size?: string; label?: string }
const { n, size = '4.5rem', label } = Astro.props;
const uid = `em${n}-${Math.random().toString(36).slice(2, 7)}`;
// microstructure grains for 06 (pre-drawn polygons inside r = 34 around 48,48)
const grains = [
  'M48,14 L66,20 L62,36 L46,38 L36,26 Z', 'M66,20 L80,36 L74,50 L62,36 Z', 'M36,26 L46,38 L40,54 L22,48 L20,32 Z',
  'M46,38 L62,36 L74,50 L64,62 L48,58 L40,54 Z', 'M22,48 L40,54 L42,70 L28,76 L16,62 Z', 'M48,58 L64,62 L66,78 L50,82 L42,70 L40,54 Z',
  'M74,50 L82,62 L76,74 L66,78 L64,62 Z',
];
const pearlite = [1, 4, 6];
const f = (v: number) => Math.round(v * 10) / 10;
const poly = (pts: [number, number][]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${f(x)},${f(y)}`).join(' ');
// 01 — orthogonal cut: rake angle 7°, uncut thickness 8, shear angle 35° (so hc = h·cos(φ−α)/sin φ ≈ 12.3),
// chip in contact with the rake face for 20 units, then curling away on a slowly tightening spiral.
const T: [number, number] = [56, 72];
const ra = (7 * Math.PI) / 180, u = [Math.sin(ra), -Math.cos(ra)], nn = [-Math.cos(ra), -Math.sin(ra)];
const h = 8, phi = (35 * Math.PI) / 180, S: [number, number] = [T[0] - h / Math.tan(phi), T[1] - h];
const hc = (h * Math.cos(phi - ra)) / Math.sin(phi), lc = 20, R0 = 11;
const at = (s: number, k: number): [number, number] => [T[0] + s * u[0] + k * nn[0], T[1] + s * u[1] + k * nn[1]];
const Cc = at(lc, hc / 2 + R0);
const curl = (k: number) => {
  const out: [number, number][] = [];
  for (let i = 0; i <= 40; i++) {
    const th = (1.32 * Math.PI * i) / 40, R = R0 * (1 - 0.2 * th / Math.PI), t = (hc / 2) * (1 - 0.18 * th / Math.PI);
    const v = [Math.cos(th) * -nn[0] + Math.sin(th) * -nn[1], -Math.sin(th) * -nn[0] + Math.cos(th) * -nn[1]];
    out.push([Cc[0] + (R + k * t) * v[0], Cc[1] + (R + k * t) * v[1]]);
  }
  return out;
};
const chipOuter = [T, ...curl(1)], chipInner = curl(-1).reverse();
const chip = poly([...chipOuter, ...chipInner]) + ` L${f(S[0])},${f(S[1])} Z`;
const rakeTop = at(48, 0);
const tool = poly([T, rakeTop, [88, rakeTop[1]], [88, 68]]) + ' Z';
const work = poly([[8, 64], S, T, [88, 72], [88, 88], [8, 88]]) + ' Z';
// 13 — cost per part against cutting speed: machining cost a/v falls, tool cost c·v² rises,
// their sum has its minimum where a/v² = 2cv. Same scale for all three curves.
const ca = 0.25, cc = 0.751, X = (v: number) => 16 + ((v - 0.2) / 0.8) * 70, Y = (c: number) => 82 - c * 48;
const curve = (fn: (v: number) => number) => poly(Array.from({ length: 41 }, (_, i) => { const v = 0.2 + (0.8 * i) / 40; return [X(v), Y(fn(v))]; }));
const vmin = Math.cbrt(ca / (2 * cc));
const mach = curve((v) => ca / v), toolc = curve((v) => cc * v * v), total = curve((v) => ca / v + cc * v * v);
const minPt: [number, number] = [X(vmin), Y(ca / vmin + cc * vmin * vmin)];
---
<svg class="em" viewBox="0 0 96 96" style={`width:${size};height:${size}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <defs>
    <clipPath id={`${uid}-c`}><circle cx="48" cy="48" r="34" /></clipPath>
    <pattern id={`${uid}-lam`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(35)"><rect width="4" height="4" fill="#cdd5db" /><line x1="0" y1="0" x2="0" y2="4" stroke="#656e74" stroke-width="1.6" /></pattern>
    <marker id={`${uid}-ad`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#1e6fd6" /></marker>
    <marker id={`${uid}-aa`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#e2601a" /></marker>
    <clipPath id={`${uid}-f`}><rect x="30" y="40" width="12" height="44" rx="1" /></clipPath>
  </defs>

  {n === 1 && <g>
    <path d={work} fill="url(#ca-hatch)" class="l" />
    <path d={chip} fill="url(#ca-chip)" class="l" />
    <path d={tool} fill="url(#ca-carbide)" class="l" />
    <line x1={f(S[0])} y1={f(S[1])} x2={T[0]} y2={T[1]} class="acc w em-pulse" />
  </g>}

  {n === 2 && <g>
    <rect x="6" y="18" width="13" height="60" rx="2" fill="url(#ca-carbide)" class="l" />
    <path d="M19,34 L52,34 L52,62 L19,62 Z" fill="url(#ca-metal)" class="l" />
    <path d="M52,38 L82,38 L82,58 L52,58 Z" fill="url(#ca-metal)" class="l" />
    <ellipse cx="82" cy="48" rx="3" ry="10" fill="#8d959d" class="l" />
    {[58, 63, 68, 73, 78].map((x) => <line x1={x} y1="39" x2={x - 1.4} y2="57" stroke="#cdd5db" stroke-width="0.7" opacity="0.6" />)}
    <path d="M47,92 L47,74 L54,66 L66,66 L66,92" fill="url(#ca-face)" class="l" />
    <path d="M52,58 L50,67 L58,73 L61,64 Z" fill="url(#ca-carbide)" class="l" />
    <path d="M52,58 L51,62.5" stroke="#e2601a" stroke-width="2.6" stroke-linecap="round" />
    <path d="M50.5,62 C45,64 40,68 40,74 C40,79 46,80 46,76" class="chipline em-pulse" />
    <path d="M27,28 C31,24 40,24 44,28" class="dat" marker-end={`url(#${uid}-ad)`} />
    <path d="M76,72 L66,72" class="acc" marker-end={`url(#${uid}-aa)`} />
  </g>}

  {n === 3 && <g>
    <rect x="8" y="78" width="80" height="9" rx="1.5" fill="url(#ca-carbide)" class="l" />
    <rect x="60" y="12" width="20" height="66" fill="url(#ca-face)" class="l" />
    <rect x="36" y="20" width="26" height="18" rx="2" fill="url(#ca-metal)" class="l" />
    <rect x="44" y="38" width="10" height="10" fill="#8d959d" class="l" />
    <g class="em-shake"><rect x="46.5" y="48" width="5" height="12" fill="url(#ca-carbide)" class="l" /></g>
    <rect x="14" y="70" width="44" height="8" fill="url(#ca-face)" class="l" />
    <rect x="24" y="60" width="26" height="10" fill="url(#ca-metal)" class="l" />
    <line x1="49" y1="60" x2="49" y2="56" class="acc w" />
  </g>}

  {n === 4 && <g>
    <rect x="30" y="8" width="12" height="34" rx="1.5" fill="url(#ca-metal)" class="l" />
    <g clip-path={`url(#${uid}-f)`}>
      <rect x="30" y="40" width="12" height="44" fill="url(#ca-carbide)" />
      <g class="em-flute">{[-8, 4, 16, 28, 40, 52].map((y) => <path d={`M28,${44 + y} L44,${36 + y} L44,${40 + y} L28,${48 + y} Z`} fill="#2c3033" opacity="0.55" />)}</g>
    </g>
    <rect x="30" y="40" width="12" height="44" rx="1" class="l" />
    <path d="M66,40 L82,58 L66,76 L50,58 Z" fill="url(#ca-carbide)" class="l" />
    <circle cx="66" cy="58" r="5" fill="#f9fbfe" class="l" />
    <path d="M78,52 L82,58 L78,64" class="acc w" />
  </g>}

  {n === 5 && <g class="em-spin" style="transform-origin: 48px 48px">
    <circle cx="48" cy="48" r="38" fill="url(#ca-metal)" class="l" />
    <circle cx="48" cy="48" r="29" fill="#cdd5db" class="l2" />
    {[90, 210, 330].map((a) => (
      <g transform={`rotate(${a} 48 48)`}>
        <path d="M43,46 L43,22 L47,22 L47,16 L53,16 L53,46 Z" transform="translate(0 0)" fill="url(#ca-face)" class="l" />
      </g>
    ))}
    <circle cx="48" cy="48" r="9" fill="#f9fbfe" class="l" />
    {[30, 150, 270].map((a) => <circle cx={48 + 33 * Math.cos((a * Math.PI) / 180)} cy={48 + 33 * Math.sin((a * Math.PI) / 180)} r="2.2" fill="#f9fbfe" />)}
  </g>}

  {n === 6 && <g>
    <g clip-path={`url(#${uid}-c)`}>
      <rect x="10" y="10" width="76" height="76" fill="#5f6c79" />
      {grains.map((d, i) => <path d={d} fill={pearlite.includes(i) ? `url(#${uid}-lam)` : '#f1f4f7'} stroke="#5f6c79" stroke-width="1.3" stroke-linejoin="round" />)}
      <path d={grains[3]} fill="none" stroke="#e2601a" stroke-width="2" class="em-pulse" />
    </g>
    <circle cx="48" cy="48" r="34" class="l" />
    <circle cx="48" cy="48" r="39" class="l2" />
    {[0, 90, 180, 270].map((a) => <line x1={48 + 39 * Math.cos((a * Math.PI) / 180)} y1={48 + 39 * Math.sin((a * Math.PI) / 180)} x2={48 + 44 * Math.cos((a * Math.PI) / 180)} y2={48 + 44 * Math.sin((a * Math.PI) / 180)} class="l2" />)}
  </g>}

  {n === 7 && <g>
    <path d="M14,62 A34,34 0 0,1 82,62" class="l" />
    <path d="M20,62 A28,28 0 0,1 76,62" stroke="url(#ca-heat)" stroke-width="5" fill="none" opacity="0.9" />
    {Array.from({ length: 9 }, (_, i) => { const a = Math.PI + (Math.PI * i) / 8; return <line x1={48 + 34 * Math.cos(a)} y1={62 + 34 * Math.sin(a)} x2={48 + (i % 2 ? 30 : 27) * Math.cos(a)} y2={62 + (i % 2 ? 30 : 27) * Math.sin(a)} class="l2" />; })}
    <g class="em-needle" style="transform-origin: 48px 62px"><line x1="48" y1="62" x2="66" y2="40" class="acc w" /></g>
    <circle cx="48" cy="62" r="5" fill="url(#ca-metal)" class="l" />
    <rect x="22" y="72" width="52" height="12" rx="2" fill="#f9fbfe" class="l2" />
    <rect x="26" y="76" width="28" height="4" rx="1" fill="#1e6fd6" opacity="0.8" />
  </g>}

  {n === 8 && <g>
    {[[16, 14], [24, 20], [32, 26], [39, 33], [45, 40]].map(([x, y]) => <rect x={x - 5} y={y - 5} width="10" height="10" rx="4" fill="url(#ca-face)" class="l" transform={`rotate(40 ${x} ${y})`} />)}
    <path d="M47,42 L54,49 L50,53 Z" fill="#8d959d" class="l" />
    <g class="em-drops">{[[56, 58], [61, 63], [54, 66], [62, 71], [58, 76]].map(([x, y]) => <path d={`M${x},${y - 4} C${x + 2.5},${y} ${x + 2.5},${y + 3} ${x},${y + 3} C${x - 2.5},${y + 3} ${x - 2.5},${y} ${x},${y - 4} Z`} fill="#1e6fd6" />)}</g>
    <path d="M66,90 L76,70 L90,70 L90,90 Z" fill="url(#ca-carbide)" class="l" />
    <path d="M64,90 L66,86 L70,90 Z" fill="#e2601a" />
  </g>}

  {n === 9 && <g>
    <rect x="12" y="22" width="72" height="56" rx="6" fill="#ecf2f7" class="l" />
    <rect x="22" y="32" width="52" height="36" rx="4" class="dat dash" />
    <rect x="30" y="40" width="36" height="20" rx="3" class="dat dash" />
    <path id={`${uid}-p`} d="M22,36 Q22,32 26,32 L70,32 Q74,32 74,36 L74,64 Q74,68 70,68 L26,68 Q22,68 22,64 Z" fill="none" />
    <circle r="3.6" fill="#e2601a" class="em-follow" style={`offset-path: path('M22,36 Q22,32 26,32 L70,32 Q74,32 74,36 L74,64 Q74,68 70,68 L26,68 Q22,68 22,64 Z')`} />
    <text x="12" y="15" class="code">G01 X74 Y68</text>
  </g>}

  {n === 10 && <g>
    <rect x="8" y="24" width="82" height="10" rx="1.5" fill="url(#ca-metal)" class="l" />
    {Array.from({ length: 14 }, (_, i) => <line x1={22 + i * 5} y1="24" x2={22 + i * 5} y2={i % 2 ? 28 : 30} stroke="#b1bac2" stroke-width="1" />)}
    <path d="M8,34 L18,34 L18,62 L14,66 L8,66 Z" fill="url(#ca-face)" class="l" />
    <g class="em-slide">
      <path d="M50,20 L64,20 L64,38 L60,38 L60,66 L56,66 L52,62 L52,38 L50,38 Z" fill="url(#ca-face)" class="l" />
      <rect x="53" y="26" width="9" height="6" fill="#f9fbfe" />
    </g>
    <circle cx="35" cy="56" r="16" fill="url(#ca-metal)" class="l" />
    <line x1="19" y1="78" x2="51" y2="78" class="dat" marker-start={`url(#${uid}-ad)`} marker-end={`url(#${uid}-ad)`} />
  </g>}

  {n === 11 && <g>
    <path d="M10,42 L28,42 L28,34 L64,34 L64,40 L84,40 L84,56 L64,56 L64,62 L28,62 L28,54 L10,54 Z" fill="url(#ca-face)" class="l" />
    <line x1="6" y1="48" x2="90" y2="48" class="l2 cl" />
    <line x1="28" y1="24" x2="64" y2="24" class="dat" marker-start={`url(#${uid}-ad)`} marker-end={`url(#${uid}-ad)`} />
    <line x1="28" y1="22" x2="28" y2="32" class="l2" /><line x1="64" y1="22" x2="64" y2="32" class="l2" />
    <g class="em-pulse"><rect x="30" y="70" width="48" height="14" fill="#f9fbfe" class="acc" />
    <line x1="42" y1="70" x2="42" y2="84" class="acc" /><line x1="66" y1="70" x2="66" y2="84" class="acc" />
    <circle cx="36" cy="77" r="3" class="acc" /><line x1="31.5" y1="77" x2="40.5" y2="77" class="acc" /><line x1="36" y1="72.5" x2="36" y2="81.5" class="acc" />
    <text x="54" y="80.5" class="code c" text-anchor="middle">0.02</text><text x="72" y="80.5" class="code c" text-anchor="middle">A</text></g>
  </g>}

  {n === 12 && <g>
    <rect x="8" y="16" width="56" height="44" rx="3" fill="#e0e8ed" class="l" />
    {[24, 32, 40, 48].map((y) => <path d={`M12,${y} q4,-3 8,0 t8,0 t8,0 t8,0 t8,0 t8,0`} class="l2" />)}
    <circle cx="58" cy="56" r="20" fill="#f9fbfe" class="l" />
    <g clip-path="none" class="em-shake">{[48, 56, 64].map((y) => <path d={`M42,${y} q4,-6 8,0 t8,0 t8,0 t8,0`} class="acc w" />)}</g>
    <circle cx="58" cy="56" r="20" class="l" />
    <path d="M72,70 L86,84" stroke="url(#ca-metal)" stroke-width="7" stroke-linecap="round" />
    <path d="M72,70 L86,84" class="l" />
  </g>}

  {n === 13 && <g>
    <path d="M14,10 L14,84 L90,84" class="l" />
    <path d={mach} class="l2 dash" />
    <path d={toolc} class="l2 dash" />
    <path d={total} class="acc w em-draw" pathLength="1" />
    <line x1={f(minPt[0])} y1={f(minPt[1]) + 4} x2={f(minPt[0])} y2="84" class="dat dash" />
    <circle cx={f(minPt[0])} cy={f(minPt[1])} r="4" fill="#1e6fd6" stroke="#f9fbfe" stroke-width="1.5" />
  </g>}

  {n === 14 && <g>
    <path d="M48,10 L80,22 L80,46 C80,66 66,80 48,88 C30,80 16,66 16,46 L16,22 Z" fill="url(#ca-face)" class="l" />
    <path d="M48,18 L72,27 L72,46 C72,61 62,72 48,79 C34,72 24,61 24,46 L24,27 Z" fill="#ecf2f7" class="l2" />
    <path d="M34,48 L44,58 L62,38" class="dat w em-draw" pathLength="1" />
  </g>}

  {n === 15 && <g>
    <path d="M18,8 L60,8 L76,24 L76,88 L18,88 Z" fill="url(#ca-face)" class="l" />
    <path d="M60,8 L60,24 L76,24" fill="#8d959d" class="l" />
    {[34, 42, 50, 58].map((y, i) => <line x1="26" y1={y} x2={i === 3 ? 50 : 68} y2={y} stroke="#cdd5db" stroke-width="2" />)}
    <g class="em-spin" style="transform-origin: 66px 72px">
      <circle cx="66" cy="72" r="15" fill="#f9fbfe" class="acc w" />
      {Array.from({ length: 16 }, (_, i) => { const a = (i * Math.PI) / 8; return <line x1={66 + 15 * Math.cos(a)} y1={72 + 15 * Math.sin(a)} x2={66 + 18 * Math.cos(a)} y2={72 + 18 * Math.sin(a)} class="acc" />; })}
    </g>
    <text x="66" y="75.5" class="code s" text-anchor="middle">ISO</text>
  </g>}

  {n === 16 && <g>
    <rect x="20" y="8" width="56" height="7" rx="2" fill="url(#ca-metal)" class="l" />
    <rect x="20" y="81" width="56" height="7" rx="2" fill="url(#ca-metal)" class="l" />
    <path d="M28,15 C28,34 44,40 44,48 C44,56 28,62 28,81 L68,81 C68,62 52,56 52,48 C52,40 68,34 68,15 Z" fill="#ecf2f7" class="l" />
    <path d="M34,26 L62,26 C60,36 50,40 48,46 C46,40 36,36 34,26 Z" fill="#c98a0a" opacity="0.9" />
    <path d="M32,81 C36,70 44,68 48,66 C52,68 60,70 64,81 Z" fill="#c98a0a" opacity="0.9" />
    <line x1="48" y1="46" x2="48" y2="66" stroke="#c98a0a" stroke-width="1.6" stroke-dasharray="2 2.5" class="em-sand" />
  </g>}

  {n === 17 && <g>
    <path d="M48,24 C38,18 24,18 10,22 L10,78 C24,74 38,74 48,80 Z" fill="#ffffff" class="l" />
    <path d="M48,24 C58,18 72,18 86,22 L86,78 C72,74 58,74 48,80 Z" fill="#eef2f6" class="l" />
    <text x="29" y="56" class="big" text-anchor="middle">Aa</text>
    {[40, 48, 56, 64].map((y) => <line x1="56" y1={y} x2="78" y2={y - 1} stroke="#8d959d" stroke-width="2" />)}
    <path d="M70,18 L70,34 L74,30 L78,34 L78,18" fill="#e2601a" class="em-pulse" />
  </g>}

  {n === 18 && <g>
    <rect x="10" y="12" width="76" height="72" rx="6" fill="#ecf2f7" class="l" />
    <rect x="18" y="20" width="60" height="16" rx="2" fill="#f9fbfe" class="l2" />
    <text x="74" y="32" class="code b" text-anchor="end">151.0</text>
    {[46, 60, 74].map((y, i) => (
      <g>
        <line x1="20" y1={y} x2="76" y2={y} stroke="#b1bac2" stroke-width="3" stroke-linecap="round" />
        <line x1="20" y1={y} x2={[44, 60, 32][i]} y2={y} stroke={i === 1 ? '#e2601a' : '#1e6fd6'} stroke-width="3" stroke-linecap="round" />
        <circle cx={[44, 60, 32][i]} cy={y} r="5" fill="url(#ca-metal)" class={`l em-knob k${i}`} />
      </g>
    ))}
  </g>}
</svg>

<style>
  .em { display: block; overflow: visible; }
  .l { stroke: #2c3033; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  path.l:not([fill]), line.l, circle.l:not([fill]), rect.l:not([fill]) { fill: none; }
  .l2 { stroke: #656e74; stroke-width: 1.2; fill: none; stroke-linecap: round; }
  .acc { stroke: #e2601a; stroke-width: 1.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  rect.acc[fill], circle.acc[fill] { fill: #f9fbfe; }
  .dat { stroke: #1e6fd6; stroke-width: 1.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .w { stroke-width: 2.6; }
  .dash { stroke-dasharray: 3 3; }
  .chipline { stroke: #b35a24; stroke-width: 2.4; fill: none; stroke-linecap: round; }
  .cl { stroke-dasharray: 10 3 2 3; }
  .code { font-family: var(--font-mono); font-size: 7.5px; fill: #2a78d6; }
  .code.c { fill: #e2601a; font-size: 7px; }
  .code.s { fill: #e2601a; font-size: 6.5px; font-weight: 600; }
  .code.b { font-size: 9px; }
  .big { font-family: var(--font-sans); font-size: 20px; font-weight: 600; fill: #1e5fc4; }
  .em-follow { offset-distance: 0%; }
  @media (prefers-reduced-motion: no-preference) {
    .em-spin, .em-needle, .em-slide, .em-knob, .em-drops, .em-follow, .em-shake, .em-flute, .em-draw, .em-pulse, .em-sand { transition: transform 600ms cubic-bezier(0.3, 0.7, 0.2, 1); }
    :global(.em-host:is(:hover, :focus-visible)) .em-spin { animation: em-rot 2.4s linear infinite; }
    :global(.em-host:is(:hover, :focus-visible)) .em-needle { transform: rotate(-58deg); }
    :global(.em-host:is(:hover, :focus-visible)) .em-slide { transform: translateX(-8px); }
