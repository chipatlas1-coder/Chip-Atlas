---
/** The eight chip forms of ISO 3685:1993 Annex G, drawn schematically. */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const names = tr
  ? ['Şerit', 'Boru', 'Spiral', 'Rondela tipi helis', 'Konik helis', 'Yay', 'Parçacık', 'İğne']
  : ['Ribbon', 'Tubular', 'Spiral', 'Washer-type helical', 'Conical helical', 'Arc', 'Elemental', 'Needle'];

const W = 160, H = 130;
const f = (n: number) => n.toFixed(1);

function ribbon() {
  let a = '', b = '';
  for (let i = 0; i <= 60; i++) {
    const x = 14 + i * 2.2;
    const y = 62 + 18 * Math.sin(i / 6) + 6 * Math.sin(i / 2.3);
    a += (i ? 'L' : 'M') + f(x) + ' ' + f(y);
    b = 'L' + f(x) + ' ' + f(y + 9) + b;
  }
  return `<path d="${a} ${b.replace(/^L/, 'L')} Z" class="chip"/>`;
}
function coil(cx0: number, cx1: number, r0: number, r1: number, turns: number) {
  let d = '';
  const N = turns * 40;
  for (let i = 0; i <= N; i++) {
    const t = i / N, th = t * turns * 2 * Math.PI;
    const r = r0 + (r1 - r0) * t;
    const x = cx0 + (cx1 - cx0) * t + r * 0.32 * Math.sin(th);
    const y = 64 - r * Math.cos(th);
    d += (i ? 'L' : 'M') + f(x) + ' ' + f(y);
  }
  return `<path d="${d}" class="wire"/>`;
}
function spiral() {
  let d = '';
  for (let i = 0; i <= 220; i++) {
    const th = (i / 220) * 5.2 * Math.PI;
    const r = 4 + th * 2.6;
    d += (i ? 'L' : 'M') + f(80 + r * Math.cos(th)) + ' ' + f(62 + r * Math.sin(th));
  }
  return `<path d="${d}" class="wire"/>`;
}
function arcs() {
  const items = [[44, 46, 0.2], [96, 40, 1.4], [58, 92, 2.6], [112, 88, 3.6], [80, 66, 5.0]];
  return items.map(([x, y, rot]) => {
    const r = 15;
    const a0 = rot, a1 = rot + 3.6;
    const p0 = [x + r * Math.cos(a0), y + r * Math.sin(a0)];
    const p1 = [x + r * Math.cos(a1), y + r * Math.sin(a1)];
    return `<path d="M${f(p0[0])} ${f(p0[1])} A${r} ${r} 0 1 1 ${f(p1[0])} ${f(p1[1])}" class="wire thick"/>`;
  }).join('');
}
function elemental() {
  const pts = [[40, 40], [70, 36], [104, 44], [126, 70], [50, 76], [84, 70], [110, 96], [64, 100], [36, 102], [94, 104]];
  return pts.map(([x, y], i) => {
    const s = 5 + (i % 3) * 2;
    return `<path d="M${x} ${y} l${s} ${-s / 2} l${s / 2} ${s} l${-s} ${s / 2} z" class="chip"/>`;
  }).join('');
}
function needle() {
  const pts = [[30, 40, 0.3], [60, 30, -0.4], [100, 38, 0.5], [40, 76, -0.2], [84, 70, 0.9], [120, 80, -0.7], [58, 104, 0.1], [104, 108, 0.4]];
  return pts.map(([x, y, a]) => `<line x1="${x}" y1="${y}" x2="${f(x + 24 * Math.cos(a))}" y2="${f(y + 24 * Math.sin(a))}" class="wire"/>`).join('');
}

const cells = [
  ribbon(),
  coil(22, 138, 16, 16, 7),
  spiral(),
  coil(40, 120, 34, 34, 6),
  coil(30, 130, 10, 32, 6),
  arcs(),
  elemental(),
  needle(),
];
---
<div class="cf">
  <svg class="cf-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="cf-grad" gradientUnits="userSpaceOnUse" x1="14" y1={H - 30} x2={W - 14} y2="16">
        <stop offset="0" stop-color="#9d6d00" /><stop offset="0.45" stop-color="#b35a24" /><stop offset="0.8" stop-color="#f1e1ff" /><stop offset="1" stop-color="#3c61ad" />
      </linearGradient>
    </defs>
  </svg>
  <ol class="chipforms" aria-label={tr ? 'ISO 3685 talaş formları' : 'ISO 3685 chip forms'}>
    {cells.map((c, i) => (
      <li>
        <svg viewBox={`0 6 ${W} ${H - 12}`} role="img" aria-label={names[i]} set:html={c} />
        <span class="nm"><b class="num">{i + 1}</b>{names[i]}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .cf-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .chipforms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  @media (max-width: 40rem) { .chipforms { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .chipforms li { margin: 0; display: grid; gap: 0.15rem; padding: 0.35rem 0.5rem 0.55rem; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 6px; }
  .chipforms li::before { content: none; }
  .chipforms svg { width: 100%; height: auto; display: block; }
  .nm { display: flex; gap: 0.45rem; align-items: baseline; font-size: 0.8rem; color: var(--ink-2); line-height: 1.25; }
  .nm .num { font-family: var(--font-mono); font-weight: 500; color: var(--color-spark-400); font-size: 0.76rem; }
  .chipforms :global(.chip) { fill: url(#cf-grad); stroke: #1b1d1e; stroke-width: 0.8; }
  .chipforms :global(.wire) { fill: none; stroke: url(#cf-grad); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .chipforms :global(.thick) { stroke-width: 4; }
</style>
