---
/**
 * Spindle interfaces in section, schematic: a 7:24 steep taper (contact on the taper only, a gap at the face), a
 * dual-contact steep taper (taper and face), and HSK (a short hollow 1:10 taper with face contact, clamped from
 * inside by drawbar fingers on a shoulder). The drawbar pulls the holder in; the contact surfaces light up. A speed
 * slider expands the spindle bore (exaggerated): the plain steep-taper holder is drawn in (CTE, BIG DAISHOWA), the
 * dual-contact holder is held by its face and keeps taper and face contact (its bore growth is not drawn), the HSK
 * shank expands with the spindle as BIG DAISHOWA and Hanson describe it (a study cited by Rivin et al. 1999 found the
 * thin wall curving inward). Contact is drawn only where the drawn surfaces meet. Exaggerated; not to scale.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { modes: { sk: '7:24 koni', dual: 'Çift temaslı 7:24', hsk: 'HSK 1:10' }, speed: 'İş mili devri', low: 'durgun', mid: 'orta', high: 'yüksek', taper: 'koni teması', face: 'alın teması', gap: 'boşluk', pull: 'çekme kuvveti', stud: 'pull stud', seg: 'parmaklar', shift: 'tutucu içeri çekilir', held: 'tutucuyu alın tutar', spindle: 'iş mili', holder: 'takım tutucu', aria: 'İş mili arayüzleri kesitte: 7:24 koni, çift temaslı 7:24 koni ve HSK; devir arttıkça iş mili genişler' }
  : { modes: { sk: 'Steep taper 7:24', dual: 'Dual contact 7:24', hsk: 'HSK 1:10' }, speed: 'Spindle speed', low: 'at rest', mid: 'medium', high: 'high', taper: 'taper contact', face: 'face contact', gap: 'gap', pull: 'drawbar force', stud: 'pull stud', seg: 'drawbar fingers', shift: 'holder drawn in', held: 'the face holds the holder', spindle: 'spindle', holder: 'holder', aria: 'Spindle interfaces in section: 7:24 steep taper, dual-contact steep taper and HSK; the spindle expands as the speed rises' };
---
<div class="sptp" data-sptp data-locale={locale} data-anim>
  <div class="seg" data-g="m">{(['sk', 'dual', 'hsk'] as const).map((k, i) => <button type="button" data-v={k} aria-pressed={String(i === 0)}>{T.modes[k]}</button>)}</div>
  <svg class="sc" viewBox="0 0 640 300" role="img" aria-label={T.aria} data-sc></svg>
  <label class="field" data-speedrow><span>{T.speed} <output data-o="s">—</output></span><input type="range" min="0" max="1" step="0.01" value="0" data-i="s" /></label>
  <script type="application/json" data-text set:html={JSON.stringify(T)} />
</div>

<style>
  .sptp { display: grid; gap: 0.7rem; }
  .seg { display: flex; flex-wrap: wrap; border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
  .seg button { flex: 1 1 9rem; font: inherit; font-size: 0.84rem; padding: 0.4rem 0.5rem; border: 0; background: var(--bg-raised); color: var(--ink-2); cursor: pointer; min-height: 2.3rem; }
  .seg button + button { border-left: 1px solid var(--line-strong); }
  .seg button[aria-pressed='true'] { background: var(--accent); color: #fff; }
  .sc { width: 100%; height: auto; display: block; }
  .field { display: grid; gap: 0.3rem; max-width: 30rem; }
  .field > span:first-child { font-size: 0.85rem; color: var(--ink-2); }
  .field output { color: var(--data); font-family: var(--font-mono); font-weight: 600; }
  .field input[type='range'] { width: 100%; accent-color: var(--accent); }
  .sptp :global(.tx) { font: 12px var(--font-mono); fill: #364554; paint-order: stroke; stroke: #fff; stroke-width: 3px; stroke-linejoin: round; }
  .sptp.narrow :global(.tx) { font-size: 19px; }
</style>

<script>
  import { whenIn } from '../../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-sptp]').forEach((root) => {
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const q = <E extends Element>(s: string) => root.querySelector(s) as E;
    const sc = q<SVGSVGElement>('[data-sc]');
    const inp = q<HTMLInputElement>('[data-i="s"]');
    const f = (n: number) => n.toFixed(1);
    const CY = 150, FACE = 300;
    type Mode = 'sk' | 'dual' | 'hsk';
    let mode: Mode = 'sk', t = 1, last = 0, auto = false, ph = 0;
    const it = root.dataset.locale === 'tr' ? ' style="font-style:italic"' : '';
    const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
    const draw = () => {
      const v = +inp.value;
      const nw = root.classList.contains('narrow');
      const pullIn = ease(Math.min(1, t / 0.45));                 // drawbar stroke 0…1
      const open = v * 6;                                          // spindle mouth opening at the face (px, exaggerated)
      let s = '';
      const steep = mode !== 'hsk';
      // taper geometry (radius at the face, holder taper length, half-angle); the bore runs 8 deeper than the
      // holder's small end, so the shank never bottoms on a spindle shoulder
      const L = steep ? 140 : 56, LB = L + (mode === 'sk' ? 16 : 8);
      const R0 = steep ? 58 : 54;
      const slope = steep ? 7 / 48 : 1 / 20;                       // tan(half-angle): 7:24 and 1:10 on diameter
      const face0 = mode === 'sk' ? 16 : 0;                        // the plain steep taper keeps a large gap at the face (Rivin et al.)
      // the bore grows with speed, most at the mouth (exaggerated). Dual contact: the holder is held by its face and
      // the drawing keeps the taper in contact (BIG DAISHOWA, Burley in Hanson), so its bore barely opens.
      const kOpen = mode === 'dual' ? 0.08 : mode === 'sk' ? 0.5 : 1;
      const w = (x: number) => Math.max(0, 1 - (FACE - x) / LB);
      const opening = (x: number) => open * kOpen * w(x);
      const bore = (x: number) => R0 - (FACE - x) * slope + opening(x);
      // plain steep taper: contact near the gage line, clearance at the tail (Smith) — a small relief on the tail
      const relief = (x: number) => (mode === 'sk' ? 1.6 * Math.max(0, ((FACE - x) / L - 0.7) / 0.3) : 0);
      // plain steep taper at speed: the drawbar pulls the holder in until it touches again (CTE, BIG DAISHOWA)
      let shift = 0;
      if (mode === 'sk') { let m = Infinity; for (let x = FACE - L; x <= FACE; x += 2) m = Math.min(m, opening(x) + relief(x)); shift = Math.max(0, m / slope); }
      const dx = (1 - pullIn) * 36 - shift;
      const spindle = (sg: 1 | -1) => {
        const Y = (h: number) => CY - sg * h;
        const rin = steep ? 28 : 46;                                 // HSK: room for the clamping unit behind the taper
        let d = `M20,${f(Y(rin))} L${f(FACE - LB)},${f(Y(rin))}`;
        for (let x = FACE - LB; x <= FACE; x += 4) d += ` L${f(x)},${f(Y(bore(x)))}`;
        d += ` L${FACE},${f(Y(bore(FACE)))} L${FACE},${f(Y(100))} L20,${f(Y(100))} Z`;
        return d;
      };
      s += `<path d="${spindle(1)}" fill="url(#ca-hatch)" stroke="#364554" stroke-width="1.5"/><path d="${spindle(-1)}" fill="url(#ca-hatch)" stroke="#364554" stroke-width="1.5"/>`;
      // holder in its own frame (x = screen position when seated at rest), drawn shifted by dx; the HSK shank grows
      // with the spindle, as BIG DAISHOWA and Hanson describe it
      const shank = (x: number) => R0 - (FACE - x) * slope - relief(x) + (mode === 'hsk' ? opening(x) : 0);
      const xF = FACE + face0;                                     // flange face
      // one closed outline (top contour, then the bottom contour back), so no seam is drawn along the axis
      const holder = () => {
        const x0 = FACE - L + dx;
        const top: string[] = [], bot: string[] = [];
        for (let x = FACE - L; x <= xF + 0.01; x += 2) { top.push(`${f(x + dx)},${f(CY - shank(x))}`); bot.unshift(`${f(x + dx)},${f(CY + shank(x))}`); }
        const body = [`${f(xF + dx)},${f(CY - 92)}`, `${f(xF + 44 + dx)},${f(CY - 92)}`, `${f(xF + 44 + dx)},${f(CY - 46)}`, `${f(600 + dx)},${f(CY - 46)}`, `${f(600 + dx)},${f(CY + 46)}`, `${f(xF + 44 + dx)},${f(CY + 46)}`, `${f(xF + 44 + dx)},${f(CY + 92)}`, `${f(xF + dx)},${f(CY + 92)}`];
        let d = `M${top.join(' L')} L${body.join(' L')} L${bot.join(' L')}`;
        if (mode === 'hsk') {
          // the hollow shank: a lip at the open end, then the clamping shoulder (facing into the bore) and the bore
          d += ` L${f(x0)},${f(CY + 38)} L${f(x0 + 7)},${f(CY + 38)} L${f(x0 + 13)},${f(CY + 45)} L${f(x0 + 24)},${f(CY + 45)} L${f(x0 + 24)},${f(CY + 38)} L${f(FACE + 10 + dx)},${f(CY + 38)}`;
          d += ` L${f(FACE + 10 + dx)},${f(CY - 38)} L${f(x0 + 24)},${f(CY - 38)} L${f(x0 + 24)},${f(CY - 45)} L${f(x0 + 13)},${f(CY - 45)} L${f(x0 + 7)},${f(CY - 38)} L${f(x0)},${f(CY - 38)}`;
        }
        return d + ' Z';
      };
      s += `<path d="${holder()}" fill="url(#ca-metal)" stroke="#364554" stroke-width="1.5"/>`;
      // contacts: drawn only where the drawn surfaces meet
      const seated = pullIn > 0.98;
      const faceOn = seated && mode !== 'sk';
      const tc = (sg: 1 | -1) => {
        let d = '', on = false;
        for (let x = FACE - L + 3; x <= FACE - 2; x += 2) {
          const X = x + dx, gap = bore(X) - shank(x);
          if (gap < 0.6) { d += `${on ? 'L' : 'M'}${f(X)},${f(CY - sg * shank(x))}`; on = true; } else on = false;
        }
        return d;
      };
      const tTop = seated ? tc(1) : '';
      const taperOn = tTop.length > 0;
      if (taperOn) s += `<path d="${tTop}" fill="none" stroke="#1e5fc4" stroke-width="4"/><path d="${tc(-1)}" fill="none" stroke="#1e5fc4" stroke-width="4"/>`;
      if (faceOn) s += `<line x1="${FACE}" y1="${f(CY - 62)}" x2="${FACE}" y2="${f(CY - 92)}" stroke="#e2601a" stroke-width="4"/><line x1="${FACE}" y1="${f(CY + 62)}" x2="${FACE}" y2="${f(CY + 92)}" stroke="#e2601a" stroke-width="4"/>`;
      // pull stud / clamping segments and the drawbar
      if (steep) {
        const sx = FACE - L + dx;
        s += `<rect x="${f(sx - 46)}" y="${CY - 9}" width="46" height="18" fill="url(#ca-metal)" stroke="#364554"/><rect x="${f(sx - 60)}" y="${CY - 15}" width="16" height="30" rx="3" fill="url(#ca-metal)" stroke="#364554"/>`;
        if (nw) s += `<text x="${f(sx - 8)}" y="${CY - 38}" class="tx" text-anchor="end"${it}>${T.stud}</text><line x1="${f(sx - 52)}" y1="${CY - 32}" x2="${f(sx - 52)}" y2="${CY - 16}" stroke="#5f6c79"/>`;
        else s += `<text x="${f(sx - 66)}" y="${CY - 10}" class="tx" text-anchor="end"${it}>${T.stud}</text>`;
      } else {
        // clamping unit inside the hollow shank: a drawbar cone spreads the segments into the groove behind the shoulder
        const x0 = FACE - L + dx, rs = 31 + 9 * pullIn;               // segment outer radius: retracted 31 (clears the lip), clamped 40
        // segments: the slanted face (left, top) bears on the shoulder, so spreading them pulls the holder in
        for (const sg of [1, -1] as const) { const Y = (h: number) => f(CY - sg * h); s += `<path d="M${f(x0 + 7)},${Y(rs - 8)} L${f(x0 + 7)},${Y(rs - 2)} L${f(x0 + 13)},${Y(rs + 5)} L${f(x0 + 22)},${Y(rs + 5)} L${f(x0 + 22)},${Y(rs - 8)} Z" fill="#c98a1e" stroke="#7a5a12"/>`; }
        // drawbar with a cone that spreads the segments as it is pulled back
        const cx = x0 + 10 - 4 * pullIn, cr = rs - 8;
        s += `<rect x="40" y="${CY - 6}" width="${f(cx - 40)}" height="12" fill="url(#ca-metal)" stroke="#364554"/><path d="M${f(cx)},${CY - 6} L${f(cx + 14)},${f(CY - cr)} L${f(cx + 18)},${f(CY - cr)} L${f(cx + 18)},${f(CY + cr)} L${f(cx + 14)},${f(CY + cr)} L${f(cx)},${CY + 6} Z" fill="url(#ca-metal)" stroke="#364554"/>`;
        s += `<text x="${f(FACE - L - 8)}" y="${CY - 16}" class="tx" text-anchor="end">${T.seg}</text>`;
      }
      s += `<path d="M${steep ? f(FACE - L - 70 + dx) : f(FACE - L - 40)},${CY + (steep ? 0 : 30)} L${steep ? 40 : 60},${CY + (steep ? 0 : 30)}" stroke="#13998a" stroke-width="3" marker-end="url(#ca-arr-data)" opacity="${f(0.4 + 0.6 * pullIn)}"/>`;
      if (steep) s += `<text x="28" y="${CY + (nw ? 62 : 56)}" class="tx">${T.pull}</text><line x1="64" y1="${CY + (nw ? 46 : 44)}" x2="64" y2="${CY + 4}" stroke="#5f6c79"/>`;
      else s += `<text x="44" y="${CY + 24}" class="tx">${T.pull}</text>`;
      // labels
      if (taperOn) s += nw || mode === 'hsk' ? `<text x="${FACE - 8}" y="${f(CY - R0 - 14)}" class="tx" text-anchor="end" style="fill:#1e5fc4">${T.taper}</text>` : `<text x="${f(FACE - L / 2)}" y="${f(CY - R0 - 16)}" class="tx" text-anchor="middle" style="fill:#1e5fc4">${T.taper}</text>`;
      if (faceOn) s += `<text x="${FACE + 52}" y="${CY - 100}" class="tx" style="fill:#c94f0c">${T.face}</text>`;
      if (mode === 'sk' && seated) s += `<text x="${FACE + 70}" y="${CY - 100}" class="tx">${T.gap}</text><line x1="${f(FACE + (face0 + dx) / 2)}" y1="${CY - 84}" x2="${FACE + 66}" y2="${CY - 104}" stroke="#5f6c79"/>`;
      if (shift > 0.5 && seated) s += `<text x="${FACE + 60}" y="${CY + 118}" class="tx" style="fill:#b23a34">${T.shift} ←</text>`;
      if (mode === 'dual' && seated && open > 2) s += `<text x="${nw ? 634 : FACE + 60}" y="${CY + 118}" class="tx" text-anchor="${nw ? 'end' : 'start'}" style="fill:#0f7a6e">${T.held}</text>`;
      s += `<text x="${nw ? 28 : 40}" y="${nw ? CY - 74 : CY - 108}" class="tx">${T.spindle}</text><text x="${FACE + 140}" y="${CY - 56}" class="tx">${T.holder}</text>`;
      s += `<line x1="10" y1="${CY}" x2="630" y2="${CY}" stroke="#9aa6b2" stroke-width="1" stroke-dasharray="14 4 3 4"/>`;
      sc.innerHTML = s;
      q('[data-o="s"]').textContent = v < 0.05 ? T.low : v > 0.7 ? T.high : T.mid;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-g="m"] button').forEach((b, _, all) => b.addEventListener('click', () => { mode = b.dataset.v as Mode; all.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); t = document.documentElement.classList.contains('anim') ? 0 : 1; if (auto) { ph = 0; inp.value = '0'; } draw(); }));
    inp.addEventListener('input', () => { auto = false; draw(); });
    const fit = () => { const w = sc.getBoundingClientRect().width, was = root.classList.contains('narrow'); root.classList.toggle('narrow', w > 0 && w < 480); if (was !== root.classList.contains('narrow')) draw(); };
    new ResizeObserver(fit).observe(sc);
    draw(); fit();
    let visible = false;
    new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); }).observe(root);
    // with motion on: the holder is drawn in, then the speed rises and falls on its own until the slider is touched
    const step = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      if (visible && t < 1) { t = Math.min(1, t + dt / 2); draw(); }
      else if (visible && auto) { ph += dt; inp.value = String((0.5 - 0.5 * Math.cos((ph * 2 * Math.PI) / 7)).toFixed(2)); draw(); }
      requestAnimationFrame(step);
    };
    whenIn(root, () => { last = performance.now(); t = 0; auto = true; ph = 0; requestAnimationFrame(step); });
  });
</script>
