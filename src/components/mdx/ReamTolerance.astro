---
/**
 * The reamer's diameter limits for a hole class, by ISO 522:1975 sec. 2: pick a size and a hole
 * class; the zones are drawn to scale in µm with the 0.15 IT / 0.35 IT chain and, for comparison,
 * the m6 stock grade. Arithmetic and drawing in src/lib/ream.ts.
 */
import { HOLES, reamerLimits, drawTol } from '../../lib/ream';
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { hole: 'Delik', reamer: 'Rayba', stock: 'm6 stok', nominal: 'Ø', rest: 'kalan', um: 'µm', size: 'Anma çapı', cls: 'Delik toleransı', hiL: 'Rayba en büyük', loL: 'Rayba en küçük', itL: 'Delik tolerans aralığı', aria: 'Delik tolerans bölgesi, ISO 522’ye göre rayba çapı bölgesi ve m6 stok sınıfı, mikrometre ölçeğinde' }
  : { hole: 'Hole', reamer: 'Reamer', stock: 'm6 stock', nominal: 'Ø', rest: 'rest', um: 'µm', size: 'Nominal size', cls: 'Hole class', hiL: 'Reamer max', loL: 'Reamer min', itL: 'Hole tolerance', aria: 'Tolerance zone of the hole, the reamer zone by ISO 522 and the m6 stock grade, to scale in micrometres' };
const dec = (v: string) => (tr ? v.replace('.', ',') : v);
const d0 = 13, c0 = 'H7';
const L = reamerLimits(d0, c0)!;
const G = [drawTol(L, T, false, dec), drawTol(L, T, true, dec)];
const mm = (D: number, um: number) => `${dec((D + um / 1000).toFixed(3))} mm`;
---
<div class="rt" data-rt data-locale={locale} data-anim>
  <div class="controls">
    <label class="field grow"><span>{T.size} <output data-o="d">{dec(String(d0))}</output> mm</span>
      <input type="range" min="1" max="100" step="0.5" value={d0} data-i="d" /></label>
    <div class="field"><span>{T.cls}</span>
      <div class="chips" role="radiogroup" aria-label={T.cls}>
        {HOLES.map((c) => <button type="button" role="radio" aria-checked={c === c0 ? 'true' : 'false'} data-c={c} class:list={[{ on: c === c0 }]}>{c}</button>)}
      </div>
    </div>
  </div>
  <svg viewBox={`0 0 ${G[0].W} ${G[0].H}`} class="wide" role="img" aria-label={T.aria} data-svg="w" set:html={G[0].svg} />
  <svg viewBox={`0 0 ${G[1].W} ${G[1].H}`} class="narrow" role="img" aria-label={T.aria} data-svg="n" set:html={G[1].svg} />
  <dl class="read">
    <div><dt>{T.hiL}</dt><dd class="num" data-o="hi">{mm(d0, L.hi)}</dd></div>
    <div><dt>{T.loL}</dt><dd class="num" data-o="lo">{mm(d0, L.lo)}</dd></div>
    <div><dt>{T.itL}</dt><dd class="num" data-o="it">IT{c0.replace(/\D/g, '')} = {L.IT} µm</dd></div>
  </dl>
  <script type="application/json" data-text set:html={JSON.stringify(T)} />
</div>

<style>
  .rt { display: grid; gap: 0.8rem; }
  .rt > svg { width: 100%; height: auto; display: block; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 4px; }
  .narrow { display: none !important; }
  @media (max-width: 40rem) { .wide { display: none !important; } .narrow { display: block !important; } }
  .controls { display: grid; grid-template-columns: 1fr; gap: 0.7rem; }
  .field { display: grid; gap: 0.35rem; min-width: 0; }
  .field > span { font-size: 0.85rem; color: var(--ink-2); }
  .field output { color: var(--data); font-family: var(--font-mono); }
  .field input[type='range'] { width: 100%; accent-color: var(--accent); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .chips button { font: 500 0.78rem var(--font-mono); color: var(--ink-2); background: var(--bg-sunk); border: 1px solid var(--line-strong); border-radius: 4px; padding: 0.3rem 0.5rem; min-width: 2.6rem; min-height: 2rem; cursor: pointer; transition: background-color 140ms, color 140ms, border-color 140ms; }
  .chips button:hover { color: var(--ink); border-color: var(--ink-3); }
  .chips button.on { color: #fbfdff; background: #2a78d6; border-color: #2a78d6; }
  .chips button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .read { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin: 0; }
  @media (max-width: 30rem) { .read { grid-template-columns: 1fr 1fr; } }
  .read dt { font-size: 0.78rem; color: var(--ink-3); line-height: 1.3; }
  .read dd { margin: 0; color: var(--data); font-size: 1.1rem; }
  .read div:nth-child(-n + 2) dd { color: #e2601a; }
  .rt :global(.rt-grid) { stroke: var(--line); stroke-width: 1; }
  .rt :global(.rt-zero) { stroke: var(--ink-2); stroke-width: 1.4; }
  .rt :global(.rt-tick) { font: 11px var(--font-mono); fill: var(--ink-3); }
  .rt :global(.rt-t) { font: 11.5px var(--font-mono); fill: var(--ink-2); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; stroke-linejoin: round; }
  .rt :global(.rt-t.sm) { font-size: 10.5px; fill: var(--ink-3); }
  .rt :global(.rt-h) { font-size: 12.5px; font-weight: 500; fill: var(--ink-2); }
  .rt :global(.rt-z.hole) { fill: color-mix(in oklab, #2a78d6 26%, transparent); stroke: #2a78d6; stroke-width: 1.2; }
  .rt :global(.rt-z.ream) { fill: color-mix(in oklab, #e2601a 34%, transparent); stroke: #e2601a; stroke-width: 1.2; }
  .rt :global(.rt-z.stock) { fill: color-mix(in oklab, #555d63 18%, transparent); stroke: #555d63; stroke-width: 1; stroke-dasharray: 4 3; }
  .rt :global(:is(.rt-t, .rt-h).hole) { fill: #2a78d6; }
  .rt :global(:is(.rt-t, .rt-h).ream) { fill: #e2601a; }
  .rt :global(:is(.rt-t, .rt-h).stock) { fill: #555d63; }
  .rt :global(.rt-ext) { stroke: #2a78d6; stroke-opacity: 0.5; stroke-width: 0.8; stroke-dasharray: 2 3; }
  .rt :global(.rt-dim) { stroke: var(--ink-3); stroke-width: 1; }
  .rt :global(.rt-d.a .rt-dim) { stroke: #c98a0a; }
  .rt :global(.rt-d.b .rt-dim) { stroke: #e2601a; }
  .rt :global(.rt-t.a) { fill: #c98a0a; }
  .rt :global(.rt-t.b) { fill: #e2601a; }
  .rt :global(.rt-t.r) { fill: var(--ink-3); }
  .rt .narrow :global(.rt-t) { font-size: 11px; }
  /* entry: the zones grow from the nominal line, then the chain is dimensioned */
  .rt :global(.rt-z) { transform-box: fill-box; transform-origin: 50% 100%; }
  :global(html.anim) .rt[data-anim]:not([data-in]) :global(:is(.rt-z, .rt-d)) { opacity: 0; }
  :global(html.anim) .rt[data-anim][data-in]:not(.settled) :global(.rt-z) { animation: ca-grow-y 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; animation-delay: calc(var(--i) * 0.18s); }
  :global(html.anim) .rt[data-anim][data-in]:not(.settled) :global(.rt-d) { animation: ca-rise 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; animation-delay: calc(0.75s + var(--i) * 0.16s); }
</style>

<script>
  import { reamerLimits, drawTol } from '../../lib/ream';
  import { whenIn } from '../../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-rt]').forEach((root) => {
    const tr = root.dataset.locale === 'tr';
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const dec = (v: string) => (tr ? v.replace('.', ',') : v);
    const q = <E extends Element>(s: string) => root.querySelector(s) as E;
    const svgs = [q<SVGSVGElement>('[data-svg="w"]'), q<SVGSVGElement>('[data-svg="n"]')];
    const range = q<HTMLInputElement>('[data-i="d"]');
    let cls = (root.querySelector('.chips .on') as HTMLElement).dataset.c!;
    const mm = (D: number, um: number) => `${dec((D + um / 1000).toFixed(3))} mm`;
    const render = () => {
      root.classList.add('settled');
      const d = Number(range.value);
      const L = reamerLimits(d, cls);
      if (!L) return;
      svgs.forEach((svg, i) => { const g = drawTol(L, T, i === 1, dec); svg.setAttribute('viewBox', `0 0 ${g.W} ${g.H}`); svg.innerHTML = g.svg; });
      q('[data-o="d"]').textContent = dec(String(d));
      q('[data-o="hi"]').textContent = mm(d, L.hi);
      q('[data-o="lo"]').textContent = mm(d, L.lo);
      q('[data-o="it"]').textContent = `IT${cls.replace(/\D/g, '')} = ${L.IT} µm`;
    };
    range.addEventListener('input', render);
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.chips button')];
    btns.forEach((b, i) => {
      b.addEventListener('click', () => {
        cls = b.dataset.c!;
        btns.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-checked', String(x === b)); });
        render();
      });
      b.addEventListener('keydown', (e) => {
        const k = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!k) return;
        e.preventDefault();
        const nb = btns[(i + k + btns.length) % btns.length];
        nb.focus(); nb.click();
      });
    });
    whenIn(root, () => setTimeout(() => root.classList.add('settled'), 2200));
  });
</script>
