---
/**
 * Thread-milling feed calculator: the feed at the cutting edge (fz · z · n) against the feed of the
 * tool centre that the program runs, for internal or external ISO coarse threads; the cutter-size
 * limits of ISCAR (≤ 70 % of the major Ø, internal), FRAISA (≤ 2/3 of the nut core Ø)
 * and Vargus (below 70 % of the minor Ø, its standard inserts); the arc-in radius and Z ramp (Allied, Haas). Arithmetic and drawing in src/lib/threadmill.ts.
 */
import { COARSE, feedCalc, drawFeed, type FState } from '../../lib/threadmill';
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { thread: 'Diş', kind: 'Diş türü', int: 'İç diş', ext: 'Dış diş', dc: 'Freze çapı', z: 'Ağız sayısı', vc: 'Kesme hızı', fz: 'Ağız başına ilerleme', n: 'Devir', vf: 'Kesici kenarda ilerleme', vm: 'Merkez ilerlemesi (programlanacak)', pathR: 'Merkez yolu yarıçapı', arc: 'Giriş yayı yarıçapı', zArc: 'Yayda Z', ratio: 'Freze / diş çapı', iscar: 'ISCAR: ≤ %70 · D', vargus: 'Vargus: < %70 · D1', fraisa: 'FRAISA: ≤ ⅔ · D1', ok: 'uygun', over: 'aşıyor', na: 'iç diş için', edge: 'kenar', centre: 'merkez', aria: 'Diş frezelemede kesici kenar ve takım merkezi ilerlemesi: seçilen diş, freze ve ilerleme değerleriyle plan görünüş' }
  : { thread: 'Thread', kind: 'Thread type', int: 'Internal', ext: 'External', dc: 'Cutter Ø', z: 'Flutes', vc: 'Cutting speed', fz: 'Feed per tooth', n: 'Spindle speed', vf: 'Feed at the cutting edge', vm: 'Feed of the tool centre (program this)', pathR: 'Tool-centre path radius', arc: 'Arc-in radius', zArc: 'Z on the arc', ratio: 'Cutter / thread Ø', iscar: 'ISCAR: ≤ 70 % · D', vargus: 'Vargus: < 70 % · D1', fraisa: 'FRAISA: ≤ ⅔ · D1', ok: 'within', over: 'over', na: 'internal only', edge: 'edge', centre: 'centre', aria: 'Feed at the cutting edge and at the tool centre in thread milling: plan view with the chosen thread, cutter and feed' };
const dec = (v: string) => (tr ? v.replace('.', ',') : v);
const st: FState = { th: 5, dc: 12, z: 4, vc: 100, fz: 0.05, internal: true };
const r = feedCalc(st);
const G = drawFeed(st, r, T, dec);
---
<div class="tf" data-tf data-locale={locale} data-anim>
  <div class="controls">
    <label class="field"><span>{T.thread}</span>
      <select data-i="th">{COARSE.map((c, i) => <option value={i} selected={i === st.th}>{c.name} × {dec(String(c.P))}</option>)}</select></label>
    <div class="field"><span>{T.kind}</span>
      <div class="seg" role="radiogroup" aria-label={T.kind}>
        <button type="button" role="radio" aria-checked="true" class="on" data-k="int">{T.int}</button>
        <button type="button" role="radio" aria-checked="false" data-k="ext">{T.ext}</button>
      </div>
    </div>
    <label class="field"><span>{T.z}</span>
      <select data-i="z">{[1, 2, 3, 4, 5, 6].map((z) => <option value={z} selected={z === st.z}>{z}</option>)}</select></label>
    <label class="field wide"><span>{T.dc} <output data-o="dc">{dec(String(st.dc))}</output> mm</span>
      <input type="range" min="2" max="40" step="0.5" value={st.dc} data-i="dc" /></label>
    <label class="field wide"><span>{T.vc} <output data-o="vc">{st.vc}</output> m/{tr ? 'dak' : 'min'}</span>
      <input type="range" min="20" max="300" step="5" value={st.vc} data-i="vc" /></label>
    <label class="field wide"><span>{T.fz} <output data-o="fz">{dec(st.fz.toFixed(3))}</output> mm</span>
      <input type="range" min="0.01" max="0.2" step="0.005" value={st.fz} data-i="fz" /></label>
  </div>
  <div class="body">
    <svg viewBox={`0 0 ${G.W} ${G.H}`} role="img" aria-label={T.aria} data-svg>
      <defs>
        <marker id="tf-m-e" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#e2601a" /></marker>
        <marker id="tf-m-c" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#2a78d6" /></marker>
      </defs>
      <g data-g set:html={G.svg} />
    </svg>
    <dl class="read">
      <div><dt>{T.n}</dt><dd class="num" data-o="n">{Math.round(r.n)} {tr ? 'dev/dak' : 'rpm'}</dd></div>
      <div class="e"><dt>{T.vf}</dt><dd class="num" data-o="vf">{Math.round(r.vf)} mm/{tr ? 'dak' : 'min'}</dd></div>
      <div class="c big"><dt>{T.vm}</dt><dd class="num" data-o="vm">{Math.round(r.vm)} mm/{tr ? 'dak' : 'min'}</dd></div>
      <div><dt>{T.pathR}</dt><dd class="num" data-o="pathR">{dec(r.pathR.toFixed(2))} mm</dd></div>
      <div><dt>{T.arc}</dt><dd class="num" data-o="arc">{dec(r.arcR.toFixed(2))} mm</dd></div>
      <div><dt>{T.zArc}</dt><dd class="num" data-o="zArc">{dec(r.zArc.toFixed(3))} mm</dd></div>
      <div class="chk"><dt>{T.ratio}</dt><dd class="num" data-o="ratio">{dec((r.ratio * 100).toFixed(0))} %</dd></div>
      <div class="chk" data-c="iscar"><dt>{T.iscar}</dt><dd class="num" data-o="iscar">{dec(r.iscar.toFixed(1))} mm · {st.dc <= r.iscar + 1e-9 ? T.ok : T.over}</dd></div>
      <div class="chk" data-c="vargus"><dt>{T.vargus}</dt><dd class="num" data-o="vargus">{dec(r.vargus.toFixed(1))} mm · {st.dc < r.vargus ? T.ok : T.over}</dd></div>
      <div class="chk" data-c="fraisa"><dt>{T.fraisa}</dt><dd class="num" data-o="fraisa">{dec(r.fraisa.toFixed(1))} mm · {st.dc <= r.fraisa + 1e-9 ? T.ok : T.over}</dd></div>
    </dl>
  </div>
  <script type="application/json" data-text set:html={JSON.stringify(T)} />
</div>

<style>
  .tf { display: grid; gap: 0.8rem; }
  .controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem 1rem; align-items: end; }
  @media (max-width: 40rem) { .controls { grid-template-columns: 1fr 1fr; } .wide { grid-column: 1 / -1; } }
  .field { display: grid; gap: 0.3rem; min-width: 0; }
  .field > span { font-size: 0.85rem; color: var(--ink-2); }
  .field output { color: var(--data); font-family: var(--font-mono); }
  .field input[type='range'] { width: 100%; accent-color: var(--accent); }
  select { width: 100%; font: inherit; font-size: 0.85rem; color: var(--ink); background: var(--bg-sunk); border: 1px solid var(--line-strong); border-radius: 4px; padding: 0.35rem 0.5rem; min-height: 2.1rem; }
  .seg { display: flex; border: 1px solid var(--line-strong); border-radius: 4px; overflow: hidden; }
  .seg button { flex: 1; font: inherit; font-size: 0.82rem; color: var(--ink-2); background: var(--bg-sunk); border: 0; padding: 0.35rem 0.5rem; min-height: 2.1rem; cursor: pointer; }
  .seg button + button { border-left: 1px solid var(--line-strong); }
  .seg button.on { background: #2a78d6; color: #fbfdff; }
  .seg button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 1rem; align-items: center; }
  @media (max-width: 40rem) { .body { grid-template-columns: 1fr; } }
  svg { width: 100%; height: auto; display: block; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 4px; }
  .read { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem 0.9rem; margin: 0; }
  @media (max-width: 30rem) { .read { grid-template-columns: 1fr 1fr; } }
  .read dt { font-size: 0.75rem; color: var(--ink-3); line-height: 1.3; }
  .read dd { margin: 0.1rem 0 0; color: var(--ink); font-size: 1rem; }
  .read .e dd { color: #e2601a; }
  .read .c dd { color: #2a78d6; }
  .read .big dd { font-size: 1.2rem; }
  .read .chk dd { font-size: 0.9rem; }
  .read [data-c].bad dd { color: #c2413b; }
  .read [data-c].good dd { color: #0f8f6f; }
  .read [data-c].na dd { color: var(--ink-3); }
  .tf :global(.tf-work) { fill: url(#ca-hatch); stroke: #555d63; stroke-width: 0.9; }
  .tf :global(.tf-hole) { fill: #f2f8ff; }
  .tf :global(.tf-post) { fill: url(#ca-hatch); stroke: #555d63; stroke-width: 0.9; }
  .tf :global(.tf-minor) { fill: none; stroke: #555d63; stroke-width: 0.8; stroke-dasharray: 2 3; }
  .tf :global(.tf-major) { fill: none; stroke: #2a78d6; stroke-width: 1.4; }
  .tf :global(.tf-path) { fill: none; stroke: #2a78d6; stroke-width: 1; stroke-dasharray: 5 4; opacity: 0.7; }
  .tf :global(.tf-tool) { fill: color-mix(in oklab, #202426 22%, transparent); stroke: #1e2123; stroke-width: 1.1; }
  .tf :global(.tf-c) { fill: #2a78d6; }
  .tf :global(.tf-k) { fill: #e2601a; }
  .tf :global(.tf-arr) { stroke-width: 2.4; stroke-linecap: round; }
  .tf :global(.tf-arr.e) { stroke: #e2601a; }
  .tf :global(.tf-arr.c) { stroke: #2a78d6; }
  .tf :global(.tf-t) { font: 500 11.5px var(--font-mono); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; }
  .tf :global(.tf-t.e) { fill: #e2601a; }
  .tf :global(.tf-t.c) { fill: #2a78d6; }
  .tf :global(.tf-cap) { font: 500 11px var(--font-mono); fill: var(--ink-3); }
  /* entry: the arrows grow from their points */
  .tf :global(.tf-arr) { stroke-dasharray: 200; stroke-dashoffset: 0; }
  :global(html.anim) .tf[data-anim]:not([data-in]) :global(.tf-arr) { stroke-dashoffset: 200; }
  :global(html.anim) .tf[data-anim][data-in]:not(.settled) :global(.tf-arr) { animation: tf-grow 0.8s 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; }
  :global(html.anim) .tf[data-anim][data-in]:not(.settled) :global(.tf-arr.c) { animation-delay: 0.6s; }
  @keyframes tf-grow { from { stroke-dashoffset: 200; } to { stroke-dashoffset: 0; } }
</style>

<script>
  import { feedCalc, drawFeed } from '../../lib/threadmill';
  import { whenIn } from '../../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-tf]').forEach((root) => {
    const tr = root.dataset.locale === 'tr';
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const dec = (v: string) => (tr ? v.replace('.', ',') : v);
    const q = <E extends Element>(s: string) => root.querySelector(s) as E;
    const min = tr ? 'dak' : 'min';
    let internal = true;
    const render = (settle = true) => {
      if (settle) root.classList.add('settled');
      const s = { th: Number(q<HTMLSelectElement>('[data-i="th"]').value), dc: Number(q<HTMLInputElement>('[data-i="dc"]').value), z: Number(q<HTMLSelectElement>('[data-i="z"]').value), vc: Number(q<HTMLInputElement>('[data-i="vc"]').value), fz: Number(q<HTMLInputElement>('[data-i="fz"]').value), internal };
      const r = feedCalc(s);
      const g = drawFeed(s, r, T, dec);
      q('[data-g]').innerHTML = g.svg;
      q('[data-o="dc"]').textContent = dec(String(s.dc));
      q('[data-o="vc"]').textContent = String(s.vc);
      q('[data-o="fz"]').textContent = dec(s.fz.toFixed(3));
      q('[data-o="n"]').textContent = `${Math.round(r.n)} ${tr ? 'dev/dak' : 'rpm'}`;
      q('[data-o="vf"]').textContent = `${Math.round(r.vf)} mm/${min}`;
      q('[data-o="vm"]').textContent = `${Math.round(r.vm)} mm/${min}`;
      q('[data-o="pathR"]').textContent = `${dec(r.pathR.toFixed(2))} mm`;
      q('[data-o="arc"]').textContent = internal ? `${dec(r.arcR.toFixed(2))} mm` : '–';
      q('[data-o="zArc"]').textContent = `${dec(r.zArc.toFixed(3))} mm`;
      q('[data-o="ratio"]').textContent = `${dec((r.ratio * 100).toFixed(0))} %`;
      const chk = (k: 'iscar' | 'vargus' | 'fraisa', lim: number) => {
        const box = q<HTMLElement>(`[data-c="${k}"]`), ok = s.dc <= lim + 1e-9;
        box.classList.toggle('good', internal && ok); box.classList.toggle('bad', internal && !ok); box.classList.toggle('na', !internal);
        q(`[data-o="${k}"]`).textContent = internal ? `${dec(lim.toFixed(1))} mm · ${ok ? T.ok : T.over}` : T.na;
      };
      chk('iscar', r.iscar); chk('vargus', r.vargus - 1e-6); chk('fraisa', r.fraisa);
    };
    ['th', 'z'].forEach((k) => q(`[data-i="${k}"]`).addEventListener('change', () => render()));
    ['dc', 'vc', 'fz'].forEach((k) => q(`[data-i="${k}"]`).addEventListener('input', () => render()));
    const segs = [...root.querySelectorAll<HTMLButtonElement>('.seg button')];
    segs.forEach((b) => b.addEventListener('click', () => {
      internal = b.dataset.k === 'int';
      segs.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-checked', String(x === b)); });
      render();
    }));
    render(false);
    whenIn(root, () => setTimeout(() => root.classList.add('settled'), 1600));
  });
</script>
