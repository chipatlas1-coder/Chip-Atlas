---
/**
 * The chip-breaking window as the article describes it (Tungaloy, Mitsubishi): a chip breaker works
 * inside a range of feed and depth of cut. Too low a feed: thin chip, hard to break. Too high:
 * chip restrained too much, edge overloaded. Too shallow a depth of cut: chip too narrow for the
 * breaker. The range generally narrows as cutting speed rises. Schematic: no values on the axes,
 * because every chip breaker has its own chart.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const L = tr
  ? {
      aria: 'Talaş kırma penceresi: ilerlemeye karşı kesme derinliği, şematik',
      x: 'ilerleme f', y: 'kesme derinliği ap', tag: 'şematik, değer yok',
      inside: 'talaş kırılır', speed: 'yüksek vc: daha dar', speedLong: ['yüksek kesme hızı', 'pencere daralır'],
      low: ['ilerleme çok düşük', 'ince talaş,', 'zor kırılır'],
      high: ['ilerleme çok yüksek', 'talaş aşırı kısıtlanır,', 'kenar aşırı yüklenir'],
      shallow: ['kesme derinliği çok küçük:', 'talaş, kırıcının etki edeceği kadar geniş değil'],
    }
  : {
      aria: 'Chip-breaking window: depth of cut against feed, schematic',
      x: 'feed f', y: 'depth of cut ap', tag: 'schematic, no values',
      inside: 'chip breaks', speed: 'higher vc: narrower', speedLong: ['higher cutting speed', 'the window narrows'],
      low: ['feed too low', 'thin chip,', 'hard to break'],
      high: ['feed too high', 'chip restrained too much,', 'edge overloaded'],
      shallow: ['depth of cut too shallow:', 'chip too narrow for the breaker to act on'],
    };
const X0 = 64, X1 = 608, Y0 = 318, Y1 = 28;
const X = (v: number) => X0 + (X1 - X0) * v, Y = (v: number) => Y0 - (Y0 - Y1) * v;
const win = { f0: 0.3, f1: 0.7, a0: 0.2, a1: 0.86 };
const cx = (X(win.f0) + X(win.f1)) / 2, cy = (Y(win.a0) + Y(win.a1)) / 2;
const ww = X(win.f1) - X(win.f0), wh = Y(win.a0) - Y(win.a1);
const k = 0.68;
// snarled long chip (prolate cycloid) for the low-feed zone, short arcs for the window
const snarl = Array.from({ length: 121 }, (_, i) => { const t = (i / 120) * 6 * Math.PI; return `${(X(0.03) + 5.4 * t - 10 * Math.sin(t)).toFixed(1)},${(212 - 10 * Math.cos(t) + 4 * Math.sin(t / 3)).toFixed(1)}`; }).join(' L');
const arcs = [[-26, 4, 0], [0, -2, 40], [26, 5, -30]].map(([dx, dy, r]) => ({ x: cx + dx, y: cy + 26 + dy, r }));
// narrow variant (phones): same chart at 360 units, zones numbered, text in a list below
const nX0 = 34, nX1 = 340, nY0 = 252, nY1 = 30;
const nX = (v: number) => nX0 + (nX1 - nX0) * v, nY = (v: number) => nY0 - (nY0 - nY1) * v;
const ncx = (nX(win.f0) + nX(win.f1)) / 2, ncy = (nY(win.a0) + nY(win.a1)) / 2;
const nww = nX(win.f1) - nX(win.f0), nwh = nY(win.a0) - nY(win.a1);
const nsnarl = Array.from({ length: 91 }, (_, i) => { const t = (i / 90) * 4 * Math.PI; return `${(nX(0.04) + 4.6 * t - 7 * Math.sin(t)).toFixed(1)},${(166 - 7 * Math.cos(t)).toFixed(1)}`; }).join(' L');
const narcs = [[-18, 3, 0], [0, -2, 40], [18, 4, -30]].map(([dx, dy, r]) => ({ x: ncx + dx, y: ncy + 20 + dy, r }));
const badges = [
  { n: 1, x: nX(0.15), y: 116 }, { n: 2, x: nX(0.85), y: 116 }, { n: 3, x: (nX0 + nX1) / 2, y: 230 }, { n: 4, x: ncx, y: ncy - (nwh * k) / 2 },
];
const legend = [
  [L.low[0], `${L.low[1]} ${L.low[2]}`], [L.high[0], `${L.high[1]} ${L.high[2]}`], [L.shallow[0].replace(/:$/, ''), L.shallow[1]], [L.speedLong[0], L.speedLong[1]],
];
---
<div class="chipwin">
  <svg viewBox="0 0 640 354" role="img" aria-label={L.aria} class="wide">
    <rect x={X0} y={Y1} width={X1 - X0} height={Y0 - Y1} class="out" />
    <line x1={X(win.f0)} y1={Y1} x2={X(win.f0)} y2={Y0} class="guide" />
    <line x1={X(win.f1)} y1={Y1} x2={X(win.f1)} y2={Y0} class="guide" />
    <line x1={X0} y1={Y(win.a0)} x2={X1} y2={Y(win.a0)} class="guide" />

    <rect x={X(win.f0)} y={Y(win.a1)} width={ww} height={wh} rx="28" class="win" />
    <rect x={cx - (ww * k) / 2} y={cy - (wh * k) / 2} width={ww * k} height={wh * k} rx="20" class="win2" />
    <text x={cx} y={cy - (wh * k) / 2 - 10} class="sm ink2" text-anchor="middle">{L.speed}</text>
    <text x={cx} y={cy - 4} class="big" text-anchor="middle">{L.inside}</text>
    {arcs.map((a) => <path d={`M${(a.x - 7).toFixed(1)},${a.y.toFixed(1)} a7,7 0 1,1 7,7`} class="arc" transform={`rotate(${a.r} ${a.x} ${a.y})`} />)}

    <text x={X(0.15)} y="120" class="hd" text-anchor="middle">{L.low[0]}</text>
    <text x={X(0.15)} y="140" class="sm" text-anchor="middle">{L.low[1]}</text>
    <text x={X(0.15)} y="155" class="sm" text-anchor="middle">{L.low[2]}</text>
    <path d={`M${snarl}`} class="snarl" />

    <text x={X(0.85)} y="120" class="hd warn" text-anchor="middle">{L.high[0]}</text>
    <text x={X(0.85)} y="140" class="sm" text-anchor="middle">{L.high[1]}</text>
    <text x={X(0.85)} y="155" class="sm" text-anchor="middle">{L.high[2]}</text>
    <g transform={`translate(${X(0.85) - 18} 186)`} class="insert">
      <path d="M0,34 L13.02,9.4 L15.5,12.4 L17.6,8.8 L20.2,12.8 L22.98,9.4 L36,34 Z" />
      <path d="M13.02,9.4 L18,0 L22.98,9.4" class="was" />
      <path d="M13.02,9.4 L15.5,12.4 L17.6,8.8 L20.2,12.8 L22.98,9.4" class="chipped" />
    </g>

    <text x={(X0 + X1) / 2} y="290" class="hd" text-anchor="middle">{L.shallow[0]}</text>
    <text x={(X0 + X1) / 2} y="306" class="sm" text-anchor="middle">{L.shallow[1]}</text>

    <line x1={X0} y1={Y0} x2={X1 + 10} y2={Y0} class="axis" marker-end="url(#ca-arr)" />
    <line x1={X0} y1={Y0} x2={X0} y2={Y1 - 12} class="axis" marker-end="url(#ca-arr)" />
    <text x={X1 + 8} y={Y0 + 24} class="ax" text-anchor="end">{L.x}</text>
    <text x={X0 + 10} y={Y1 - 4} class="ax">{L.y}</text>
    <text x={X1 - 6} y={Y1 + 16} class="tag" text-anchor="end">{L.tag}</text>
  </svg>
  <div class="narrow">
    <svg viewBox="0 0 360 290" role="img" aria-label={L.aria}>
      <rect x={nX0} y={nY1} width={nX1 - nX0} height={nY0 - nY1} class="out" />
      <line x1={nX(win.f0)} y1={nY1} x2={nX(win.f0)} y2={nY0} class="guide" />
      <line x1={nX(win.f1)} y1={nY1} x2={nX(win.f1)} y2={nY0} class="guide" />
      <line x1={nX0} y1={nY(win.a0)} x2={nX1} y2={nY(win.a0)} class="guide" />
      <rect x={nX(win.f0)} y={nY(win.a1)} width={nww} height={nwh} rx="20" class="win" />
      <rect x={ncx - (nww * k) / 2} y={ncy - (nwh * k) / 2} width={nww * k} height={nwh * k} rx="14" class="win2" />
      <text x={ncx} y={ncy + 2} class="big" text-anchor="middle">{L.inside}</text>
      {narcs.map((a) => <path d={`M${(a.x - 5).toFixed(1)},${a.y.toFixed(1)} a5,5 0 1,1 5,5`} class="arc thin" transform={`rotate(${a.r} ${a.x} ${a.y})`} />)}
      <path d={`M${nsnarl}`} class="snarl" />
      <g transform={`translate(${nX(0.85) - 14} 152) scale(0.78)`} class="insert">
        <path d="M0,34 L13.02,9.4 L15.5,12.4 L17.6,8.8 L20.2,12.8 L22.98,9.4 L36,34 Z" />
        <path d="M13.02,9.4 L18,0 L22.98,9.4" class="was" />
        <path d="M13.02,9.4 L15.5,12.4 L17.6,8.8 L20.2,12.8 L22.98,9.4" class="chipped" />
      </g>
      {badges.map((b) => <g class="badge"><circle cx={b.x} cy={b.y} r="11" /><text x={b.x} y={b.y + 4.5} text-anchor="middle">{b.n}</text></g>)}
      <line x1={nX0} y1={nY0} x2={nX1 + 8} y2={nY0} class="axis" marker-end="url(#ca-arr)" />
      <line x1={nX0} y1={nY0} x2={nX0} y2={nY1 - 10} class="axis" marker-end="url(#ca-arr)" />
      <text x={nX1 + 6} y={nY0 + 24} class="ax" text-anchor="end">{L.x}</text>
      <text x={nX0 + 10} y={nY1 - 6} class="ax">{L.y}</text>
    </svg>
    <ol class="legend">
      {legend.map(([a, b], i) => <li><span class="n">{i + 1}</span><span><b>{a}</b>: {b}</span></li>)}
    </ol>
    <p class="tagline">{L.tag}</p>
  </div>
</div>

<style>
  .chipwin .narrow { display: none; }
  @media (max-width: 40rem) { .chipwin .wide { display: none; } .chipwin .narrow { display: block; } }
  .chipwin .badge circle { fill: #fbfdff; stroke: var(--color-spark-400); stroke-width: 1.4; }
  .chipwin .badge text { font-size: 12px; font-weight: 600; fill: var(--color-spark-400); }
  .chipwin .arc.thin { stroke-width: 2.8; }
  .chipwin .narrow .ax { font-size: 12.5px; }
  .chipwin .narrow .big { font-size: 14px; }
  .chipwin .legend { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.45rem; font-size: 0.86rem; color: var(--ink-2); }
  .chipwin .legend li { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0.5rem; align-items: start; margin: 0; }
  .chipwin .legend li::before { content: none; }
  .chipwin .legend b { color: var(--ink); font-weight: 600; }
  .chipwin .legend .n { width: 1.35rem; height: 1.35rem; border-radius: 50%; border: 1.4px solid var(--color-spark-400); color: var(--color-spark-400); font: 600 0.75rem/1.2rem var(--font-mono); text-align: center; }
  .chipwin .tagline { margin: 0.5rem 0 0; font: 0.75rem var(--font-mono); color: var(--ink-3); }
  .chipwin svg { width: 100%; height: auto; display: block; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 4px; }
  .chipwin text { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-2); }
  .chipwin .out { fill: color-mix(in oklab, #e2601a 3.5%, transparent); }
  .chipwin .guide { stroke: #cdd5db; stroke-width: 1; stroke-dasharray: 4 4; }
  .chipwin .win { fill: color-mix(in oklab, #1e6fd6 15%, #fbfdff); stroke: #1e6fd6; stroke-width: 1.6; }
  .chipwin .win2 { fill: color-mix(in oklab, #1e6fd6 10%, transparent); stroke: #1b1d1e; stroke-opacity: 0.7; stroke-width: 1.2; stroke-dasharray: 5 4; }
  .chipwin .big { font-family: var(--font-sans); font-size: 15px; font-weight: 600; fill: var(--color-metro-400); }
  .chipwin .hd { font-family: var(--font-sans); font-size: 12.5px; font-weight: 600; fill: var(--ink); }
  .chipwin .warn { fill: var(--color-spark-400); }
  .chipwin .sm { font-size: 10.5px; }
  .chipwin .ink2 { fill: var(--ink-2); }
  .chipwin .ax { font-size: 11.5px; fill: var(--ink); }
  .chipwin .tag { font-size: 10px; fill: var(--ink-3); }
  .chipwin .axis { stroke: #474e54; stroke-width: 1.3; }
  .chipwin .arc { fill: none; stroke: #bc7227; stroke-width: 3.4; stroke-linecap: round; }
  .chipwin .snarl { fill: none; stroke: #b35a24; stroke-width: 1.8; stroke-linejoin: round; opacity: 0.9; }
  .chipwin .insert path:first-child { fill: url(#ca-carbide); stroke: #2c3033; stroke-width: 1.1; stroke-linejoin: round; }
  .chipwin .insert .chipped { fill: none; stroke: #e2601a; stroke-width: 1.6; stroke-linejoin: round; }
  .chipwin .insert .was { fill: none; stroke: #656e74; stroke-width: 1; stroke-dasharray: 2 2; }
</style>
