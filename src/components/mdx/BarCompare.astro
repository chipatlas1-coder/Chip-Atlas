---
/**
 * One property compared across materials: a bar per material, the page's own material(s)
 * highlighted, an optional low–high whisker where the sources give a range. Values come from the
 * article (each with its source in the article's table); nothing is computed here.
 * Wide layout: labels in a column on the left. Narrow layout: label above each bar.
 * Optional `outer`: a second, larger value of the same row (e.g. Rm around Rp0.2), drawn as an
 * outlined bar behind the solid one; `legend` then names the two.
 */
interface Bar { label: string; sub?: string; value: number; lo?: number; hi?: number; text?: string; highlight?: boolean; outer?: number; outerText?: string }
interface Props {
  locale: 'en' | 'tr'; bars: Bar[]; max: number; ticks: number[]; unit: string; axisLabel: string; aria: string;
  dec?: number; labelWidth?: number; legend?: [string, string];
}
const { locale, bars, max, ticks, unit, axisLabel, aria, dec = 0, labelWidth = 190, legend } = Astro.props;
const tr = locale === 'tr';
const n = (v: number) => { const t = v.toFixed(dec); return tr ? t.replace('.', ',') : t; };
function layout(narrow: boolean) {
  const two = bars.some((b) => b.outer !== undefined);
  const W = narrow ? 360 : 660, L = narrow ? 12 : labelWidth, R = narrow ? (two ? 74 : 52) : (two ? 96 : 70), T = 10;
  const subs = bars.some((b) => b.sub);
  const rowH = narrow ? 42 : subs ? 36 : 30, head = narrow ? 15 : 0;
  const H = T + bars.length * rowH + 40;
  const X = (v: number) => L + (v / max) * (W - L - R);
  return { narrow, W, L, R, T, rowH, head, H, X, two };
}
const geo = [layout(false), layout(true)];
---
<div class="barcmp">
  {legend && <div class="legend" aria-hidden="true"><span><i class="k1"></i>{legend[0]}</span><span><i class="k2"></i>{legend[1]}</span></div>}
  {geo.map((g) => (
    <svg viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-label={aria} class:list={['bc', g.narrow ? 'narrow' : 'wide']}>
      {ticks.map((t) => (
        <g>
          <line x1={g.X(t)} x2={g.X(t)} y1={g.T} y2={g.T + bars.length * g.rowH} class="grid" />
          <text x={g.X(t)} y={g.T + bars.length * g.rowH + 16} text-anchor="middle" class="tick">{Number.isInteger(t) ? String(t) : n(t)}</text>
        </g>
      ))}
      <text x={g.W - g.R + (g.narrow ? 46 : 64)} y={g.T + bars.length * g.rowH + 34} text-anchor="end" class="lab">{unit ? `${axisLabel} (${unit})` : axisLabel}</text>
      {bars.map((b, i) => {
        const y = g.T + i * g.rowH + g.head, bh = g.narrow ? 14 : 16, yc = y + (g.rowH - g.head) / 2;
        return (
          <g class:list={['row', { hl: b.highlight }]}>
            <title>{`${b.label}${b.sub ? ` (${b.sub})` : ''}: ${legend ? `${legend[0]} ` : ''}${b.text ?? n(b.value)}${b.outer !== undefined ? ` · ${legend ? `${legend[1]} ` : ''}${b.outerText ?? n(b.outer)}` : ''}${unit ? ` ${unit}` : ''}`}</title>
            {g.narrow
              ? <text x={g.L} y={y - 3} class="name">{b.label}{b.sub && <tspan class="sub"> {b.sub}</tspan>}</text>
              : <>
                  <text x={g.L - 12} y={b.sub ? yc - 1 : yc + 4} text-anchor="end" class="name">{b.label}</text>
                  {b.sub && <text x={g.L - 12} y={yc + 12} text-anchor="end" class="sub">{b.sub}</text>}
                </>}
            {b.outer !== undefined && <rect x={g.L + 0.5} y={yc - bh / 2 - 2.5} width={Math.max(2, g.X(b.outer) - g.L - 1)} height={bh + 5} rx="3" class="outer" />}
            <rect x={g.L} y={b.outer !== undefined ? yc - bh / 2 + 2 : yc - bh / 2} width={Math.max(2, g.X(b.value) - g.L)} height={b.outer !== undefined ? bh - 4 : bh} rx="2" class="bar" />
            {b.lo !== undefined && b.hi !== undefined && (
              <g class="wh">
                <line x1={g.X(b.lo)} x2={g.X(b.hi)} y1={yc} y2={yc} />
                <line x1={g.X(b.lo)} x2={g.X(b.lo)} y1={yc - 5} y2={yc + 5} />
                <line x1={g.X(b.hi)} x2={g.X(b.hi)} y1={yc - 5} y2={yc + 5} />
              </g>
            )}
            {b.outer === undefined
              ? <text x={g.X(b.hi ?? b.value) + 7} y={yc + 4} class="val">{b.text ?? n(b.value)}</text>
              : <text x={g.X(Math.max(b.outer, b.hi ?? 0)) + 7} y={yc + 4} class="val">{b.text ?? n(b.value)}<tspan class="sep"> / </tspan><tspan class="v2">{b.outerText ?? n(b.outer)}</tspan></text>}
          </g>
        );
      })}
    </svg>
  ))}
</div>

<style>
  .barcmp { display: grid; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; font-size: 0.8rem; color: var(--ink-2); margin: 0 0 0.35rem 0.2rem; }
  .legend span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .legend i { width: 16px; height: 10px; border-radius: 2px; display: inline-block; }
  .legend .k1 { background: color-mix(in oklab, #1e6fd6 55%, #ecf2f7); }
  .legend .k2 { border: 1px solid #656e74; background: color-mix(in oklab, #1b1d1e 8%, transparent); }
  .outer { fill: color-mix(in oklab, #1b1d1e 7%, transparent); stroke: #656e74; stroke-width: 1; }
  .hl .outer { stroke: #e2601a; fill: color-mix(in oklab, #d4520f 12%, transparent); }
  .val .sep { fill: var(--ink-3); }
  .val .v2 { fill: var(--ink-3); }
  .hl .val .v2 { fill: color-mix(in oklab, #e2601a 70%, var(--ink-3)); }
  .narrow { display: none; }
  @media (max-width: 40rem) { .wide { display: none; } .narrow { display: block; } }
  .grid { stroke: var(--line); }
  .tick { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-3); }
  .lab { font-family: var(--font-mono); font-size: 11.5px; fill: var(--ink-3); }
  .name { font-family: var(--font-sans); font-size: 13px; fill: var(--ink-2); }
  .sub { font-family: var(--font-mono); font-size: 10.5px; fill: var(--ink-3); }
  .narrow .name { font-size: 12.5px; }
  .bar { fill: color-mix(in oklab, #1e6fd6 55%, #ecf2f7); }
  .hl .bar { fill: #d4520f; }
  .hl .name { fill: var(--ink); font-weight: 600; }
  .wh line { stroke: #1b1d1e; stroke-width: 1.2; stroke-opacity: 0.7; }
  .val { font-family: var(--font-mono); font-size: 12px; fill: var(--ink-2); }
  .hl .val { fill: #e2601a; }
</style>
