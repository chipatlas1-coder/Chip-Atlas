---
/**
 * Coolant pressure bands for chip control, as ISCAR's Threading Handbook (p. 122) names them, on a log scale of bar,
 * with Sandvik Coromant's "up to 80 bar" from its high-pressure coolant film marked. HTML, so the notes wrap on phones.
 * The bands grow in from the left on entry.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const lo = 5, hi = 400;
const pos = (v: number) => ((Math.log(v) - Math.log(lo)) / (Math.log(hi) - Math.log(lo))) * 100;
const T = tr
  ? {
      aria: 'ISCAR’ın soğutma basıncı aralıkları, logaritmik bar ölçeğinde: 30 bara kadar düşük, 30–120 bar yüksek, 120–400 bar çok yüksek basınç',
      axis: 'bar, logaritmik ölçek',
      bands: [
        { k: 'LP', name: 'düşük basınç', range: '≤ 30 bar', note: 'Takım ömrünü iyileştirebilir; talaş kontrolüne genellikle etkisi olmaz.' },
        { k: 'HP', name: 'yüksek basınç', range: '30–120 bar', note: 'ISCAR’a göre JHP takımlarıyla en çok kullanılan aralık: takım ömrü, kesme hızı ve talaş kontrolü iyileşir.' },
        { k: 'UHP', name: 'çok yüksek basınç', range: '120–400 bar', note: 'Fazla basınçtan yararlanmak için özel takım tasarımı gerekir.' },
      ],
      mark: 'Sandvik Coromant: 80 bara kadar',
    }
  : {
      aria: 'ISCAR’s coolant pressure bands on a log scale of bar: low up to 30 bar, high 30–120 bar, ultra high 120–400 bar',
      axis: 'bar, log scale',
      bands: [
        { k: 'LP', name: 'low pressure', range: '≤ 30 bar', note: 'May improve tool life; usually no effect on chip control.' },
        { k: 'HP', name: 'high pressure', range: '30–120 bar', note: 'The range ISCAR says is most used with its JHP tools: tool life, cutting speed and chip control improve.' },
        { k: 'UHP', name: 'ultra high pressure', range: '120–400 bar', note: 'Needs a special tool design to make use of the extra pressure.' },
      ],
      mark: 'Sandvik Coromant: up to 80 bar',
    };
const edges = [lo, 30, 120, hi];
const ticks = [10, 20, 30, 50, 80, 120, 200, 400];
---
<div class="pb" data-anim role="img" aria-label={T.aria}>
  <div class="track">
    {T.bands.map((b, i) => (
      <div class={`seg s${i}`} style={`left:${pos(edges[i])}%; width:${pos(edges[i + 1]) - pos(edges[i])}%; --i:${i}`}><b>{b.k}</b></div>
    ))}
    <div class="mark" style={`left:${pos(80)}%`}><span>{T.mark}</span></div>
  </div>
  <div class="ticks" aria-hidden="true">
    {ticks.map((t) => <span class:list={{ end: t === hi }} style={`left:${pos(t)}%`}>{t}</span>)}
    <em>{T.axis}</em>
  </div>
  <dl class="notes">
    {T.bands.map((b, i) => (
      <div class={`n n${i}`}><dt><i></i>{b.k} · {b.name} <span>{b.range}</span></dt><dd>{b.note}</dd></div>
    ))}
  </dl>
</div>

<style>
  .pb { display: grid; gap: 0.4rem; padding-top: 1.9rem; }
  .track { position: relative; height: 2.6rem; border-radius: 10px; background: #eef2f6; }
  .seg { position: absolute; top: 0; bottom: 0; display: grid; place-items: center; color: #fff; font: 700 0.85rem var(--font-mono); letter-spacing: 0.04em; transform-origin: left center; }
  .seg.s0 { background: linear-gradient(90deg, #9fc3ee, #5b93dc); border-radius: 10px 0 0 10px; }
  .seg.s1 { background: linear-gradient(90deg, #13998a, #0f7a6e); }
  .seg.s2 { background: linear-gradient(90deg, #8b52c9, #6d3aa8); border-radius: 0 10px 10px 0; }
  .seg + .seg { box-shadow: inset 2px 0 0 #fff; }
  .mark { position: absolute; top: -1.9rem; bottom: -0.35rem; width: 0; border-left: 2px dashed #e2601a; }
  .mark span { position: absolute; bottom: calc(100% - 1.35rem); left: 0.4rem; white-space: nowrap; font: 600 0.78rem var(--font-sans); color: #c94f0c; }
  .mark::after { content: ''; position: absolute; left: -6px; bottom: -4px; width: 10px; height: 10px; border-radius: 50%; background: #e2601a; border: 2px solid #fff; }
  .ticks { position: relative; height: 1.5rem; font: 0.72rem var(--font-mono); color: var(--ink-3); }
  .ticks span { position: absolute; top: 0.15rem; transform: translateX(-50%); }
  .ticks span.end { transform: translateX(-100%); }
  .ticks em { position: absolute; right: 0; top: 1.15rem; font-style: normal; font-size: 0.7rem; }
  .notes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem 1rem; margin: 0.9rem 0 0; }
  @media (max-width: 40rem) { .notes { grid-template-columns: 1fr; } .mark span { left: auto; right: 0.4rem; } }
  .n dt { font: 600 0.82rem var(--font-sans); color: var(--ink); display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .n dt span { font: 500 0.75rem var(--font-mono); color: var(--ink-3); }
  .n dt i { width: 0.7rem; height: 0.7rem; border-radius: 3px; display: inline-block; }
  .n0 dt i { background: #5b93dc; } .n1 dt i { background: #13998a; } .n2 dt i { background: #8b52c9; }
  .n dd { margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--ink-2); line-height: 1.45; }
  :global(html.anim) .pb[data-anim]:not([data-in]) .seg { transform: scaleX(0); }
  :global(html.anim) .pb[data-anim]:not([data-in]) .mark { opacity: 0; }
  :global(html.anim) .pb[data-anim][data-in] .seg { animation: pb-grow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; animation-delay: calc(0.1s + var(--i) * 0.35s); }
  :global(html.anim) .pb[data-anim][data-in] .mark { animation: pb-drop 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 1.3s backwards; }
  @keyframes pb-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes pb-drop { from { opacity: 0; transform: translateY(-0.8rem); } to { opacity: 1; transform: none; } }
</style>
