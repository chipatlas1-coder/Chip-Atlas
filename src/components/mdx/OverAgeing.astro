---
/**
 * Why 7075 is sold in T73: strength against degree of ageing (schematic curve), with the tempers
 * placed on it, and under each temper the stress-corrosion rating and the conductivity range used
 * to check it. The curve is drawn through the typical tensile strengths the article gives (T6 at
 * the peak, T73 past it); its shape between them is schematic. Ratings and ranges come from props.
 */
interface Temper { code: string; u: number; rm?: number; scc: 1 | 2 | 3; sccText: string; iacs: string }
interface Props { locale: 'en' | 'tr'; tempers: Temper[]; rmPeak: number; rmLate: number; uLate: number; aria: string }
const { locale, tempers, rmPeak, rmLate, uLate, aria } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { x: 'yaşlandırma derecesi (şematik) →', y: 'dayanım', peak: 'en yüksek dayanım', under: 'az yaşlanmış', over: 'aşırı yaşlanmış', scc: 'Gerilmeli korozyon direnci', sccS: 'ECSS-Q-70-36A', ia: 'Elektrik iletkenliği, % IACS', iaS: 'AMS 2658D, tipik aralık', typ: 'tipik Rm' }
  : { x: 'degree of ageing (schematic) →', y: 'strength', peak: 'peak strength', under: 'underaged', over: 'overaged', scc: 'Stress-corrosion resistance', sccS: 'ECSS-Q-70-36A', ia: 'Electrical conductivity, % IACS', iaS: 'AMS 2658D, typical range', typ: 'typical Rm' };
// log-normal-shaped ageing curve through (uPeak, rmPeak) and (uLate, rmLate); base = as quenched (schematic)
const uPeak = tempers[0].u, base = 300;
const sig2 = Math.log(uLate / uPeak) ** 2 / (2 * -Math.log((rmLate - base) / (rmPeak - base)));
const S = (u: number) => base + (rmPeak - base) * Math.exp(-(Math.log(u / uPeak) ** 2) / (2 * sig2));
function layout(narrow: boolean) {
  const W = narrow ? 360 : 660;
  const px0 = narrow ? 18 : 40, px1 = W - (narrow ? 14 : 20);
  const pTop = 44, pBot = narrow ? 206 : 216;
  const X = (u: number) => px0 + u * (px1 - px0);
  const Y = (v: number) => pBot - ((v - 280) / (600 - 280)) * (pBot - pTop);
  const pts = Array.from({ length: 61 }, (_, i) => 0.02 + (i / 60) * 0.98).map((u) => `${X(u).toFixed(1)},${Y(S(u)).toFixed(1)}`);
  const r1 = pBot + 66, r2 = r1 + 64;
  const H = r2 + 30;
  return { narrow, W, H, px0, px1, pTop, pBot, X, Y, d: 'M' + pts.join(' L'), r1, r2 };
}
const G = [layout(false), layout(true)];
---
<div class="overage">
  {G.map((g) => (
    <svg viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-label={aria} class:list={['oa', g.narrow ? 'narrow' : 'wide']}>
      {/* plot frame */}
      <line x1={g.px0} x2={g.px0} y1={g.pTop - 8} y2={g.pBot} class="ax" />
      <line x1={g.px0} x2={g.px1} y1={g.pBot} y2={g.pBot} class="ax" />
      <text x={g.px0 + 6} y={g.pTop - 18} class="lab mut">{T.y} ↑</text>
      <text x={g.px1} y={g.pBot + 18} text-anchor="end" class="lab mut">{T.x}</text>
      {/* under- and overaged regions */}
      <rect x={g.X(tempers[0].u)} y={g.pTop - 8} width={g.px1 - g.X(tempers[0].u)} height={g.pBot - g.pTop + 8} class="overz" />
      <text x={(g.px0 + g.X(tempers[0].u)) / 2} y={g.pBot - 10} text-anchor="middle" class="lab mut">{T.under}</text>
      <text x={(g.X(tempers[0].u) + g.px1) / 2 + (g.narrow ? 20 : 30)} y={g.pBot - 10} text-anchor="middle" class="lab dat">{T.over}</text>
      <path d={g.d} class="glow" />
      <path d={g.d} class="curve" />
      {/* tempers: marker, tag, guide down through the rows */}
      {tempers.map((t, i) => {
        const x = g.X(t.u), y = g.Y(S(t.u));
        return (
          <g>
            <line x1={x} x2={x} y1={y + (t.rm && (i > 0 || g.narrow) ? 32 : 7)} y2={g.r1 - 9} class="guide" />
            <line x1={x} x2={x} y1={g.r1 + 26} y2={g.r2 - 14} class="guide" />
            <circle cx={x} cy={y} r="5.5" class:list={['mk', { pk: i === 0 }]} />
            <rect x={x - 22} y={y - 34} width="44" height="18" rx="9" class:list={['tag', { pk: i === 0 }]} />
            <text x={x} y={y - 21} text-anchor="middle" class="tagt">{t.code}</text>
            {t.rm && (i === 0 && !g.narrow
              ? <text x={x + 30} y={y - 27} class="rm">{t.rm} MPa<tspan class="mut2" x={x + 30} dy="13">{T.typ}</tspan></text>
              : <text x={x} y={y + 24} text-anchor="middle" class="rm">{t.rm} MPa<tspan class="mut2"> {T.typ}</tspan></text>)}
            {/* rows */}
            <g transform={`translate(${x} ${g.r1})`}>
              {[1, 2, 3].map((k) => <circle cx={(k - 2) * 12} cy="0" r="4.2" class:list={['pip', { on: k <= t.scc }]} />)}
              <text y="19" text-anchor="middle" class="rv">{t.sccText}</text>
            </g>
            <text x={x} y={g.r2 + 4} text-anchor="middle" class="rv iacs">{t.iacs}</text>
          </g>
        );
      })}
      {/* row titles */}
      <text x="2" y={g.r1 - 24} class="rt">{T.scc}<tspan class="rs" dx="8">{T.sccS}</tspan></text>
      <text x="2" y={g.r2 - 22} class="rt">{T.ia}<tspan class="rs" dx="8">{g.narrow ? '' : T.iaS}</tspan></text>
      {g.narrow && <text x="2" y={g.r2 + 22} class="rs">{T.iaS}</text>}
      <line x1="0" x2={g.W} y1={g.pBot + 28} y2={g.pBot + 28} class="sep" />
    </svg>
  ))}
</div>

<style>
  .overage { display: grid; }
  .narrow { display: none; }
  @media (max-width: 40rem) { .wide { display: none; } .narrow { display: block; } }
  .ax { stroke: var(--ink-3); }
  .sep { stroke: var(--line); stroke-dasharray: 2 4; }
  .overz { fill: color-mix(in oklab, #1e6fd6 7%, transparent); }
  .lab { font-family: var(--font-mono); font-size: 11.5px; fill: var(--ink-2); }
  .mut { fill: var(--ink-3); }
  .dat { fill: #2a78d6; }
  .glow { fill: none; stroke: #1b1d1e; stroke-width: 7; stroke-opacity: 0.08; stroke-linejoin: round; }
  .curve { fill: none; stroke: #1b1d1e; stroke-width: 2.2; stroke-linejoin: round; }
  .guide { stroke: var(--ink-3); stroke-opacity: 0.6; stroke-dasharray: 2 3; }
  .mk { fill: #1e6fd6; stroke: #f7fbfe; stroke-width: 2; }
  .mk.pk { fill: #e2601a; }
  .tag { fill: color-mix(in oklab, #1e6fd6 25%, #f9fbfe); stroke: #1e6fd6; }
  .tag.pk { fill: color-mix(in oklab, #d4520f 25%, #f9fbfe); stroke: #d4520f; }
  .tagt { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; fill: var(--ink); }
  .rm { font-family: var(--font-mono); font-size: 12px; font-weight: 500; fill: var(--ink); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; }
  .mut2 { fill: var(--ink-3); font-weight: 400; font-size: 11px; }
  .pip { fill: none; stroke: #a5aeb6; stroke-width: 1.2; }
  .pip.on { fill: #1e6fd6; stroke: #1e6fd6; }
  .rv { font-family: var(--font-mono); font-size: 11.5px; fill: var(--ink-2); }
  .rv.iacs { fill: var(--ink); font-size: 12.5px; }
  .rt { font-size: 12.5px; font-weight: 500; fill: var(--ink); }
  .rs { font-size: 11px; fill: var(--ink-3); }
</style>
