---
/**
 * The six groups of turning in DIN 8589-1, each as a small side-view sketch: the surface the group
 * makes (orange), the tool and its feed. Names and one-line texts come from the article through
 * `groups` (same order as the sketches). On entering the view the tools move along their feeds.
 */
interface G { de: string; name: string; text: string }
interface Props { groups: G[]; aria: string }
const { groups, aria } = Astro.props;
const keys = ['plan', 'rund', 'schraub', 'waelz', 'profil', 'form'] as const;
const ay = 70;                                               // axis in each sketch
// thread teeth for the screw sketch
// 60° V-grooves, 6 deep, with short flat crests; the tool's 60° point sits in the fifth root
const tw = 6 * Math.tan(Math.PI / 6);
const teeth = Array.from({ length: 9 }, (_, i) => { const x = 54 + i * 9 + 1.03; return `L${x.toFixed(2)},${ay - 28} L${(x + tw).toFixed(2)},${ay - 22} L${(x + 2 * tw).toFixed(2)},${ay - 28}`; }).join(' ');
// gear-like generated profile for the rolling sketch
const gear = Array.from({ length: 7 }, (_, i) => { const x = 44 + i * 13; return `L${x + 3},${ay - 28} L${x + 5},${ay - 20} L${x + 8},${ay - 20} L${x + 10},${ay - 28}`; }).join(' ');
// ball end for the form sketch
const ball = Array.from({ length: 13 }, (_, i) => { const t = (i / 12) * (Math.PI / 2); return `L${(96 + 26 * Math.sin(t)).toFixed(1)},${(ay - 26 * Math.cos(t)).toFixed(1)}`; }).join(' ');
---
<div class="dg" data-anim role="group" aria-label={aria}>
  {keys.map((k, i) => {
    const g = groups[i];
    return (
      <div class="card" style={`--i:${i}`}>
        <svg viewBox="0 0 160 80" aria-hidden="true">
          <line x1="6" x2="154" y1={ay} y2={ay} class="axis" />
          {k === 'plan' && <g>
            <path d={`M10,${ay - 30} H110 V${ay} H10 Z`} class="work" />
            <line x1="110" x2="110" y1={ay - 30} y2={ay} class="surf" />
            <g class="tool"><path d={`M110,${ay - 14} l12,-8 h26 v-10 h-38 Z`} class="ins" /></g>
            <line x1="140" x2="140" y1={ay - 40} y2={ay - 6} class="mv" marker-end="url(#ca-arr-data)" />
          </g>}
          {k === 'rund' && <g>
            <path d={`M10,${ay - 30} H70 V${ay - 22} H150 V${ay} H10 Z`} class="work" />
            <line x1="70" x2="150" y1={ay - 22} y2={ay - 22} class="surf" />
            <g class="tool"><path d={`M70,${ay - 22} l8,-16 h26 v-14 h-30 Z`} class="ins" /></g>
            <line x1="132" x2="88" y1={ay - 64 + 26} y2={ay - 64 + 26} class="mv" marker-end="url(#ca-arr-data)" />
          </g>}
          {k === 'schraub' && <g>
            <path d={`M10,${ay - 28} H54 ${teeth} L140,${ay - 28} V${ay} H10 Z`} class="work" />
            <path d={`M54,${ay - 28} ${teeth}`} class="surf thin" />
            <g class="tool"><path d={`M${(54 + 4 * 9 + 1.03 + tw).toFixed(2)},${ay - 22} l${(-8 * Math.tan(Math.PI / 6)).toFixed(2)},-8 v-20 h${(16 * Math.tan(Math.PI / 6)).toFixed(2)} v20 Z`} class="ins" /></g>
            <line x1="132" x2="106" y1={ay - 54} y2={ay - 54} class="mv" marker-end="url(#ca-arr-data)" />
            <text x="132" y={ay - 58} text-anchor="end" class="t">P</text>
          </g>}
          {k === 'waelz' && <g>
            <path d={`M10,${ay - 28} H44 ${gear} L140,${ay - 28} V${ay} H10 Z`} class="work" />
            <path d={`M44,${ay - 28} ${gear}`} class="surf thin" />
            <g class="tool"><circle cx="96" cy={ay - 42} r="14" class="ins" /><path d={`M96,${ay - 56} v28 M82,${ay - 42} h28`} class="spoke" /></g>
            <path d={`M79.5,${ay - 51.5} A19,19 0 0,1 112.5,${ay - 51.5}`} class="mv" marker-end="url(#ca-arr-data)" />
          </g>}
          {k === 'profil' && <g>
            <path d={`M10,${ay - 30} H58 C66,${ay - 30} 70,${ay - 16} 80,${ay - 16} C90,${ay - 16} 94,${ay - 30} 102,${ay - 30} H150 V${ay} H10 Z`} class="work" />
            <path d={`M58,${ay - 30} C66,${ay - 30} 70,${ay - 16} 80,${ay - 16} C90,${ay - 16} 94,${ay - 30} 102,${ay - 30}`} class="surf" />
            <g class="tool"><path d={`M58,${ay - 31} C66,${ay - 31} 70,${ay - 17} 80,${ay - 17} C90,${ay - 17} 94,${ay - 31} 102,${ay - 31} V${ay - 52} H58 Z`} class="ins" /></g>
            <line x1="114" x2="114" y1={ay - 56} y2={ay - 24} class="mv" marker-end="url(#ca-arr-data)" />
          </g>}
          {k === 'form' && <g>
            <path d={`M10,${ay - 26} H96 ${ball} L122,${ay} H10 Z`} class="work" />
            <path d={`M70,${ay - 26} H96 ${ball}`} class="surf" />
            <path d={`M66,${ay - 34} H96 ${Array.from({ length: 13 }, (_, j) => { const t = (j / 12) * (Math.PI / 2); return `L${(96 + 34 * Math.sin(t)).toFixed(1)},${(ay - 34 * Math.cos(t)).toFixed(1)}`; }).join(' ')}`} class="mv path" marker-end="url(#ca-arr-data)" />
            <g class="tool"><path d={`M${(96 + 26 * Math.sin(0.6)).toFixed(1)},${(ay - 26 * Math.cos(0.6)).toFixed(1)} l6,-18 l10,6 Z`} class="ins" /></g>
          </g>}
        </svg>
        <p class="de">{g.de}</p>
        <p class="nm">{g.name}</p>
        <p class="tx">{g.text}</p>
      </div>
    );
  })}
</div>

<style>
  .dg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }
  @media (max-width: 40rem) { .dg { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .card { background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; padding: 0.45rem 0.6rem 0.7rem; display: grid; gap: 0.15rem; align-content: start; }
  svg { width: 100%; height: auto; display: block; margin-bottom: 0.2rem; }
  .axis { stroke: #656e74; stroke-width: 0.8; stroke-dasharray: 10 3 2 3; }
  .work { fill: url(#ca-metal); stroke: #2c3033; stroke-width: 0.9; stroke-linejoin: round; }
  .surf { fill: none; stroke: #e2601a; stroke-width: 2.6; stroke-linejoin: round; stroke-linecap: round; }
  .surf.thin { stroke-width: 1.8; }
  .ins { fill: #e0e8ed; stroke: #1b1d1e; stroke-width: 1; stroke-linejoin: round; }
  .spoke { stroke: #656e74; stroke-width: 1; }
  .mv { fill: none; stroke: #1e6fd6; stroke-width: 1.6; }
  .mv.path { stroke-dasharray: 3 3; }
  .t { font: 600 10px var(--font-mono); fill: #2a78d6; }
  .de { margin: 0; font: 500 0.78rem var(--font-mono); color: var(--color-spark-400); }
  .nm { margin: 0; font-weight: 600; font-size: 0.9rem; color: var(--ink); line-height: 1.25; }
  .tx { margin: 0; font-size: 0.8rem; color: var(--ink-3); line-height: 1.4; }
  @keyframes dg-feed { from { transform: translate(var(--fx, 0px), var(--fy, 0px)); opacity: 0; } 30% { opacity: 1; } }
  .card:nth-child(1) .tool { --fy: -16px; }
  .card:nth-child(2) .tool { --fx: 34px; }
  .card:nth-child(3) .tool { --fx: 26px; }
  .card:nth-child(4) .tool { --fx: 22px; }
  .card:nth-child(5) .tool { --fy: -14px; }
  .card:nth-child(6) .tool { --fx: -18px; --fy: -10px; }
  :global(html.anim) .dg[data-anim]:not([data-in]) .card { opacity: 0; }
  :global(html.anim) .dg[data-anim][data-in] .card { animation: ca-rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; animation-delay: calc(var(--i) * 90ms); }
  :global(html.anim) .dg[data-anim][data-in] .tool { animation: dg-feed 1.1s cubic-bezier(0.3, 0.7, 0.2, 1) backwards; animation-delay: calc(0.35s + var(--i) * 90ms); }
</style>
