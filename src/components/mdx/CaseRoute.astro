---
/**
 * The route of a case-hardened 16MnCr5 part, from the article: machined soft in the delivery
 * condition, carburized, hardened, tempered, finished hard. Temperatures and hardness values are
 * the article's (EN ISO 683-3 based maker sheets; see the table on the page).
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const heat = (t: number) => (t >= 850 ? '#e2601a' : t >= 700 ? '#c16200' : t >= 100 ? '#c98a0a' : '#2a78d6');
const S = tr
  ? [
      { t: 'Teslim durumu', d: ['+A en çok 207 HB', '+FP 140–187 HB', '+N 138–187 HB'], tag: '', icon: 'bar' },
      { t: 'Talaşlı işleme', d: ['yumuşak durumda', 'ISO 513 grubu P', 'işlenebilirlik için 16MnCrS5'], tag: '', icon: 'turn' },
      { t: 'Karbürleme', d: ['yüzey tabakasına karbon'], tag: '880–980 °C', T: 930, icon: 'carb' },
      { t: 'Sertleştirme', d: ['çekirdek sertleştirme 860–900 °C', 'kabuk sertleştirme 780–820 °C', 'yağ ya da polimer'], tag: '780–900 °C', T: 820, icon: 'quench' },
      { t: 'Menevişleme', d: ['yüzey yaklaşık 57–64 HRC', '(Lucefin)'], tag: '150–200 °C', T: 175, icon: 'temper' },
      { t: 'Son işlem', d: ['taşlama ya da sert tornalama', 'ISO 513 grubu H'], tag: '', icon: 'grind' },
    ]
  : [
      { t: 'Delivery condition', d: ['+A max 207 HB', '+FP 140–187 HB', '+N 138–187 HB'], tag: '', icon: 'bar' },
      { t: 'Machining', d: ['in the soft condition', 'ISO 513 group P', '16MnCrS5 for machinability'], tag: '', icon: 'turn' },
      { t: 'Carburizing', d: ['carbon into the surface layer'], tag: '880–980 °C', T: 930, icon: 'carb' },
      { t: 'Hardening', d: ['core 860–900 °C', 'case 780–820 °C', 'oil or polymer'], tag: '780–900 °C', T: 820, icon: 'quench' },
      { t: 'Tempering', d: ['surface about 57–64 HRC', '(Lucefin)'], tag: '150–200 °C', T: 175, icon: 'temper' },
      { t: 'Finishing', d: ['grinding or hard turning', 'ISO 513 group H'], tag: '', icon: 'grind' },
    ];
---
<ol class="route" aria-label={tr ? '16MnCr5 parçanın yolu' : 'Route of a 16MnCr5 part'}>
  {S.map((s, i) => (
    <li style={s.T ? `--h:${heat(s.T)}` : ''} class:list={{ hot: !!s.T }}>
      <div class="hd"><span class="n">{i + 1}</span><span class="t">{s.t}</span></div>
      <svg viewBox="0 0 64 44" class="ic" aria-hidden="true">
        {s.icon === 'bar' && <>
          <rect x="6" y="14" width="46" height="16" rx="2" fill="url(#ca-metal)" stroke="#2c3033" stroke-width="1" />
          <ellipse cx="52" cy="22" rx="4" ry="8" fill="#8d959d" stroke="#2c3033" stroke-width="1" />
        </>}
        {s.icon === 'turn' && <>
          <rect x="4" y="16" width="38" height="14" rx="1.5" fill="url(#ca-metal)" stroke="#2c3033" stroke-width="1" />
          <path d="M42,23 L48,16 L60,16 L60,30 L48,30 Z" fill="url(#ca-carbide)" stroke="#1b1d1e" stroke-width="1" />
          <path d="M40,15 C36,8 44,4 47,9" fill="none" stroke="url(#ca-chip)" stroke-width="3" stroke-linecap="round" />
        </>}
        {s.icon === 'carb' && <>
          <rect x="10" y="14" width="44" height="16" rx="2" fill="url(#ca-metal)" stroke="#2c3033" stroke-width="1" />
          <rect x="10" y="14" width="44" height="3.2" fill="#e2601a" opacity="0.65" /><rect x="10" y="26.8" width="44" height="3.2" fill="#e2601a" opacity="0.65" />
          {[14, 22, 30, 38, 46].map((x, k) => <><circle cx={x} cy={k % 2 ? 8 : 6} r="1.8" class="c" /><circle cx={x + 3} cy={k % 2 ? 36 : 38} r="1.8" class="c" /></>)}
        </>}
        {s.icon === 'quench' && <>
          <rect x="18" y="6" width="28" height="12" rx="1.5" fill="url(#ca-metal)" stroke="#2c3033" stroke-width="1" />
          <path d="M6,26 q6,-4 12,0 t12,0 t12,0 t12,0 t6,0" fill="none" stroke="#1e6fd6" stroke-width="1.6" />
          <path d="M6,33 q6,-4 12,0 t12,0 t12,0 t12,0 t6,0" fill="none" stroke="#1e6fd6" stroke-width="1.2" opacity="0.6" />
          <line x1="32" y1="18" x2="32" y2="24" stroke="#1b1d1e" stroke-width="1.2" marker-end="url(#ca-arr-ink)" />
        </>}
        {s.icon === 'temper' && <>
          <circle cx="22" cy="22" r="14" fill="#e0e8ed" stroke="#2c3033" stroke-width="1" />
          <circle cx="22" cy="22" r="9" fill="url(#ca-metal)" />
          <circle cx="22" cy="22" r="14" fill="none" stroke="#e2601a" stroke-width="3" opacity="0.9" />
          <path d="M44,34 L44,10 M44,34 a4,4 0 1,0 0.1,0" fill="none" stroke="#c98a0a" stroke-width="2" stroke-linecap="round" />
        </>}
        {s.icon === 'grind' && <>
          <circle cx="24" cy="16" r="12" fill="#8b7a60" stroke="#2c3033" stroke-width="1" />
          <circle cx="24" cy="16" r="3" fill="#e0e8ed" />
          <rect x="6" y="30" width="52" height="9" rx="1.5" fill="url(#ca-metal)" stroke="#2c3033" stroke-width="1" />
          <path d="M36,26 l6,-3 M37,29 l8,-1 M35,23 l5,-5" stroke="#e2601a" stroke-width="1" />
        </>}
      </svg>
      <ul class="dl">{s.d.map((x) => <li>{x}</li>)}</ul>
      {s.tag && <p class="tag">{s.tag}</p>}
    </li>
  ))}
</ol>

<style>
  .route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; counter-reset: none; }
  @media (max-width: 44rem) { .route { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .route > li { position: relative; margin: 0; padding: 0.7rem 0.8rem 0.75rem; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; display: grid; gap: 0.45rem; align-content: start; }
  .route > li::before { content: none; }
  .route > li.hot { border-color: color-mix(in oklab, var(--h) 40%, var(--line)); background: linear-gradient(180deg, color-mix(in oklab, var(--h) 7%, var(--bg-sunk)), var(--bg-sunk) 60%); }
  .hd { display: flex; align-items: center; gap: 0.5rem; }
  .n { width: 1.35rem; height: 1.35rem; border-radius: 50%; border: 1.4px solid var(--color-spark-400); color: var(--color-spark-400); font: 600 0.72rem/1.15rem var(--font-mono); text-align: center; flex: none; }
  .t { font-size: 0.9rem; font-weight: 600; color: var(--ink); }
  .route .ic { width: 4.6rem; height: auto; }
  .c { fill: #1b1d1e; opacity: 0.85; }
  .dl { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
  .dl li { margin: 0; font-size: 0.8rem; color: var(--ink-2); line-height: 1.35; }
  .dl li::before { content: none; }
  .tag { margin: 0; justify-self: start; font-family: var(--font-mono); font-size: 0.78rem; padding: 0.15rem 0.5rem; border-radius: 999px; color: #fbfdff; background: var(--h); }
</style>
