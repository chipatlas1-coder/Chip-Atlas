---
/**
 * Four tap types in section, each turning in its hole while the figure is in view:
 * - spiral point in a through hole: straight flutes whose cutting faces are ground at an angle near
 *   the tip (a left-hand grind on a right-hand tap), so the chips are pushed ahead and out of the far end;
 * - right-hand spiral flute in a blind hole: the helical flutes carry the chips back up to the opening;
 * - straight flute in a blind hole: short chips stay in the flutes;
 * - forming tap: no flutes and no chips; lobes press the material into the thread.
 * Geometry: a right-hand thread seen from the front rises to the right; turning clockwise seen from
 * above (cutting), a point on the front moves left, so straight flutes slide left and right-hand
 * helical flutes move up. The thread lines stay still, as they do relative to the work while the tap
 * advances one pitch per turn. Rotation is SMIL (started on entry), chip flow is CSS. Texts come from
 * the article through `types`, in panel order.
 */
interface T { name: string; hole: string; chips: string }
interface Props { types: T[]; aria: string }
const { types, aria } = Astro.props;
type K = 'point' | 'spiral' | 'straight' | 'form';
const keys: K[] = ['point', 'spiral', 'straight', 'form'];
const W = 180, H = 262, ax = 90, R = 26, p = 10;
const r = R - 0.6 * p;                      // minor radius of the tap (schematic depth)
const rs = 15.5, yThr = 50;                 // shank radius; first thread
const top = 90, botT = 250;                 // work top; bottom of the through-hole block
const DEG = Math.PI / 180;
const f = (n: number) => n.toFixed(2).replace(/\.?0+$/, '');
const cfg: Record<K, { yTip: number; cham: number; yB?: number; rh: number }> = {
  point: { yTip: 188, cham: 4.5, rh: R - 0.5 * p + 0.4 },
  spiral: { yTip: 194, cham: 2.5, yB: 218, rh: R - 0.5 * p + 0.4 },
  straight: { yTip: 194, cham: 2.5, yB: 218, rh: R - 0.5 * p + 0.4 },
  form: { yTip: 194, cham: 3, yB: 218, rh: R - 0.225 * p },   // forming: core hole ≈ d − 0.45 P
};
// thread silhouette radius at height y (trapezoid profile: crest p/8, root p/4, 60° flanks)
const prof = (y: number, phase: number) => {
  const u = ((((y - yThr) / p + phase) % 1) + 1) % 1;
  const c = 1 / 16, fl = (1 - 1 / 8 - 1 / 4) / 2;
  if (u < c || u > 1 - c) return R;
  if (u < c + fl) return R - ((u - c) / fl) * (R - r);
  if (u < c + fl + 1 / 4) return r;
  return r + ((u - c - fl - 1 / 4) / fl) * (R - r);
};
const r0 = r - 1.6;                                                // chamfer starts just below the minor Ø
const rad = (k: K, y: number, phase: number) => {
  const { yTip, cham } = cfg[k], yc = yTip - cham * p;
  let v = Math.min(prof(y, phase), r + ((R - r) * (y - yThr)) / (1.4 * p));   // thread runs out at the neck
  if (y > yc) v = Math.min(v, R - ((R - r0) * (y - yc)) / (yTip - yc));
  return Math.max(v, r0 - 0.01);
};
// drop points on straight runs so the paths stay small
const simplify = (q: [number, number][]) => q.filter((pt, i) => {
  if (i === 0 || i === q.length - 1) return true;
  const [a, b] = [q[i - 1], q[i + 1]];
  return Math.abs((pt[0] - a[0]) * (b[1] - a[1]) - (pt[1] - a[1]) * (b[0] - a[0])) > 0.02;
});
const L = (q: [number, number][]) => q.map(([x, y]) => `${f(x)},${f(y)}`).join(' L');
const side = (k: K, s: number) => {
  const q: [number, number][] = [];
  for (let y = yThr; y <= cfg[k].yTip + 1e-6; y += 0.25) q.push([ax + s * rad(k, y, s < 0 ? 0 : 0.5), y]);
  return simplify(q);
};
const body = (k: K) => {
  const { yTip } = cfg[k];
  const l = side(k, -1), rr = side(k, 1);
  return `M${f(ax - r)},${yThr - 8} L${L(l)} L${f(ax - r0 + 1.4)},${yTip + 1.4} L${f(ax + r0 - 1.4)},${yTip + 1.4} L${L([...rr].reverse())} L${f(ax + r)},${yThr - 8} Z`;
};
const bodyEdge = (k: K) => {
  const { yTip } = cfg[k];
  const l = side(k, -1), rr = side(k, 1);
  return `M${f(ax - r)},${yThr - 8} L${L(l)} L${f(ax - r0 + 1.4)},${yTip + 1.4} L${f(ax + r0 - 1.4)},${yTip + 1.4} L${L([...rr].reverse())} L${f(ax + r)},${yThr - 8}`;
};
const shank = `M${ax - rs},-4 L${ax - rs},${yThr - 12} L${f(ax - r)},${yThr - 6} L${f(ax + r)},${yThr - 6} L${ax + rs},${yThr - 12} L${ax + rs},-4 Z`;
// the work in section. Cutting: the wall follows the tap, but the crests of the nut thread stop at
// the drilled hole (rh). Forming: the larger hole is pressed outward into the tap's roots and the
// material flows inward into its crests, nearly to the tap's root (the formed crests); in the chamfer
// zone this is still under way. `flowed` is the material that has moved inside the drilled hole.
const formCrest = r + 1.6;
const wallR = (k: K, y: number, phase: number) => {
  const { yTip, cham, rh } = cfg[k], t = rad(k, y, phase) + 0.9;
  if (k !== 'form') return Math.max(rh, t);
  const yc = yTip - cham * p, prog = y <= yc ? 1 : Math.max(0, (yTip - y) / (yTip - yc));
  return Math.max(t, rh - (rh - formCrest) * prog);
};
const wallSide = (k: K, s: number) => {
  const q: [number, number][] = [];
  for (let y = top; y <= cfg[k].yTip + 1e-6; y += 0.25) q.push([ax + s * wallR(k, y, s < 0 ? 0 : 0.5), y]);
  return simplify(q);
};
const work = (k: K) => {
  const { yB, rh } = cfg[k];
  const lw = wallSide(k, -1), rw = wallSide(k, 1);
  if (yB) {
    const tipY = yB + rh * 0.6;                                     // 118° drill point
    return `M8,${top} L${L(lw)} L${f(ax - rh)},${yB} L${ax},${f(tipY)} L${f(ax + rh)},${yB} L${L([...rw].reverse())} L${W - 8},${top} L${W - 8},${botT} L8,${botT} Z`;
  }
  return `M8,${top} L${L(lw)} L${f(ax - rh)},${botT} L8,${botT} Z M${W - 8},${top} L${L(rw)} L${f(ax + rh)},${botT} L${W - 8},${botT} Z`;
};
const flowed = (k: K) => {
  const { rh, yTip } = cfg[k];
  return [-1, 1].map((s) => {
    const q = wallSide(k, s).map(([x, y]) => [ax + s * Math.min(Math.abs(x - ax), rh), y] as [number, number]);
    return `M${f(ax + s * rh)},${top} L${L(q)} L${f(ax + s * rh)},${yTip} Z`;
  }).join(' ');
};
// thread lines across the front: crests light, roots dark; right-hand, so they rise to the right
const threadLines = (k: K) => {
  const yc = cfg[k].yTip - cfg[k].cham * p;
  const crest: string[] = [], root: string[] = [];
  for (let yL = yThr + p; yL <= yc - 0.5 * p; yL += p) {
    const c: [number, number][] = [], d: [number, number][] = [];
    for (let a = -180; a <= 0; a += 12) {
      c.push([ax + R * Math.cos(a * DEG), yL - ((a + 180) / 360) * p]);
      d.push([ax + r * Math.cos(a * DEG), yL + p / 2 - ((a + 180) / 360) * p]);
    }
    crest.push(`M${L(c)}`); root.push(`M${L(d)}`);
  }
  return { crest: crest.join(''), root: root.join('') };
};
// flutes seen from the front. Angles: 0° right edge, −90° front, −180° left edge (counter-clockwise
// from above is positive). Straight bands: x from the projected edges; drawn at FR frames per flute
// pitch so SMIL can turn them (values of the same shape, clamped at the edges when out of sight).
const NF = 3, FW = 48, FR = 16, A0 = -100;                         // A0: a flute just left of the front at rest
const wrap = (a: number) => (((a + 270) % 360) + 360) % 360 - 270;   // into [−270, 90): the back is −270 / 90
const xAt = (a: number) => ax + R * Math.cos(Math.min(0, Math.max(-180, a)) * DEG);   // a relative to a wrapped centre
const xEdge = (a: number) => (a > 0 ? ax + R + 6 : a < -180 ? ax - R - 6 : xAt(a));      // an edge out of sight leaves the clip
const yG = (k: K) => cfg[k].yTip - 3.2 * p, dA = 34;               // gun-nose grind: left-hand, so the band runs right toward the tip
const straightBands = (k: K, rot: number, y0: number, yEnd: number) => {
  const out: string[] = [];
  for (let i = 0; i < NF; i++) {
    const c = wrap(A0 + rot - i * (360 / NF));
    const a1 = c - FW / 2, a2 = c + FW / 2;
    if (k !== 'point') out.push(`M${f(xAt(a1))},${y0} L${f(xAt(a2))},${y0} L${f(xAt(a2))},${yEnd} L${f(xAt(a1))},${yEnd} Z`);
    else out.push(`M${f(xAt(a1))},${y0} L${f(xAt(a2))},${y0} L${f(xAt(a2))},${yG(k)} L${f(xAt(a2 + dA))},${yEnd} L${f(xAt(a1 + dA))},${yEnd} L${f(xAt(a1))},${yG(k)} Z`);
  }
  return out.join(' ');
};
// the cutting edge sits on the right wall of each flute (the land in front of it moves left)
const edgeLines = (k: K, rot: number, y0: number, yEnd: number) => {
  const out: string[] = [];
  for (let i = 0; i < NF; i++) {
    const a2 = wrap(A0 + rot - i * (360 / NF)) + FW / 2;
    out.push(k === 'point' ? `M${f(xEdge(a2))},${y0} L${f(xEdge(a2))},${yG(k)} L${f(xEdge(a2 + dA))},${yEnd}` : `M${f(xEdge(a2))},${y0} L${f(xEdge(a2))},${yEnd}`);
  }
  return out.join(' ');
};
const frames = (fn: (rot: number) => string, period = 360 / NF) => Array.from({ length: FR + 1 }, (_, j) => fn(-(j * period) / FR)).join(';');
// short chips (straight flute): a few fragments ride in each flute and turn with it
const frag = ['M0,0 L3.4,-1.2 L4.6,1.6 L1.2,2.8 Z', 'M0,0 L2.8,-2 L4.2,0.8 L0.8,2.2 Z', 'M0,0 L3.6,0.4 L2,3 Z', 'M0,0 L2.6,-1.6 L3.8,1.2 Z', 'M0,0 L3,0.8 L1.4,2.8 L-0.6,1.4 Z'];
const fragAt = [[-3.5, -10], [1.5, -15], [-1.5, -21], [2.5, -27], [-2.5, -33]];
const vis = (c: number) => Math.min(1, Math.max(0, (-c - 18) / 22)) * Math.min(1, Math.max(0, (c + 162) / 22));
const fluteX = (rot: number, i: number) => { const c = wrap(A0 + rot - i * (360 / NF)); return 0.86 * R * Math.cos(Math.min(0, Math.max(-180, c)) * DEG); };
const fluteO = (rot: number, i: number) => vis(wrap(A0 + rot - i * (360 / NF)));
// right-hand helical flutes, helix angle 40°: lead 2πR/tan 40°; turning = moving up by lead/NF
const lead = (2 * Math.PI * R) / Math.tan(40 * DEG), per = lead / NF;
const hh = ((FW / 360) * lead) / 2;
const helixBands = (yTip: number) => {
  const out: string[] = [];
  for (let Y = yTip + 2 * per; Y > yThr - 3 * per; Y -= per) {
    const up: [number, number][] = [], dn: [number, number][] = [];
    for (let a = -180; a <= 0; a += 6) {
      const x = ax + R * Math.cos(a * DEG), y = Y - ((a + 90) / 360) * lead;   // rises to the right
      up.push([x, y - hh]); dn.push([x, y + hh]);
    }
    out.push(`M${L(up)} L${L(dn.reverse())} Z`);
  }
  return out.join(' ');
};
const helixEdges = (yTip: number) => {
  const out: string[] = [];
  for (let Y = yTip + 2 * per; Y > yThr - 3 * per; Y -= per) {
    const q: [number, number][] = [];
    for (let a = -180; a <= 0; a += 6) q.push([ax + R * Math.cos(a * DEG), Y - ((a + 90) / 360) * lead + hh]);
    out.push(`M${L(q)}`);
  }
  return out.join(' ');
};
// forming tap: no flutes; four lobes (light) with relieved flats between (dark), turning
const facets = (rot: number, y0: number, yEnd: number, w: number, off: number) => Array.from({ length: 4 }, (_, i) => {
  const c = wrap(A0 + rot - i * 90 + off);
  return `M${f(xAt(c - w / 2))},${y0} L${f(xAt(c + w / 2))},${y0} L${f(xAt(c + w / 2))},${yEnd} L${f(xAt(c - w / 2))},${yEnd} Z`;
}).join(' ');
const DUR = 1.5;                                                    // seconds per flute pitch (per lobe for the former)
// a curled chip: a tapering spiral around the origin
const curl = (() => {
  const o: [number, number][] = [], n: [number, number][] = [];
  for (let j = 0; j <= 16; j++) {
    const t = j / 16, a = (200 - 300 * t) * DEG, rr = 6.4 - 3.2 * t, w = 3 * (1 - t) + 0.5;
    o.push([(rr + w / 2) * Math.cos(a), (rr + w / 2) * Math.sin(a)]);
    n.push([(rr - w / 2) * Math.cos(a), (rr - w / 2) * Math.sin(a)]);
  }
  return `M${L(o)} L${L(n.reverse())} Z`;
})();
// chip runs: keyframe stops (t 0..1); static positions sit on the same path
type Stop = [number, number, number, number];                      // t, x, y, rotation
const at = (run: Stop[], k: number) => {
  let i = 0; while (i < run.length - 2 && k > run[i + 1][0]) i++;
  const [t0, x0, y0, a0] = run[i], [t1, x1, y1, a1] = run[i + 1], u = (k - t0) / (t1 - t0);
  return `translate(${f(x0 + u * (x1 - x0))}px, ${f(y0 + u * (y1 - y0))}px) rotate(${f(a0 + u * (a1 - a0))}deg)`;
};
const vars = (run: Stop[]) => run.map(([, x, y, a], j) => `--x${j}:${f(x)}px; --y${j}:${f(y)}px; --a${j}:${f(a)}deg`).join('; ');
const upRun: Stop[] = [[0, ax, cfg.spiral.yTip, 0], [0.832, ax, top - 4, -220], [1, ax + 44, top - 26, -330]];
const upDur = 2 * DUR;                                              // two chips, one flute pitch apart: each rides a flute
const downRun: Stop[] = [[0, ax - 2, cfg.point.yTip + 8, 0], [0.45, ax + 5, cfg.point.yTip + 32, 135], [1, ax - 4, botT + 18, 300]];
---
<div class="tt" data-anim data-tt role="group" aria-label={aria}>
  {keys.map((k, i) => {
    const c = cfg[k];
    const t = types[i];
    const id = `tt-${k}`;
    const yEnd = c.yTip + 2, y0 = yThr - 10;
    const th = threadLines(k);
    return (
      <figure class="panel" style={`--i:${i}`}>
        <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
          <defs>
            <clipPath id={`${id}-clip`}><path d={body(k)} /></clipPath>
            <linearGradient id={`${id}-sh`} gradientUnits="userSpaceOnUse" x1={ax - R} x2={ax + R} y1="0" y2="0">
              <stop offset="0" stop-color="#000" stop-opacity="0.55" /><stop offset="0.22" stop-color="#000" stop-opacity="0" />
              <stop offset="0.7" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity="0.6" />
            </linearGradient>
            <linearGradient id={`${id}-fade`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="0.12" stop-color="#fff" /></linearGradient>
            <mask id={`${id}-m`} maskUnits="userSpaceOnUse" x="0" y="-4" width={W} height={H}><rect x="0" y="-4" width={W} height={yThr + 30} fill={`url(#${id}-fade)`} /><rect x="0" y={yThr + 26} width={W} height={H} fill="#fff" /></mask>
            {k === 'form' && <marker id="tt-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#1e6fd6" /></marker>}
          </defs>
          <path d={work(k)} class="work" />
          {k === 'form' && <path d={flowed(k)} class="flowed" />}
          {c.yB && <path d={`M${f(ax - c.rh)},${c.yB} L${ax},${f(c.yB + c.rh * 0.6)} L${f(ax + c.rh)},${c.yB}`} class="hole-edge" />}
          <line x1={ax} x2={ax} y1="2" y2={botT + 8} class="axis" />
          <g mask={`url(#${id}-m)`}>
            <path d={shank} class="shank" />
            <path d={body(k)} class="tap" />
            <g clip-path={`url(#${id}-clip)`}>
              <path d={th.root} class="th-root" />
              <path d={th.crest} class="th-crest" />
              {(k === 'point' || k === 'straight') && (
                <g>
                  <path d={straightBands(k, 0, y0, yEnd)} class="flute">
                    <animate attributeName="d" dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" values={frames((rot) => straightBands(k, rot, y0, yEnd))} />
                  </path>
                  <path d={edgeLines(k, 0, y0, yEnd)} class="cut-edge">
                    <animate attributeName="d" dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" values={frames((rot) => edgeLines(k, rot, y0, yEnd))} />
                  </path>
                </g>
              )}
              {k === 'spiral' && (
                <g>
                  <path d={helixBands(c.yTip)} class="flute"><animateTransform attributeName="transform" type="translate" from="0 0" to={`0 ${f(-per)}`} dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" /></path>
                  <path d={helixEdges(c.yTip)} class="cut-edge"><animateTransform attributeName="transform" type="translate" from="0 0" to={`0 ${f(-per)}`} dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" /></path>
                </g>
              )}
              {k === 'form' && (
                <g>
                  <path d={facets(0, y0, yEnd, 40, 45)} class="relief"><animate attributeName="d" dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" values={frames((rot) => facets(rot, y0, yEnd, 40, 45), 90)} /></path>
                  <path d={facets(0, y0, yEnd, 22, 0)} class="lobe"><animate attributeName="d" dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" values={frames((rot) => facets(rot, y0, yEnd, 22, 0), 90)} /></path>
                </g>
              )}
              <rect x={ax - R} y="-4" width={2 * R} height={H} fill={`url(#${id}-sh)`} />
              <rect x={ax - R * 0.62} y="-4" width={R * 0.3} height={H} class="spec" />
              {k === 'straight' && Array.from({ length: NF }, (_, fi) => (
                <g transform={`translate(${f(fluteX(0, fi))} 0)`} opacity={f(fluteO(0, fi))}>
                  <animateTransform attributeName="transform" type="translate" dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" values={Array.from({ length: FR + 1 }, (_, j) => `${f(fluteX(-(j * 120) / FR, fi))} 0`).join(';')} />
                  <animate attributeName="opacity" dur={`${DUR}s`} repeatCount="indefinite" begin="indefinite" values={Array.from({ length: FR + 1 }, (_, j) => f(fluteO(-(j * 120) / FR, fi))).join(';')} />
                  {fragAt.map(([dx, dy], j) => <path d={frag[j]} class="frag" transform={`translate(${f(ax + dx)} ${f(c.yTip + dy)}) rotate(${j * 67})`} />)}
                </g>
              ))}
            </g>
            <path d={bodyEdge(k)} class="tap-edge" />
            <path d={shank} class="tap-edge" />
          </g>
          {k === 'point' && Array.from({ length: 4 }, (_, j) => (
            <g class="chip run down" style={`--k:${j / 4}; --dur:2.4s; --static:${at(downRun, j / 4 + 0.12)}; ${vars(downRun)}`}><path d={curl} /></g>
          ))}
          {k === 'spiral' && [0, 1].map((j) => (
            <g class="chip run up" style={`--k:${j / 2}; --dur:${upDur}s; --static:${at(upRun, j ? 0.9 : 0.5)}; ${vars(upRun)}`}><path d={curl} /></g>
          ))}
          {k === 'straight' && [[-9, 0, 30], [-2, 3, 140], [6, 1, 250], [11, -1, 80]].map(([dx, dy, rot], j) => (
            <path d={frag[j]} class="frag" transform={`translate(${f(ax + dx)} ${f((c.yB ?? 0) + 5 + dy)}) rotate(${rot})`} />
          ))}
          {k === 'form' && [-1, 1].map((s) => (
            <g class="flow" style={`--d:${s > 0 ? -0.6 : 0}s`}>
              {[0, 1, 2].map((j) => {
                const y = c.yTip - 6 - j * 8, x = ax + s * (c.rh + 1.5);
                return <path d={`M${f(x)},${f(y + 3)} q${f(s * 5)},-0.5 ${f(s * 7)},-6`} class="push" marker-end="url(#tt-arr)" />;
              })}
            </g>
          ))}
          {k === 'point' && <path d={`M${ax + 36},${c.yTip - 4} L${ax + 36},${botT - 10}`} class="dir" marker-end="url(#ca-arr-data)" />}
          {k === 'spiral' && <path d={`M${ax - 40},${c.yTip - 6} L${ax - 40},${top + 12}`} class="dir" marker-end="url(#ca-arr-data)" />}
        </svg>
        <figcaption>
          <b>{t.name}</b>
          <span class="hole">{t.hole}</span>
          <span class="chips">{t.chips}</span>
        </figcaption>
      </figure>
    );
  })}
</div>

<script>
  import { whenIn, beginSmil } from '../../lib/motion';
  // start the turning when the figure comes into view; pause it (SMIL and CSS) while off screen
  document.querySelectorAll<HTMLElement>('[data-tt]').forEach((el) => {
    whenIn(el, () => {
      beginSmil(el);
      const svgs = [...el.querySelectorAll('svg')];
      new IntersectionObserver(([e]) => {
        el.classList.toggle('paused', !e.isIntersecting);
        svgs.forEach((s) => (e.isIntersecting ? s.unpauseAnimations() : s.pauseAnimations()));
      }).observe(el);
    });
  });
</script>

<style>
  .tt { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  @media (max-width: 40rem) { .tt { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .panel { margin: 0; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; padding: 0.35rem 0.45rem 0.6rem; display: grid; gap: 0.3rem; align-content: start; }
  svg { width: 100%; height: auto; display: block; overflow: hidden; }
