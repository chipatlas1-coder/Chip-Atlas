---
/**
 * Brinell and Vickers hardness from the measured indentation: pick the ball and force-diameter index
 * (Brinell) or the force step (Vickers), enter the indentation, read the hardness, the designation,
 * the validity window and the least thickness of the test piece. Arithmetic in src/lib/hardness.ts.
 */
import { BALLS, RATIOS, HV_STEPS, KGF, brinell, brinellForce, vickers, drawBrinell, drawVickers } from '../../lib/hardness';
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { bT: 'Brinell', vT: 'Vickers', ball: 'Bilye çapı D', ratio: 'Yük-çap indisi 0,102·F/D²', d: 'İz çapı d', force: 'Deney yükü', step: 'Yük kademesi', d1: 'Köşegen d₁', d2: 'Köşegen d₂', hard: 'Sertlik', des: 'Gösterim', depth: 'İz derinliği', thick: 'En az parça kalınlığı', win: 'Geçerli d aralığı', ok: 'içinde', out: 'dışında', range: 'Yük aralığı', macro: 'Vickers sertlik deneyi', low: 'Düşük yüklü Vickers', micro: 'Vickers mikrosertlik', diag: 'Köşegen aralığı 0,020–1,400 mm', sp: 'İzler arası / kenara (Metkon)', h: 'h', aria: 'Brinell ve Vickers sertlik hesaplayıcısı' }
  : { bT: 'Brinell', vT: 'Vickers', ball: 'Ball diameter D', ratio: 'Force-diameter index 0.102·F/D²', d: 'Indentation diameter d', force: 'Test force', step: 'Force step', d1: 'Diagonal d₁', d2: 'Diagonal d₂', hard: 'Hardness', des: 'Designation', depth: 'Indentation depth', thick: 'Least test-piece thickness', win: 'Valid d window', ok: 'inside', out: 'outside', range: 'Force range', macro: 'Vickers hardness test', low: 'Low-force Vickers test', micro: 'Vickers microhardness test', diag: 'Diagonal range 0.020–1.400 mm', sp: 'Spacing / to the edge (Metkon)', h: 'h', aria: 'Brinell and Vickers hardness calculator' };
const dec = (v: string) => (tr ? v.replace('.', ',') : v);
const IT = { d: 'd', h: 'h', d1: 'd₁', d2: 'd₂' };
const b0 = { D: 10, k: 30, d: 4 };
const F0 = brinellForce(b0.D, b0.k), B = brinell(F0, b0.D, b0.d);
const v0 = { step: 30, d1: 0.4, d2: 0.41 };
const V = vickers(v0.step * KGF, v0.d1, v0.d2);
const GB = drawBrinell(b0.D, b0.d, IT, dec), GV = drawVickers(v0.d1, v0.d2, IT, dec);
const n = (v: number, k = 2) => dec(v.toFixed(k));
const kgf = (D: number, k: number) => Math.round(k * D * D * 1000) / 1000;
---
<div class="hc" data-hc data-locale={locale}>
  <div class="tabs" role="tablist" aria-label={T.aria}>
    <button type="button" role="tab" aria-selected="true" class="on" data-tab="b">{T.bT}</button>
    <button type="button" role="tab" aria-selected="false" data-tab="v">{T.vT}</button>
  </div>
  <section class="pane" data-pane="b">
    <div class="controls">
      <label class="field"><span>{T.ball}</span><select data-i="D">{BALLS.map((D) => <option value={D} selected={D === b0.D}>{dec(String(D))} mm</option>)}</select></label>
      <label class="field"><span>{T.ratio}</span><select data-i="k">{RATIOS.map((k) => <option value={k} selected={k === b0.k}>{dec(String(k))}</option>)}</select></label>
      <label class="field grow"><span>{T.d} <output data-o="d">{n(b0.d)}</output> mm</span><input type="range" min="1.5" max="7.5" step="0.01" value={b0.d} data-i="d" /></label>
    </div>
    <div class="body">
      <svg viewBox={`0 0 ${GB.W} ${GB.H}`} aria-hidden="true">
        <defs><marker id="hd-a" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#2a78d6" /></marker></defs>
        <g data-g="b" set:html={GB.svg} />
      </svg>
      <dl class="read">
        <div class="big"><dt>{T.hard}</dt><dd class="num" data-o="hbw">{Math.round(B.HBW)} HBW</dd></div>
        <div><dt>{T.des}</dt><dd class="num" data-o="bdes">{Math.round(B.HBW)} HBW {dec(String(b0.D))}/{kgf(b0.D, b0.k)}</dd></div>
        <div><dt>{T.force}</dt><dd class="num" data-o="F">{dec((F0 / 1000).toFixed(2))} kN ({tr ? kgf(b0.D, b0.k).toLocaleString('tr-TR') : kgf(b0.D, b0.k)} kgf)</dd></div>
        <div data-c="win"><dt>{T.win}</dt><dd class="num" data-o="win">{n(B.dMin)}–{n(B.dMax)} mm · {B.valid ? T.ok : T.out}</dd></div>
        <div><dt>{T.depth}</dt><dd class="num" data-o="bh">{n(B.h, 3)} mm</dd></div>
        <div><dt>{T.thick} (8 h)</dt><dd class="num" data-o="bt">{n(B.minThick)} mm</dd></div>
        <div><dt>{T.sp}</dt><dd class="num" data-o="bsp">{n(B.spacing, 1)} / {n(B.edge, 1)} mm</dd></div>
      </dl>
    </div>
  </section>
  <section class="pane" data-pane="v" hidden>
    <div class="controls">
      <label class="field"><span>{T.step}</span><select data-i="st">{HV_STEPS.map((s) => <option value={s} selected={s === v0.step}>HV {dec(String(s))}</option>)}</select></label>
      <label class="field"><span>{T.d1} (mm)</span><input type="number" min="0.005" max="2" step="0.001" value={v0.d1} data-i="d1" inputmode="decimal" /></label>
      <label class="field"><span>{T.d2} (mm)</span><input type="number" min="0.005" max="2" step="0.001" value={v0.d2} data-i="d2" inputmode="decimal" /></label>
    </div>
    <div class="body">
      <svg viewBox={`0 0 ${GV.W} ${GV.H}`} aria-hidden="true"><g data-g="v" set:html={GV.svg} /></svg>
      <dl class="read">
        <div class="big"><dt>{T.hard}</dt><dd class="num" data-o="hv">{Math.round(V.HV)} HV</dd></div>
        <div><dt>{T.des}</dt><dd class="num" data-o="vdes">{Math.round(V.HV)} HV {dec(String(v0.step))}</dd></div>
        <div><dt>{T.force}</dt><dd class="num" data-o="vF">{dec((v0.step * KGF).toFixed(1))} N</dd></div>
        <div><dt>{T.range}</dt><dd data-o="vr">{T[V.range as 'macro']}</dd></div>
        <div data-c="diag"><dt>{T.diag}</dt><dd class="num" data-o="vd">d = {n(V.d, 3)} mm · {V.inDiag ? T.ok : T.out}</dd></div>
        <div><dt>{T.depth} (≈ d / 7)</dt><dd class="num" data-o="vh">{n(V.depth, 3)} mm</dd></div>
        <div><dt>{T.thick} (1{dec('.5')} d)</dt><dd class="num" data-o="vt">{n(V.minThick, 3)} mm</dd></div>
      </dl>
    </div>
  </section>
  <script type="application/json" data-text set:html={JSON.stringify(T)} />
</div>

<style>
  .hc { display: grid; gap: 0.8rem; }
  .tabs { display: flex; gap: 0.3rem; border-bottom: 1px solid var(--line); }
  .tabs button { font: 500 0.88rem var(--font-sans, inherit); color: var(--ink-3); background: none; border: 0; border-bottom: 2px solid transparent; padding: 0.45rem 0.8rem; margin-bottom: -1px; cursor: pointer; min-height: 2.3rem; }
  .tabs button.on { color: var(--ink); border-bottom-color: #e2601a; }
  .tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .pane { display: grid; gap: 0.8rem; }
  .pane[hidden] { display: none; }
  .controls { display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: 0.7rem 1rem; align-items: end; }
  @media (max-width: 40rem) { .controls { grid-template-columns: 1fr 1fr; } .grow { grid-column: 1 / -1; } }
  .field { display: grid; gap: 0.3rem; min-width: 0; }
  .field > span { font-size: 0.85rem; color: var(--ink-2); }
  .field output { color: var(--data); font-family: var(--font-mono); }
  .field input[type='range'] { width: 100%; accent-color: var(--accent); }
  select, input[type='number'] { width: 100%; font: inherit; font-size: 0.85rem; color: var(--ink); background: var(--bg-sunk); border: 1px solid var(--line-strong); border-radius: 4px; padding: 0.35rem 0.5rem; min-height: 2.1rem; box-sizing: border-box; }
  input[type='number'] { font-family: var(--font-mono); }
  .body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 1rem; align-items: center; }
  @media (max-width: 40rem) { .body { grid-template-columns: 1fr; } }
  svg { width: 100%; height: auto; display: block; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 4px; }
  .read { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem 1rem; margin: 0; }
  .read dt { font-size: 0.75rem; color: var(--ink-3); }
  .read dd { margin: 0.1rem 0 0; color: var(--ink); font-size: 0.92rem; }
  .read .big dd { color: #e2601a; font-size: 1.35rem; font-weight: 500; }
  .read .good dd { color: #0f8f6f; }
  .read .bad dd { color: #c2413b; }
  .hc :global(.hd-work) { fill: url(#ca-hatch); stroke: #555d63; stroke-width: 0.9; }
  .hc :global(.hd-surf) { fill: color-mix(in oklab, #555d63 10%, transparent); stroke: #555d63; stroke-width: 0.8; }
  .hc :global(.hd-ball) { fill: url(#ca-metal-h); stroke: #1e2123; stroke-width: 0.8; opacity: 0.9; }
  .hc :global(.hd-print) { fill: #f6fbff; stroke: #555d63; stroke-width: 1; }
  .hc :global(.hd-edge) { stroke: #555d63; stroke-width: 0.6; opacity: 0.6; }
  .hc :global(.hd-dim), .hc :global(.hd-diag) { stroke: #2a78d6; stroke-width: 1.2; }
  .hc :global(.hd-diag.v) { stroke: #e2601a; }
  .hc :global(.hd-ext) { stroke: #2a78d6; stroke-width: 0.6; stroke-dasharray: 2 2; }
  .hc :global(.hd-t) { font: 500 11px var(--font-mono); fill: #2a78d6; paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; }
  .hc :global(.hd-t.v) { fill: #e2601a; }
  .hc :global(.hd-t.s) { font-size: 10px; fill: var(--ink-3); }
</style>

<script>
  import { KGF, brinell, brinellForce, vickers, drawBrinell, drawVickers } from '../../lib/hardness';
  document.querySelectorAll<HTMLElement>('[data-hc]').forEach((root) => {
    const tr = root.dataset.locale === 'tr';
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const dec = (v: string) => (tr ? v.replace('.', ',') : v);
    const n = (v: number, k = 2) => dec(v.toFixed(k));
    const q = <E extends Element>(s: string) => root.querySelector(s) as E;
    const IT = { d: 'd', h: 'h', d1: 'd₁', d2: 'd₂' };
    const set = (k: string, v: string) => { q(`[data-o="${k}"]`).textContent = v; };
    const mark = (k: string, ok: boolean) => { const el = q<HTMLElement>(`[data-c="${k}"]`); el.classList.toggle('good', ok); el.classList.toggle('bad', !ok); };
    const kgf = (D: number, k: number) => Math.round(k * D * D * 1000) / 1000;
    const dR = q<HTMLInputElement>('[data-i="d"]');
    const rB = () => {
      const D = Number(q<HTMLSelectElement>('[data-i="D"]').value), k = Number(q<HTMLSelectElement>('[data-i="k"]').value);
      dR.min = String(0.15 * D); dR.max = String(0.75 * D); dR.step = String(D / 1000);
      const d = Math.min(Number(dR.max), Math.max(Number(dR.min), Number(dR.value)));
      const F = brinellForce(D, k), B = brinell(F, D, d);
      q('[data-g="b"]').innerHTML = drawBrinell(D, d, IT, dec).svg;
      set('d', n(d)); set('hbw', `${Math.round(B.HBW)} HBW`);
      set('bdes', `${Math.round(B.HBW)} HBW ${dec(String(D))}/${dec(String(kgf(D, k)))}`);
      const kg = kgf(D, k), kgs = tr && kg >= 1000 ? kg.toLocaleString('tr-TR') : dec(String(kg));
      set('F', F >= 1000 ? `${n(F / 1000)} kN (${kgs} kgf)` : `${n(F, 1)} N (${kgs} kgf)`);
      set('win', `${n(B.dMin)}–${n(B.dMax)} mm · ${B.valid ? T.ok : T.out}`); mark('win', B.valid);
      set('bh', `${n(B.h, 3)} mm`); set('bt', `${n(B.minThick)} mm`); set('bsp', `${n(B.spacing, 1)} / ${n(B.edge, 1)} mm`);
    };
    const rV = () => {
      const st = Number(q<HTMLSelectElement>('[data-i="st"]').value);
      const d1 = Number(q<HTMLInputElement>('[data-i="d1"]').value), d2 = Number(q<HTMLInputElement>('[data-i="d2"]').value);
      if (!(d1 > 0 && d2 > 0)) return;
      const V = vickers(st * KGF, d1, d2);
      q('[data-g="v"]').innerHTML = drawVickers(d1, d2, IT, dec).svg;
      set('hv', `${Math.round(V.HV)} HV`); set('vdes', `${Math.round(V.HV)} HV ${dec(String(st))}`);
      set('vF', `${n(st * KGF, st < 1 ? 3 : 1)} N`); set('vr', T[V.range]);
      set('vd', `d = ${n(V.d, 3)} mm · ${V.inDiag ? T.ok : T.out}`); mark('diag', V.inDiag);
      set('vh', `${n(V.depth, 3)} mm`); set('vt', `${n(V.minThick, 3)} mm`);
    };
    ['D', 'k'].forEach((k) => q(`[data-i="${k}"]`).addEventListener('change', () => { const D = Number(q<HTMLSelectElement>('[data-i="D"]').value); dR.value = String(0.4 * D); rB(); }));
    dR.addEventListener('input', rB);
    q('[data-i="st"]').addEventListener('change', rV);
    ['d1', 'd2'].forEach((k) => q(`[data-i="${k}"]`).addEventListener('input', rV));
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    tabs.forEach((b) => b.addEventListener('click', () => {
      tabs.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== b.dataset.tab; });
    }));
    rB(); rV();
  });
</script>
