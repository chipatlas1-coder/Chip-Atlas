---
/**
 * Facing at constant cutting speed with a spindle-speed limit. End view of the face with the tool
 * on a radius, and n and vc against the diameter. Geometry in src/lib/facing.ts. On entering the
 * view the tool travels once from the outside diameter to the centre; pointing at the chart moves it.
 */
import { drawFacing, facingAt, clampDia, type FacingText } from '../../lib/facing';
interface Props { locale: 'en' | 'tr'; vc?: number; d0?: number; nmax?: number }
const { locale, vc = 200, d0 = 120, nmax = 2500 } = Astro.props;
const tr = locale === 'tr';
const T: FacingText & Record<string, string> = tr
  ? { n: 'devir n', vc: 'kesme hızı vc', dia: 'çap', limit: 'devir sınırı', face: 'alın yüzeyi', rpm: 'dev/dak', mmin: 'm/dak', vcL: 'Kesme hızı vc', d0L: 'Başlangıç çapı', nmaxL: 'Devir sınırı', nowD: 'Çap D', nowN: 'Devir n', nowV: 'Kesme hızı vc', dcL: 'Sınıra ulaşılan çap', replay: 'Yeniden oynat', aria: 'Sabit kesme hızında alın tornalama: çap küçüldükçe devir sınıra kadar artar, sonra kesme hızı merkeze doğru düşer' }
  : { n: 'spindle speed n', vc: 'cutting speed vc', dia: 'diameter', limit: 'speed limit', face: 'end face', rpm: 'rpm', mmin: 'm/min', vcL: 'Cutting speed vc', d0L: 'Starting diameter', nmaxL: 'Speed limit nmax', nowD: 'Diameter D', nowN: 'Spindle speed n', nowV: 'Cutting speed vc', dcL: 'Limit reached at', replay: 'Replay', aria: 'Facing at constant cutting speed: as the diameter falls the spindle speed rises to the limit, then the cutting speed falls towards the centre' };
const dec = (v: string) => (tr ? v.replace('.', ',') : v);
const rest = (s: { vc: number; nmax: number; d0: number }) => { const dc = clampDia(s); return dc < s.d0 ? dc * 0.5 : s.d0 * 0.3; };
const s0 = { vc, d0, nmax, d: rest({ vc, nmax, d0 }) };
const G = [drawFacing(s0, T, false, dec), drawFacing(s0, T, true, dec)];
const c0 = facingAt(s0, s0.d), dc0 = clampDia(s0);
---
<div class="facing" data-facing data-locale={locale} data-anim>
  <svg viewBox={`0 0 ${G[0].W} ${G[0].H}`} class="wide" role="img" aria-label={T.aria} data-svg="w" set:html={G[0].svg} />
  <svg viewBox={`0 0 ${G[1].W} ${G[1].H}`} class="narrow" role="img" aria-label={T.aria} data-svg="n" set:html={G[1].svg} />
  <div class="controls">
    <label class="field"><span>{T.vcL} <output class="num" data-o="vc">{vc}</output> {T.mmin}</span>
      <input type="range" min="50" max="400" step="10" value={vc} data-i="vc" /></label>
    <label class="field"><span>{T.d0L} <output class="num" data-o="d0">{d0}</output> mm</span>
      <input type="range" min="20" max="300" step="5" value={d0} data-i="d0" /></label>
    <label class="field"><span>{T.nmaxL} <output class="num" data-o="nmax">{nmax}</output> {T.rpm}</span>
      <input type="range" min="500" max="6000" step="100" value={nmax} data-i="nmax" /></label>
    <button type="button" class="replay" data-replay aria-label={T.replay}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>{T.replay}</button>
  </div>
  <dl class="read">
    <div><dt>{T.nowD}</dt><dd class="num" data-o="d">{dec(s0.d.toFixed(1))} mm</dd></div>
    <div><dt>{T.nowN}</dt><dd class="num" data-o="n">{Math.round(c0.n)} {T.rpm}</dd></div>
    <div><dt>{T.nowV}</dt><dd class="num" data-o="v">{Math.round(c0.vc)} {T.mmin}</dd></div>
    <div><dt>{T.dcL}</dt><dd class="num" data-o="dc">{dc0 < d0 ? `D ${dec(dc0.toFixed(1))} mm` : '—'}</dd></div>
  </dl>
  <script type="application/json" data-text set:html={JSON.stringify(T)} />
</div>

<style>
  .facing { display: grid; gap: 0.8rem; }
  .facing > svg { width: 100%; height: auto; display: block; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 4px; touch-action: pan-y; }
  .narrow { display: none !important; }
  @media (max-width: 40rem) { .wide { display: none !important; } .narrow { display: block !important; } }
  .controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 0.7rem 1.2rem; align-items: end; }
  @media (max-width: 48rem) { .controls { grid-template-columns: minmax(0, 1fr); } .replay { justify-self: start; } }
  .field > span { display: flex; gap: 0.35rem; align-items: baseline; font-size: 0.85rem; flex-wrap: wrap; }
  .field output { color: var(--data); }
  .field input { width: 100%; accent-color: var(--accent); }
  .replay { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; padding: 0.35rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink-2); background: transparent; }
  .replay:hover { border-color: var(--accent); color: var(--ink); }
  .replay svg { width: 0.75rem; height: 0.75rem; fill: currentColor; }
  .read { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin: 0; }
  @media (max-width: 48rem) { .read { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .read dt { font-size: 0.78rem; color: var(--ink-3); line-height: 1.3; }
  .read dd { color: var(--data); font-size: 1.1rem; margin: 0; }
  .read div:nth-child(3) dd { color: var(--color-spark-400); }

  .facing :global(.fs-face) { fill: url(#ca-face); stroke: #2c3033; stroke-width: 1.3; }
  .facing :global(.fs-ring) { fill: none; stroke: #b1bac2; stroke-width: 0.7; stroke-opacity: 0.6; }
  .facing :global(.fs-mark) { stroke: #cdd5db; stroke-width: 1; stroke-dasharray: 10 4 2 4; }
  .facing :global(.fs-done) { fill: #202426; fill-opacity: 0.22; }
  .facing :global(.fs-cur) { fill: none; stroke: #1e6fd6; stroke-width: 1.3; stroke-dasharray: 5 4; }
  .facing :global(.fs-tool) { fill: #e0e8ed; stroke: #1b1d1e; stroke-width: 1.1; stroke-linejoin: round; }
  .facing :global(.fs-shank) { fill: url(#ca-metal-h); stroke: #656e74; stroke-width: 1; }
  .facing :global(.fs-feed) { stroke: #1e6fd6; stroke-width: 2; }
  .facing :global(.fs-rot) { fill: none; stroke: #e2601a; stroke-width: 1.8; }
  .facing :global(.fs-grid) { stroke: var(--line); }
  .facing :global(.fs-ax) { stroke: var(--ink-3); }
  .facing :global(.fs-lim) { stroke: #2a78d6; stroke-width: 1; stroke-dasharray: 6 4; }
  .facing :global(.fs-free) { fill: none; stroke: #1e6fd6; stroke-width: 1.2; stroke-dasharray: 2 4; stroke-opacity: 0.7; }
  .facing :global(.fs-n) { fill: none; stroke: #1e6fd6; stroke-width: 2.4; stroke-linejoin: round; }
  .facing :global(.fs-v) { fill: none; stroke: #e2601a; stroke-width: 2.4; stroke-linejoin: round; }
  .facing :global(.fs-dc) { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 3; }
  .facing :global(.fs-now) { stroke: var(--ink-2); stroke-width: 1; stroke-opacity: 0.6; }
  .facing :global(.fs-dot) { stroke: #f7fbfe; stroke-width: 2; }
  .facing :global(.fs-dot.n) { fill: #1e6fd6; }
  .facing :global(.fs-dot.v) { fill: #e2601a; }
  .facing :global(.fs-hit) { fill: transparent; cursor: ew-resize; }
  .facing :global(.fs-t) { font-family: var(--font-mono); font-size: 11.5px; fill: var(--ink-2); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; stroke-linejoin: round; }
  .facing :global(.fs-t.sm) { font-size: 10.5px; fill: var(--ink-3); }
  .facing :global(.fs-t.dat), .facing :global(.fs-tick.dat) { fill: #2a78d6; }
  .facing :global(.fs-t.acc), .facing :global(.fs-tick.acc) { fill: #e2601a; }
  .facing :global(.fs-tick) { font-family: var(--font-mono); font-size: 10.5px; fill: var(--ink-3); }
  .facing .narrow :global(.fs-t) { font-size: 12.5px; }
  .facing .narrow :global(.fs-tick) { font-size: 11.5px; }
</style>

<script>
  import { drawFacing, facingAt, clampDia } from '../../lib/facing';
  import { whenIn } from '../../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-facing]').forEach((root) => {
    const tr = root.dataset.locale === 'tr';
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const dec = (v: string) => (tr ? v.replace('.', ',') : v);
    const inp = (k: string) => root.querySelector(`[data-i="${k}"]`) as HTMLInputElement;
    const out = (k: string) => root.querySelector(`[data-o="${k}"]`) as HTMLElement;
    const svgs = [root.querySelector('[data-svg="w"]') as SVGSVGElement, root.querySelector('[data-svg="n"]') as SVGSVGElement];
    const base = () => ({ vc: Number(inp('vc').value), d0: Number(inp('d0').value), nmax: Number(inp('nmax').value) });
    const rest = (s: { vc: number; nmax: number; d0: number }) => { const dc = clampDia(s); return dc < s.d0 ? dc * 0.5 : s.d0 * 0.3; };
    let d = rest(base()), raf = 0;
    function render() {
      const s = { ...base(), d: Math.min(d, Number(inp('d0').value)) };
      svgs.forEach((svg, i) => { svg.innerHTML = drawFacing(s, T, i === 1, dec).svg; });
      const c = facingAt(s, s.d), dc = clampDia(s);
      out('vc').textContent = String(s.vc); out('d0').textContent = String(s.d0); out('nmax').textContent = String(s.nmax);
      out('d').textContent = `${dec(s.d.toFixed(1))} mm`;
      out('n').textContent = `${Math.round(c.n)} ${T.rpm}`;
      out('v').textContent = `${Math.round(c.vc)} ${T.mmin}`;
      out('dc').textContent = dc < s.d0 ? `D ${dec(dc.toFixed(1))} mm` : '—';
    }
    const stop = () => { if (raf) cancelAnimationFrame(raf); raf = 0; };
    ['vc', 'd0', 'nmax'].forEach((k) => inp(k).addEventListener('input', () => { stop(); d = rest(base()); render(); }));
    // point at the chart to move the tool
    svgs.forEach((svg, i) => svg.addEventListener('pointermove', (e) => {
      const hit = svg.querySelector('[data-hit]') as SVGRectElement | null;
      if (!hit) return;
      const r = hit.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) return;
      stop();
      const k = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      d = (1 - k) * Number(inp('d0').value);
      render();
    }));
    const play = () => {
      stop();
      const s = base(), end = rest(s), t0 = performance.now(), dur = 4200, back = 900;
      const step = (t: number) => {
        const x = (t - t0) / dur;
        if (x < 1) d = s.d0 * (1 - x);
        else { const y = Math.min(1, (t - t0 - dur) / back); d = end * (0.5 - 0.5 * Math.cos(Math.PI * y)); }
        render();
        raf = x < 1 + back / dur ? requestAnimationFrame(step) : 0;
      };
      raf = requestAnimationFrame(step);
    };
    (root.querySelector('[data-replay]') as HTMLButtonElement).addEventListener('click', play);
    whenIn(root, play);
  });
</script>
