---
/**
 * Boring-bar deflection, live: pick the bar material, diameter, overhang (as L/D) and the radial load;
 * the bar bends as a cantilever (δ = F L³ / 3EI, magnified to be visible) and the chart shows δ against
 * L/D for the three materials on a log scale. Arithmetic and drawing in src/lib/boring.ts.
 */
import { drawBar, drawCurve, deflection, inertia, type BState, type Mat } from '../../lib/boring';
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { clamp: 'bağlama ≥ 4 × D', ld: 'L/D', mag: 'sehim büyütme', force: 'Radyal yük F', limit: 'sınır', steel: 'çelik', heavy: 'ağır metal', carbide: 'karbür', yAxis: 'δ (µm)', xAxis: 'L/D', mat: 'Bara malzemesi', D: 'Bara çapı D', ldL: 'Sarkma L/D', dRead: 'Uçta sehim δ', LRead: 'Sarkma L', IRead: 'Atalet momenti I', guide: 'Kılavuz sınır (Sandvik; ağır metal: Kennametal)', within: 'içinde', beyond: 'aşıldı', aria: 'Delik barasının sehimi: bara malzemesi, çapı, sarkması ve radyal yükle uçtaki sehim; üç malzeme için sehim–L/D grafiği' }
  : { clamp: 'clamp ≥ 4 × D', ld: 'L/D', mag: 'deflection ×', force: 'Radial load F', limit: 'limit', steel: 'steel', heavy: 'heavy metal', carbide: 'carbide', yAxis: 'δ (µm)', xAxis: 'L/D', mat: 'Bar material', D: 'Bar diameter D', ldL: 'Overhang L/D', dRead: 'Deflection at the tip δ', LRead: 'Overhang L', IRead: 'Moment of inertia I', guide: 'Guide limit (Sandvik; heavy metal: Kennametal)', within: 'within', beyond: 'exceeded', aria: 'Boring bar deflection: deflection at the tip for the chosen bar material, diameter, overhang and radial load; chart of deflection against L/D for three materials' };
if (!tr) T.mag = 'deflection';
const dec = (v: string) => (tr ? v.replace('.', ',') : v);
const st: BState = { mat: 'steel', D: 25, ld: 4, F: 500 };
const GB = [drawBar(st, T, false, dec), drawBar(st, T, true, dec)];
const GC = [drawCurve(st, T, false, dec), drawCurve(st, T, true, dec)];
const mats: Mat[] = ['steel', 'heavy', 'carbide'];
const d0 = deflection(st.F, st.ld * st.D, st.mat, st.D);
const fmtI = (v: number) => (tr ? Math.round(v).toLocaleString('tr-TR') : Math.round(v).toLocaleString('en-US'));
---
<div class="bd" data-bd data-locale={locale} data-anim>
  <svg class="defs" aria-hidden="true" width="0" height="0"><defs>
    <marker id="bd-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#e2601a" /></marker>
    <marker id="bd-d" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse" markerUnits="userSpaceOnUse"><path d="M0,1 L10,5 L0,9 z" fill="#2a78d6" /></marker>
  </defs></svg>
  <div class="controls">
    <div class="field"><span>{T.mat}</span>
      <div class="seg" role="radiogroup" aria-label={T.mat}>
        {mats.map((m) => <button type="button" role="radio" aria-checked={m === st.mat ? 'true' : 'false'} class:list={[m, { on: m === st.mat }]} data-m={m}>{T[m]}</button>)}
      </div>
    </div>
    <label class="field"><span>{T.D} <output data-o="D">{st.D}</output> mm</span><input type="range" min="6" max="60" step="1" value={st.D} data-i="D" /></label>
    <label class="field"><span>{T.ldL} <output data-o="ld">{dec(st.ld.toFixed(1))}</output></span><input type="range" min="1" max="10" step="0.1" value={st.ld} data-i="ld" /></label>
    <label class="field"><span>{T.force} <output data-o="F">{st.F}</output> N</span><input type="range" min="50" max="3000" step="50" value={st.F} data-i="F" /></label>
  </div>
  <div class="views">
    <svg viewBox={`0 0 ${GB[0].W} ${GB[0].H}`} class="wide" role="img" aria-label={T.aria} data-s="bw" set:html={GB[0].svg} />
    <svg viewBox={`0 0 ${GC[0].W} ${GC[0].H}`} class="wide" aria-hidden="true" data-s="cw" set:html={GC[0].svg} />
    <svg viewBox={`0 0 ${GB[1].W} ${GB[1].H}`} class="narrow" role="img" aria-label={T.aria} data-s="bn" set:html={GB[1].svg} />
    <svg viewBox={`0 0 ${GC[1].W} ${GC[1].H}`} class="narrow" aria-hidden="true" data-s="cn" set:html={GC[1].svg} />
  </div>
  <dl class="read">
    <div class="big"><dt>{T.dRead}</dt><dd class="num" data-o="d">{dec((d0 * 1000).toFixed(1))} µm</dd></div>
    <div><dt>{T.LRead}</dt><dd class="num" data-o="L">{dec((st.ld * st.D).toFixed(0))} mm</dd></div>
    <div><dt>{T.IRead}</dt><dd class="num" data-o="I">{fmtI(inertia(st.D))} mm⁴</dd></div>
    <div data-c="lim"><dt>{T.guide}</dt><dd class="num" data-o="lim">4 × D · {T.within}</dd></div>
  </dl>
  <script type="application/json" data-text set:html={JSON.stringify(T)} />
</div>

<style>
  .bd { display: grid; gap: 0.8rem; position: relative; }
  svg.defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .controls { display: grid; grid-template-columns: auto repeat(3, minmax(0, 1fr)); gap: 0.7rem 1rem; align-items: end; }
  @media (max-width: 52rem) { .controls { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 30rem) { .controls { grid-template-columns: 1fr; } }
  .field { display: grid; gap: 0.3rem; min-width: 0; }
  .field > span { font-size: 0.85rem; color: var(--ink-2); }
  .field output { color: var(--data); font-family: var(--font-mono); }
  .field input[type='range'] { width: 100%; accent-color: var(--accent); }
  .seg { display: flex; border: 1px solid var(--line-strong); border-radius: 4px; overflow: hidden; }
  .seg button { flex: 1; font: inherit; font-size: 0.8rem; color: var(--ink-2); background: var(--bg-sunk); border: 0; padding: 0.35rem 0.55rem; min-height: 2.1rem; cursor: pointer; white-space: nowrap; }
  .seg button + button { border-left: 1px solid var(--line-strong); }
  .seg button.on.steel { background: #56708c; color: #fbfdff; }
  .seg button.on.heavy { background: #8b52c9; color: #fbfdff; }
  .seg button.on.carbide { background: #e2601a; color: #fbfdff; }
  .seg button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .views { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 0.5rem; }
  .views svg { width: 100%; height: auto; display: block; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 4px; }
  .views .narrow { display: none; }
  @media (max-width: 40rem) { .views { grid-template-columns: 1fr; } .views .wide { display: none; } .views .narrow { display: block; } }
  .read { display: grid; grid-template-columns: 1.1fr 0.8fr 1fr 1.4fr; gap: 0.75rem; margin: 0; }
  @media (max-width: 40rem) { .read { grid-template-columns: 1fr 1fr; } }
  .read dt { font-size: 0.75rem; color: var(--ink-3); }
  .read dd { margin: 0.1rem 0 0; color: var(--ink); font-size: 0.95rem; }
  .read .big dd { color: #2a78d6; font-size: 1.35rem; font-weight: 500; }
  .read .good dd { color: #0f8f6f; }
  .read .bad dd { color: #c2413b; }
  .bd :global(.bd-clamp) { fill: url(#ca-hatch); stroke: #555d63; stroke-width: 0.9; }
  .bd :global(.bd-axis) { stroke: #767e86; stroke-width: 0.8; stroke-dasharray: 6 4; }
  .bd :global(.bd-bar) { stroke: #1e2123; stroke-width: 0.9; stroke-linejoin: round; }
  .bd :global(.bd-bar.steel) { fill: color-mix(in oklab, #56708c 45%, #dee6ef); }
  .bd :global(.bd-bar.heavy) { fill: color-mix(in oklab, #8b52c9 40%, #dee6ef); }
  .bd :global(.bd-bar.carbide) { fill: color-mix(in oklab, #e2601a 38%, #dee6ef); }
  .bd :global(.bd-ins) { fill: #c98a0a; stroke: #916e00; stroke-width: 0.6; }
  .bd :global(.bd-force) { stroke: #e2601a; stroke-width: 2.2; }
  .bd :global(.bd-dim) { stroke: #2a78d6; stroke-width: 1.2; }
  .bd :global(.bd-tick) { stroke: var(--ink-3); stroke-width: 1; }
  .bd :global(.bd-ok) { fill: #13998a; fill-opacity: 0.35; }
  .bd :global(.bd-lim) { stroke: #13998a; stroke-width: 2; }
  .bd :global(.bd-grid) { stroke: var(--line); stroke-width: 1; }
  .bd :global(.bd-c) { fill: none; stroke-width: 1.6; opacity: 0.55; }
  .bd :global(.bd-c.on) { stroke-width: 2.6; opacity: 1; }
  .bd :global(.bd-c.steel), .bd :global(.bd-dot.steel) { stroke: #56708c; }
  .bd :global(.bd-c.heavy), .bd :global(.bd-dot.heavy) { stroke: #8b52c9; }
  .bd :global(.bd-c.carbide), .bd :global(.bd-dot.carbide) { stroke: #e2601a; }
  .bd :global(.bd-dot) { fill: #f7fbfe; stroke-width: 2.4; }
  .bd :global(.bd-t) { font: 11px var(--font-mono); fill: var(--ink-2); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; }
  .bd :global(.bd-t.s) { font-size: 10.5px; fill: var(--ink-3); }
  .bd :global(.bd-t.f) { fill: #e2601a; }
  .bd :global(.bd-t.c.steel) { fill: #56708c; } .bd :global(.bd-t.c.heavy) { fill: #8b52c9; } .bd :global(.bd-t.c.carbide) { fill: #e2601a; }
  /* entry: the bar bends from straight */
  .bd :global(.bd-bar) { transform-box: view-box; }
  :global(html.anim) .bd[data-anim]:not([data-in]) :global(:is(.bd-force, .bd-dim, .bd-ins)) { opacity: 0; }
  :global(html.anim) .bd[data-anim][data-in]:not(.settled) :global(:is(.bd-force, .bd-ins)) { animation: ca-fade 0.4s 0.2s backwards; }
  :global(html.anim) .bd[data-anim][data-in]:not(.settled) :global(.bd-dim) { animation: ca-fade 0.4s 1.1s backwards; }
  :global(html.anim) .bd[data-anim][data-in]:not(.settled) :global(.bd-c) { stroke-dasharray: 1; animation: ca-draw 1s 0.3s ease-out backwards; }
</style>

<script>
  import { drawBar, drawCurve, deflection, inertia, LIMIT, type Mat } from '../../lib/boring';
  import { whenIn } from '../../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-bd]').forEach((root) => {
    const tr = root.dataset.locale === 'tr';
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const dec = (v: string) => (tr ? v.replace('.', ',') : v);
    const q = <E extends Element>(s: string) => root.querySelector(s) as E;
    let mat: Mat = 'steel';
    const fmtI = (v: number) => (tr ? Math.round(v).toLocaleString('tr-TR') : Math.round(v).toLocaleString('en-US'));
    const read = () => ({ mat, D: Number(q<HTMLInputElement>('[data-i="D"]').value), ld: Number(q<HTMLInputElement>('[data-i="ld"]').value), F: Number(q<HTMLInputElement>('[data-i="F"]').value) });
    const render = (s = read(), bend = 1) => {
      const set = (k: string, svg: string) => { q(`[data-s="${k}"]`).innerHTML = svg; };
      const bw = drawBar(s, T, false, dec, bend), bn = drawBar(s, T, true, dec, bend);
      set('bw', bw.svg); set('bn', bn.svg); set('cw', drawCurve(s, T, false, dec).svg); set('cn', drawCurve(s, T, true, dec).svg);
      const d = deflection(s.F, s.ld * s.D, s.mat, s.D);
      q('[data-o="D"]').textContent = String(s.D);
      q('[data-o="ld"]').textContent = dec(s.ld.toFixed(1));
      q('[data-o="F"]').textContent = String(s.F);
      q('[data-o="d"]').textContent = `${dec((d * 1000).toFixed(d * 1000 < 10 ? 2 : 1))} µm`;
      q('[data-o="L"]').textContent = `${dec((s.ld * s.D).toFixed(0))} mm`;
      q('[data-o="I"]').textContent = `${fmtI(inertia(s.D))} mm⁴`;
      const ok = s.ld <= LIMIT[s.mat] + 1e-9, box = q<HTMLElement>('[data-c="lim"]');
      box.classList.toggle('good', ok); box.classList.toggle('bad', !ok);
      q('[data-o="lim"]').textContent = `${LIMIT[s.mat]} × D · ${ok ? T.within : T.beyond}`;
    };
    ['D', 'ld', 'F'].forEach((k) => q(`[data-i="${k}"]`).addEventListener('input', () => { root.classList.add('settled'); render(); }));
    const segs = [...root.querySelectorAll<HTMLButtonElement>('.seg button')];
    segs.forEach((b) => b.addEventListener('click', () => {
      mat = b.dataset.m as Mat; root.classList.add('settled');
      segs.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-checked', String(x === b)); });
      render();
    }));
    render(read(), document.documentElement.classList.contains('anim') ? 0 : 1);
    // entry: the load comes on and the bar bends from straight
    whenIn(root, () => {
      const s = read(), t0 = performance.now(), dur = 900;
      const step = (now: number) => {
        const u = Math.min(1, (now - t0) / dur), e = 1 - (1 - u) ** 3;
        render(s, e);
        if (u < 1) requestAnimationFrame(step); else { render(s); setTimeout(() => root.classList.add('settled'), 800); }
      };
      requestAnimationFrame(step);
    });
  });
</script>
