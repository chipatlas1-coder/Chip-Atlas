---
/**
 * Helical interpolation, played: Haas's O60023 (internal 1.5-8 UNC, Ø0.5 in multi-tooth thread mill)
 * in plan and in section, with the program's cutting blocks lit as the tool runs them and the live
 * X, Y, Z. Geometry and timing in src/lib/threadmill.ts. Without motion the figure shows the tool
 * at the end of its orbit with the whole thread cut.
 */
import { stateAt, drawTop, drawSide, sideWork, topWork, PHASES } from '../../lib/threadmill';
interface Props {
  locale: 'en' | 'tr';
  t: { plan: string; section: string; play: string; pause: string; excerpt: string; aria: string; lines: string[]; phase: Record<string, string> };
}
const { locale, t } = Astro.props;
const tStatic = PHASES.slice(0, 4).reduce((a, p) => a + p.dur, 0) - 1e-7;   // end of the full orbit
const st = stateAt(tStatic);
const code = ['S1000 M03', 'G01 Z-0.5156 F50.', 'G41 X0.25 Y-0.25 F10. D01', 'G03 X0.5 Y0 I0 J0.25 Z-0.5', 'I-0.5 J0 Z-0.375 F20.', 'X0.25 Y0.25 I-0.25 J0 Z-0.3594', '…'];
const ph = ['', 'down', 'line', 'arcin', 'full', 'arcout', 'back up'];
const num = (v: number) => (v < -5e-5 ? '−' : '') + Math.abs(v).toFixed(4);
const dec = (s: string) => (locale === 'tr' ? s.replace('.', ',') : s);
---
<div class="tmp" data-tmp data-anim data-locale={locale} role="group" aria-label={t.aria}>
  <div class="views">
    <figure class="v">
      <svg viewBox="0 0 240 240" aria-hidden="true">
        <g set:html={topWork()} />
        <g data-top set:html={drawTop(st, false, true)} />
        <text x="18" y="232" class="tm-cap">{t.plan}</text>
      </svg>
    </figure>
    <figure class="v">
      <svg viewBox="0 0 260 240" aria-hidden="true">
        <g set:html={sideWork()} />
        <g data-side set:html={drawSide(st, true)} />
        <text x="18" y="226" class="tm-cap">{t.section}</text>
      </svg>
    </figure>
  </div>
  <div class="panel">
    <div class="head">
      <span class="ph" data-phase>{t.phase.full}</span>
      <span class="xyz num"><b>X</b> <output data-x>{dec(num(st.x))}</output> <b>Y</b> <output data-y>{dec(num(st.y))}</output> <b>Z</b> <output data-z>{dec(num(st.z))}</output></span>
      <button type="button" class="pp" data-pp hidden aria-pressed="false">{t.pause}</button>
    </div>
    <ol class="code">
      {code.map((c, i) => (
        <li data-ph={ph[i]} class:list={[{ on: ph[i] === 'full' }]}><code>{c}</code><span>{t.lines[i]}</span></li>
      ))}
    </ol>
    <p class="ex">{t.excerpt}</p>
  </div>
  <script type="application/json" data-text set:html={JSON.stringify({ phase: t.phase, play: t.play, pause: t.pause })} />
</div>

<style>
  .tmp { display: grid; grid-template-columns: 1fr; gap: 0.6rem; }
  .views { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  .v { margin: 0; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; padding: 0.3rem; }
  svg { width: 100%; height: auto; display: block; }
  .panel { background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; padding: 0.6rem 0.7rem; display: grid; gap: 0.5rem; min-width: 0; }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; }
  .ph { font-size: 0.85rem; color: var(--ink); font-weight: 500; min-width: 9rem; }
  .xyz { font-size: 0.8rem; color: var(--data); white-space: nowrap; }
  .xyz b { color: var(--ink-3); font-weight: 500; }
  .xyz output { display: inline-block; min-width: 4.6em; text-align: right; }
  .pp { margin-left: auto; font: 500 0.75rem var(--font-mono); color: var(--ink-2); background: transparent; border: 1px solid var(--line-strong); border-radius: 4px; padding: 0.25rem 0.6rem; min-height: 1.9rem; cursor: pointer; }
  .pp:hover { color: var(--ink); border-color: var(--ink-3); }
  .pp:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .code { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; counter-reset: ln; }
  .code li { display: grid; grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); gap: 0.05rem 1rem; align-items: baseline; padding: 0.28rem 0.45rem 0.3rem 1.9rem; border-radius: 4px; position: relative; transition: background-color 160ms; counter-increment: ln; }
  .code li::before { content: counter(ln); position: absolute; left: 0.45rem; top: 0.33rem; font: 0.7rem var(--font-mono); color: var(--ink-3); }
  .code code { font: 500 0.8rem var(--font-mono); color: var(--ink-2); background: none; padding: 0; white-space: pre-wrap; word-break: break-word; transition: color 160ms; }
  .code span { font-size: 0.74rem; color: var(--ink-3); line-height: 1.3; }
  .code li.on { background: color-mix(in oklab, #e2601a 13%, transparent); }
  .code li.on code { color: #b45e23; }
  .code li.on::after { content: ""; position: absolute; left: 0; top: 0.2rem; bottom: 0.2rem; width: 3px; border-radius: 2px; background: #e2601a; }
  @media (max-width: 40rem) { .code li { grid-template-columns: minmax(0, 1fr); } }
  .ex { margin: 0; font-size: 0.72rem; color: var(--ink-3); }
  .tmp :global(.tm-work) { fill: url(#ca-hatch); stroke: #555d63; stroke-width: 0.9; }
  .tmp :global(.tm-bore) { fill: #f2f8ff; stroke: #555d63; stroke-width: 0.9; }
  .tmp :global(.tm-major) { fill: none; stroke: #2a78d6; stroke-width: 0.8; stroke-dasharray: 3 3; opacity: 0.55; }
  .tmp :global(.tm-root) { fill: none; stroke: #2a78d6; stroke-width: 2.4; stroke-linecap: round; }
  .tmp :global(.tm-path) { fill: none; stroke: #e2601a; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .tmp :global(.tm-axis) { stroke: #767e86; stroke-width: 0.7; stroke-dasharray: 10 3 2 3; fill: none; }
  .tmp :global(.tm-tool .tm-body) { fill: url(#ca-metal-h); }
  .tmp :global(.tm-fl) { fill: #f4f9fe; opacity: 0.85; }
  .tmp :global(.tm-c) { fill: #e2601a; }
  .tmp :global(.tm-edge) { fill: none; stroke: #1e2123; stroke-width: 0.7; stroke-linejoin: round; }
  .tmp :global(.tm-flute) { fill: #f4f9fe; opacity: 0.8; }
  .tmp :global(.tm-groove) { fill: #f2f8ff; stroke: #2a78d6; stroke-width: 1; stroke-linejoin: round; }
  .tmp :global(.tm-helix) { fill: none; stroke: #2a78d6; stroke-width: 1.1; opacity: 0.55; }
  .tmp :global(.tm-cap) { font: 500 10.5px var(--font-mono); fill: var(--ink-3); letter-spacing: 0.04em; text-transform: uppercase; }
  :global(html.anim) .tmp[data-anim]:not([data-in]) .v { opacity: 0; }
  :global(html.anim) .tmp[data-anim][data-in] .v { animation: ca-rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; }
  :global(html.anim) .tmp[data-anim][data-in] .v + .v { animation-delay: 0.1s; }
</style>

<script>
  import { stateAt, drawTop, drawSide, TOTAL } from '../../lib/threadmill';
  import { whenIn } from '../../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-tmp]').forEach((root) => {
    const tr = root.dataset.locale === 'tr';
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const top = root.querySelector('[data-top]')!, side = root.querySelector('[data-side]')!;
    const ox = root.querySelector('[data-x]')!, oy = root.querySelector('[data-y]')!, oz = root.querySelector('[data-z]')!;
    const phEl = root.querySelector('[data-phase]')!;
    const lines = [...root.querySelectorAll<HTMLElement>('.code li')];
    const pp = root.querySelector<HTMLButtonElement>('[data-pp]')!;
    const num = (v: number) => { const s = (v < -5e-5 ? '−' : '') + Math.abs(v).toFixed(4); return tr ? s.replace('.', ',') : s; };
    let t0 = 0, paused = false, pauseAt = 0, visible = true, raf = 0, last = '';
    const frame = (now: number) => {
      const t = (now - t0) / 1000;
      const st = stateAt(t);
      top.innerHTML = drawTop(st, false);
      side.innerHTML = drawSide(st);
      ox.textContent = num(st.x); oy.textContent = num(st.y); oz.textContent = num(st.z);
      if (st.phase !== last) {
        last = st.phase;
        phEl.textContent = T.phase[st.phase] ?? '';
        lines.forEach((li) => li.classList.toggle('on', (li.dataset.ph || '').split(' ').includes(st.phase)));
      }
      if (!paused && visible) raf = requestAnimationFrame(frame);
    };
    const start = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); };
    whenIn(root, () => {
      t0 = performance.now();
      pp.hidden = false;
      start();
      new IntersectionObserver(([e]) => {
        const was = visible;
        visible = e.isIntersecting;
        if (visible && !was && !paused) { t0 += performance.now() - pauseAt; start(); }
        if (!visible && was && !paused) { pauseAt = performance.now(); cancelAnimationFrame(raf); }
      }).observe(root);
    });
    pp.addEventListener('click', () => {
      paused = !paused;
      pp.textContent = paused ? T.play : T.pause;
      pp.setAttribute('aria-pressed', String(paused));
      if (paused) { pauseAt = performance.now(); cancelAnimationFrame(raf); }
      else { t0 += performance.now() - pauseAt; start(); }
    });
    void TOTAL;
  });
</script>
