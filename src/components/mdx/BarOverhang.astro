---
/**
 * Maximum boring-bar overhang as multiples of the bar diameter, drawn to one scale: each bar is
 * shown clamped at the left with its overhang in units of D (one tick per D). Values and labels come
 * from the article through `bars`. On entering the view the bars extend from the clamp.
 */
interface Bar { label: string; sub?: string; times: number; damped?: boolean; carbide?: boolean }
interface Props { bars: Bar[]; aria: string; unit: string; clamp: string }
const { bars, aria, unit, clamp } = Astro.props;
function layout(narrow: boolean) {
  const W = narrow ? 360 : 660, labW = narrow ? 0 : 232, x0 = (narrow ? 36 : 272), x1 = W - (narrow ? 58 : 66);
  const max = Math.max(...bars.map((b) => b.times));
  const D = (x1 - x0) / (max + 0.6);
  const row = narrow ? 50 : 38, top = 28;
  const H = top + bars.length * row + 30;
  return { narrow, W, H, labW, x0, x1, D, row, top, max };
}
const G = [layout(false), layout(true)];
---
<div class="bo" data-anim role="img" aria-label={aria}>
  {G.map((g) => (
    <svg viewBox={`0 0 ${g.W} ${g.H}`} class={g.narrow ? 'narrow' : 'wide'} aria-hidden="true">
      {/* D ticks */}
      {Array.from({ length: g.max + 1 }, (_, k) => (
        <g>
          <line x1={g.x0 + k * g.D} x2={g.x0 + k * g.D} y1={g.top - 8} y2={g.H - 26} class={k === 0 ? 'clampline' : 'tick'} />
          {(!g.narrow || k % 2 === 0) && <text x={g.x0 + k * g.D} y={g.H - 10} text-anchor="middle" class="tk">{k === 0 ? '0' : `${k}`}</text>}
        </g>
      ))}
      <text x={g.x1} y={g.top - 14} text-anchor="end" class="tk">{unit}</text>
      <text x={g.x0 - 6} y={g.top - 14} text-anchor="end" class="tk">{clamp}</text>
      {bars.map((b, i) => {
        const y = g.top + i * g.row + (g.narrow ? 22 : 8), h = 14, len = b.times * g.D;
        return (
          <g class="bar" style={`--i:${i}`}>
            {g.narrow
              ? <text x={g.x0} y={y - 6} class="lab">{b.label}{b.sub && <tspan class="sub"> {b.sub}</tspan>}</text>
              : <g><text x={g.labW} y={y + 7} text-anchor="end" class="lab">{b.label}</text>{b.sub && <text x={g.labW} y={y + 20} text-anchor="end" class="sub">{b.sub}</text>}</g>}
            <rect x={g.x0 - 30} y={y - 4} width="30" height={h + 8} rx="2" class="clamp" />
            <g class="grow">
              <rect x={g.x0} y={y} width={len} height={h} rx="2" class:list={['shaft', { carbide: b.carbide }]} />
              {b.damped && <rect x={g.x0 + len * 0.55} y={y + 2} width={len * 0.32} height={h - 4} rx="1.5" class="damper" />}
              <path d={`M${g.x0 + len},${y} l9,${h / 2} l-9,${h / 2} Z`} class="head" />
            </g>
            <text x={g.x0 + len + 14} y={y + 11} class="val">{b.times} × D</text>
          </g>
        );
      })}
    </svg>
  ))}
</div>

<style>
  .bo { display: grid; }
  svg { width: 100%; height: auto; display: block; }
  .narrow { display: none; }
  @media (max-width: 40rem) { .wide { display: none; } .narrow { display: block; } }
  .tick { stroke: var(--line); }
  .clampline { stroke: var(--ink-3); stroke-width: 1.2; }
  .tk { font: 10.5px var(--font-mono); fill: var(--ink-3); }
  .lab { font: 500 12.5px var(--font-sans); fill: var(--ink); }
  .sub { font: 10.5px var(--font-mono); fill: var(--ink-3); }
  .clamp { fill: url(#ca-hatch); stroke: #656e74; }
  .shaft { fill: url(#ca-metal); stroke: #2c3033; stroke-width: 0.8; }
  .shaft.carbide { fill: url(#ca-carbide); stroke: #474e54; }
  .damper { fill: color-mix(in oklab, #1e6fd6 35%, transparent); stroke: #1e6fd6; stroke-width: 0.8; stroke-dasharray: 2 2; }
  .head { fill: #e0e8ed; stroke: #1b1d1e; stroke-width: 0.9; }
  .val { font: 500 12px var(--font-mono); fill: #2a78d6; }
  .narrow .lab { font-size: 13px; }
  .narrow .val { font-size: 12.5px; }
  .grow { transform-box: fill-box; transform-origin: 0 50%; }
  :global(html.anim) .bo[data-anim]:not([data-in]) .grow { transform: scaleX(0); }
  :global(html.anim) .bo[data-anim]:not([data-in]) .val { opacity: 0; }
  :global(html.anim) .bo[data-anim][data-in] .grow { animation: ca-grow-x 0.9s cubic-bezier(0.2, 0.75, 0.2, 1) backwards; animation-delay: calc(var(--i) * 0.12s); }
  :global(html.anim) .bo[data-anim][data-in] .val { animation: ca-fade 0.4s backwards; animation-delay: calc(0.8s + var(--i) * 0.12s); }
</style>
