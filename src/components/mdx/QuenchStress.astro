---
/**
 * Residual stress from quenching thick plate, schematic. Left: stress through the thickness —
 * compression at both surfaces, tension in the core, and the much smaller stress left after the
 * plate is stretched (TX51). Right: a part machined from one side; removing material upsets the
 * balance and the part bows (exaggerated). No magnitudes are drawn.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? {
      a: 'Kalınlık boyunca gerilme', aT: 'Su verilmiş levha: yüzeylerde basma, çekirdekte çekme. Gerdirme bunu büyük ölçüde azaltır ama sıfırlamaz.',
      b: 'Bir taraftan işledikten sonra', bT: 'Talaş kaldırmak gerilme dengesini bozar; parça kalan gerilmeyle eğilir.',
      comp: 'basma', tens: 'çekme', q: 'su verilmiş', s: 'gerdirilmiş', surf: 'yüzey', core: 'çekirdek',
      stock: 'ham levha', part: 'işlenmiş parça', dist: 'çarpılma (abartılı)',
      aria: ['Su verilmiş ve gerdirilmiş levhada kalıntı gerilme dağılımı, şematik', 'Bir taraftan işlenen parçanın kalıntı gerilme nedeniyle eğilmesi, şematik'],
    }
  : {
      a: 'Stress through the thickness', aT: 'As quenched: compression at the surfaces, tension in the core. Stretching cuts it sharply but not to zero.',
      b: 'After machining from one side', bT: 'Removing material upsets the balance; the part bows under the stress that is left.',
      comp: 'compression', tens: 'tension', q: 'as quenched', s: 'stretched', surf: 'surface', core: 'core',
      stock: 'stock', part: 'machined part', dist: 'distortion (exaggerated)',
      aria: ['Residual stress through the thickness of quenched and of stretched plate, schematic', 'A part machined from one side bowing under residual stress, schematic'],
    };
// panel A geometry
const yT = 34, yB = 166, yc = (yT + yB) / 2, x0 = 186, A = 52;
const prof = (amp: number) => Array.from({ length: 41 }, (_, i) => -1 + i / 20).map((u) => `${(x0 + amp * (1 - 3 * u * u)).toFixed(1)},${(yc + u * (yB - yc)).toFixed(1)}`);
const pq = prof(A), ps = prof(A / 10);
const area = `M${x0},${yT} L${pq.join(' L')} L${x0},${yB} Z`;
// panel B geometry: web + ribs, bowed (ends up) and straight ghost
const bx0 = 40, bx1 = 262, bow = 11;
const yb = (x: number) => 128 - bow * ((x - 151) / 111) ** 2;
const ribs = [40, 84, 128, 174, 218, 262];
const partPath = (b: (x: number) => number) => {
  const xs = Array.from({ length: 23 }, (_, i) => bx0 + (i / 22) * (bx1 - bx0));
  const bottom = xs.map((x) => `${x.toFixed(1)},${b(x).toFixed(1)}`);
  const top = [...xs].reverse().map((x) => `${x.toFixed(1)},${(b(x) - 9).toFixed(1)}`);
  return `M${bottom.join(' L')} L${top.join(' L')} Z`;
};
const ribPath = (b: (x: number) => number) => ribs.map((x) => {
  const w = x === bx0 || x === bx1 ? 7 : 6, xa = x === bx1 ? x - w : x === bx0 ? x : x - w / 2;
  return `M${xa},${b(xa) - 8} L${xa},${b(xa) - 48} L${xa + w},${b(xa + w) - 48} L${xa + w},${b(xa + w) - 8} Z`;
}).join(' ');
const flat = (_x: number) => 128;
---
<div class="qs">
  <figure class="pn">
    <svg viewBox="0 0 300 190" role="img" aria-label={T.aria[0]}>
      <defs>
        <clipPath id="qs-c"><rect x="0" y="0" width={x0} height="190" /></clipPath>
        <clipPath id="qs-t"><rect x={x0} y="0" width="120" height="190" /></clipPath>
      </defs>
      {/* plate section */}
      <rect x="16" y={yT} width="40" height={yB - yT} fill="url(#ca-metal-h)" stroke="#2c3033" stroke-width="1" />
      <line x1="56" x2={x0 - 2 * A - 6} y1={yT} y2={yT} class="lead" />
      <line x1="56" x2={x0 - 2 * A - 6} y1={yB} y2={yB} class="lead" />
      <text x="36" y={yT - 8} text-anchor="middle" class="t mut">{T.surf}</text>
      <text x="36" y={yB + 16} text-anchor="middle" class="t mut">{T.surf}</text>
      {/* stress profile */}
      <path d={area} class="ac" clip-path="url(#qs-c)" />
      <path d={area} class="at" clip-path="url(#qs-t)" />
      <line x1={x0} x2={x0} y1={yT - 12} y2={yB + 8} class="zero" />
      <path d={'M' + pq.join(' L')} class="cq" />
      <path d={'M' + ps.join(' L')} class="cs" />
      <text x={x0 - 2 * A} y={yT + 31} class="t acc">{T.comp}</text>
      <text x={x0 + A + 6} y={yc + 4} class="t dat">{T.tens}</text>
      <text x={x0 - 2 * A} y={yB - 22} class="t acc">{T.comp}</text>
      <text x={x0 - 8} y={yB + 20} text-anchor="end" class="k">−</text>
      <text x={x0 + 8} y={yB + 20} class="k">+</text>
      <g transform={`translate(198 ${yT - 12})`} class="qleg">
        <line x1="0" x2="16" y1="0" y2="0" class="cq" /><text x="21" y="4" class="t">{T.q}</text>
        <line x1="0" x2="16" y1="15" y2="15" class="cs" /><text x="21" y="19" class="t">{T.s}</text>
      </g>
    </svg>
    <figcaption><b>{T.a}</b><span>{T.aT}</span></figcaption>
  </figure>
  <figure class="pn">
    <svg viewBox="0 0 300 190" role="img" aria-label={T.aria[1]}>
      <rect x={bx0 - 6} y="66" width={bx1 - bx0 + 12} height="68" class="stock" />
      <text x={bx0 - 6} y="58" class="t mut">{T.stock}</text>
      <path d={partPath(flat)} class="ghost" />
      <path d={ribPath(flat)} class="ghost" />
      <path d={partPath(yb)} fill="url(#ca-metal-h)" class="part" />
      <path d={ribPath(yb)} fill="url(#ca-metal-h)" class="part" />
      <line x1={bx1 + 14} x2={bx1 + 14} y1="128" y2={yb(bx1) + 2} class="arw" marker-end="url(#ca-arr-acc)" />
      <line x1={bx0 - 14} x2={bx0 - 14} y1="128" y2={yb(bx0) + 2} class="arw" marker-end="url(#ca-arr-acc)" />
      <text x="151" y="160" text-anchor="middle" class="t acc">{T.dist}</text>
      <text x="151" y="176" text-anchor="middle" class="t mut">{T.part}</text>
    </svg>
    <figcaption><b>{T.b}</b><span>{T.bT}</span></figcaption>
  </figure>
</div>

<style>
  .qs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  @media (max-width: 40rem) { .qs { grid-template-columns: minmax(0, 1fr); } }
  .pn { margin: 0; padding: 0.4rem 0.5rem 0.65rem; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; display: grid; gap: 0.35rem; }
  .pn svg { width: 100%; height: auto; display: block; }
  figcaption { display: grid; gap: 0.15rem; font-size: 0.82rem; color: var(--ink-2); line-height: 1.4; padding: 0 0.2rem; }
  figcaption b { color: var(--ink); font-weight: 600; }
  .lead { stroke: var(--ink-3); stroke-dasharray: 2 3; }
  .zero { stroke: #474e54; stroke-width: 1; }
  .ac { fill: color-mix(in oklab, #d4520f 26%, transparent); }
  .at { fill: color-mix(in oklab, #1e6fd6 26%, transparent); }
  .cq { fill: none; stroke: #e2601a; stroke-width: 2.2; stroke-linejoin: round; }
  .cs { fill: none; stroke: #1e6fd6; stroke-width: 2.2; stroke-linejoin: round; }
  .t { font-family: var(--font-mono); font-size: 11.5px; fill: var(--ink-2); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; }
  .qleg .t { font-size: 11px; }
  @media (max-width: 40rem) { .qleg .t { font-size: 11px; } }
  .k { font-family: var(--font-mono); font-size: 14px; fill: var(--ink-2); }
  .acc { fill: #e2601a; }
  .dat { fill: #2a78d6; }
  .mut { fill: var(--ink-3); }
  .stock { fill: none; stroke: #656e74; stroke-dasharray: 5 4; }
  .ghost { fill: none; stroke: #656e74; stroke-opacity: 0.6; stroke-dasharray: 2 3; }
  .part { stroke: #1b1d1e; stroke-width: 1.1; stroke-linejoin: round; }
  .arw { stroke: #e2601a; stroke-width: 1.4; }
  @media (max-width: 40rem) { .t { font-size: 12.5px; } }
</style>
