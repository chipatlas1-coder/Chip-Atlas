---
/**
 * Honing vs skiving and roller burnishing of a hydraulic cylinder tube (article table), schematic
 * longitudinal sections. Honing: stones pressed outward, tool rotates and strokes; abrasive, removes
 * material and corrects form. Skiving and roller burnishing: one tool passes through once; the
 * skiving knives cut the bore, the rollers behind them smooth it by plastic deformation.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? {
      hone: 'Honlama', skive: 'Soyma ve roleleme', stones: 'taşlar dışa bastırılır', motion: 'dönme + strok', knives: 'bıçaklar keser', rollers: 'makaralar düzgünleştirir', pass: 'tek geçiş',
      honeFacts: ['delik toleransı H8', 'Ra ≤ 0,3–0,4 µm', 'aşındırıcı: malzeme kaldırır, biçimi düzeltir'],
      skiveFacts: ['delik toleransı H8–H11 (Tenaris)', 'Ra ≤ 0,30 µm (Tenaris); 0,05–0,20 µm (Sunnen)', 'önce keser, sonra plastik şekil değiştirmeyle düzgünleştirir'],
    }
  : {
      hone: 'Honing', skive: 'Skiving and roller burnishing', stones: 'stones pressed outward', motion: 'rotation + stroke', knives: 'knives cut', rollers: 'rollers smooth', pass: 'one pass',
      honeFacts: ['bore tolerance H8', 'Ra ≤ 0.3–0.4 µm', 'abrasive: removes material, corrects form'],
      skiveFacts: ['bore tolerance H8 to H11 (Tenaris)', 'Ra ≤ 0.30 µm (Tenaris); 0.05–0.20 µm (Sunnen)', 'cuts first, then smooths by plastic deformation'],
    };
const rough = (y0: number, x0: number, x1: number, amp: number, step: number, sgn: 1 | -1) => {
  let d = `M${x0},${y0}`;
  for (let x = x0; x < x1; x += step) d += ` L${(x + step / 2).toFixed(1)},${(y0 + sgn * amp * (0.6 + 0.4 * Math.sin(x * 1.7))).toFixed(1)} L${(x + step).toFixed(1)},${y0}`;
  return d;
};
---
<div class="skr">
  <figure class="pn">
    <svg viewBox="0 0 340 210" role="img" aria-label={`${T.hone}: ${T.stones}, ${T.motion}`}>
      <defs>
        <pattern id={`sk-stone-${locale}`} width="5" height="5" patternUnits="userSpaceOnUse">
          <rect width="5" height="5" fill="#8a8173" /><circle cx="1.2" cy="1.4" r="0.7" fill="#d9d2c4" /><circle cx="3.6" cy="3.5" r="0.6" fill="#5d564b" />
        </pattern>
      </defs>
      <rect x="20" y="30" width="300" height="24" fill="url(#ca-hatch)" /><rect x="20" y="146" width="300" height="24" fill="url(#ca-hatch)" />
      <line x1="20" x2="320" y1="54" y2="54" class="wall" /><line x1="20" x2="320" y1="146" y2="146" class="wall" />
      <rect x="0" y="94" width="110" height="12" class="shaft" />
      <rect x="100" y="84" width="150" height="32" rx="3" class="body" />
      <rect x="128" y="56" width="96" height="11" rx="1.5" fill={`url(#sk-stone-${locale})`} class="stone" />
      <rect x="128" y="133" width="96" height="11" rx="1.5" fill={`url(#sk-stone-${locale})`} class="stone" />
      <rect x="140" y="67" width="10" height="17" class="hold" /><rect x="202" y="67" width="10" height="17" class="hold" />
      <rect x="140" y="116" width="10" height="17" class="hold" /><rect x="202" y="116" width="10" height="17" class="hold" />
      <line x1="176" x2="176" y1="92" y2="70" class="push" marker-end="url(#ca-arr-acc)" />
      <line x1="176" x2="176" y1="108" y2="130" class="push" marker-end="url(#ca-arr-acc)" />
      <path d="M38,82 A16,16 0 1,1 38,118" class="mot" marker-end="url(#ca-arr-data)" />
      <line x1="40" x2="96" y1="130" y2="130" class="mot" marker-start="url(#ca-arr-data)" marker-end="url(#ca-arr-data)" />
      <text x="230" y="24" text-anchor="middle" class="lab acc">{T.stones}</text>
      <text x="68" y="190" text-anchor="middle" class="lab dat">{T.motion}</text>
      <text x="10" y="16" class="ttl">{T.hone}</text>
    </svg>
    <ul class="facts">{T.honeFacts.map((x) => <li>{x}</li>)}</ul>
  </figure>
  <figure class="pn">
    <svg viewBox="0 0 340 210" role="img" aria-label={`${T.skive}: ${T.knives}, ${T.rollers}, ${T.pass}`}>
      <!-- tube: as drawn ahead of the knives (right), skived between, burnished behind (left) -->
      <rect x="20" y="30" width="300" height="24" fill="url(#ca-hatch)" /><rect x="20" y="146" width="300" height="24" fill="url(#ca-hatch)" />
      <rect x="236" y="54" width="84" height="5" fill="url(#ca-hatch)" /><rect x="236" y="141" width="84" height="5" fill="url(#ca-hatch)" />
      <path d={rough(59, 236, 320, 2.2, 7, 1)} class="wall rough" /><path d={rough(141, 236, 320, 2.2, 7, -1)} class="wall rough" />
      <path d={rough(54, 150, 236, 1.1, 4, 1)} class="wall" /><path d={rough(146, 150, 236, 1.1, 4, -1)} class="wall" />
      <line x1="20" x2="150" y1="54" y2="54" class="wall smooth" /><line x1="20" x2="150" y1="146" y2="146" class="wall smooth" />
      <rect x="0" y="94" width="130" height="12" class="shaft" />
      <rect x="120" y="80" width="126" height="40" rx="3" class="body" />
      {/* rollers */}
      {[[142, 61.5], [142, 138.5]].map(([x, y]) => <><circle cx={x} cy={y} r="7.5" class="roll" /><circle cx={x} cy={y} r="2" fill="#b1bac2" /></>)}
      <rect x="134" y="69" width="16" height="11" class="hold" /><rect x="134" y="120" width="16" height="11" class="hold" />
      {/* skiving knives */}
      <path d="M232,80 L232,62 L240,56 L246,62 L246,80 Z" class="knife" />
      <path d="M232,120 L232,138 L240,144 L246,138 L246,120 Z" class="knife" />
      <path d="M244,58 C252,48 262,52 258,60" class="chip" /><path d="M244,142 C252,152 262,148 258,140" class="chip" />
      <line x1="40" x2="104" y1="130" y2="130" class="mot" marker-end="url(#ca-arr-data)" />
      <text x="56" y="192" text-anchor="middle" class="lab dat">{T.pass}</text>
      <line x1="142" y1="147" x2="150" y2="180" class="lead" /><text x="150" y="192" text-anchor="middle" class="lab acc2">{T.rollers}</text>
      <line x1="240" y1="145" x2="256" y2="180" class="lead" /><text x="262" y="192" text-anchor="middle" class="lab acc">{T.knives}</text>
      <text x="10" y="16" class="ttl">{T.skive}</text>
    </svg>
    <ul class="facts">{T.skiveFacts.map((x) => <li>{x}</li>)}</ul>
  </figure>
</div>

<style>
  .skr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  @media (max-width: 40rem) { .skr { grid-template-columns: minmax(0, 1fr); } }
  .pn { margin: 0; padding: 0.5rem 0.6rem 0.65rem; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; display: grid; gap: 0.35rem; }
  svg { width: 100%; height: auto; display: block; }
  .wall { fill: none; stroke: #2c3033; stroke-width: 1.4; }
  .rough { stroke: #474e54; }
  .smooth { stroke: #1b1d1e; stroke-width: 1.8; }
  .shaft { fill: #cdd5db; stroke: #656e74; stroke-width: 1; }
  .body { fill: url(#ca-carbide); stroke: #2c3033; stroke-width: 1.1; }
  .stone { stroke: #1b1d1e; stroke-width: 1; }
  .hold { fill: #dee5ea; stroke: #656e74; stroke-width: 0.8; }
  .push { stroke: #e2601a; stroke-width: 1.8; }
  .mot { fill: none; stroke: #1e6fd6; stroke-width: 1.6; }
  .roll { fill: url(#ca-metal); stroke: #1b1d1e; stroke-width: 1.1; }
  .knife { fill: url(#ca-carbide); stroke: #1b1d1e; stroke-width: 1.1; stroke-linejoin: round; }
  .chip { fill: none; stroke: url(#ca-chip); stroke-width: 2.6; stroke-linecap: round; }
  .lead { stroke: #656e74; stroke-width: 0.9; }
  .ttl { font-family: var(--font-sans); font-size: 13px; font-weight: 600; fill: var(--ink); }
  .lab { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-2); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; }
  @media (max-width: 40rem) { .lab { font-size: 11.5px; } }
  .acc { fill: #e2601a; } .acc2 { fill: #1b1d1e; } .dat { fill: #2a78d6; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .facts li { margin: 0; font-size: 0.8rem; color: var(--ink-2); line-height: 1.35; }
  .facts li::before { content: none; }
</style>
