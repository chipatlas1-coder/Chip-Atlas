---
/**
 * Ordered troubleshooting checklist for use at the machine: each step has what to check and what to
 * do, with its sources, a pictogram and a tick box. A rail joins the steps in order and fills as they
 * are ticked; the header counts them. Ticks are a per-viewer convenience kept in localStorage under
 * `id` (wrapped in try/catch; the list works without it). A reset button clears them.
 */
type Icon = 'bottom' | 'chips' | 'hole' | 'align' | 'holder' | 'sync' | 'depth' | 'wear' | 'coolant' | 'hard' | 'overhang' | 'nose' | 'speed' | 'pitch' | 'clamp' | 'damper' | 'support' | 'edge' | 'feed' | 'osc';
interface Item { title: string; check: string; fix: string; src?: string; icon?: Icon }
interface Props { id: string; items: Item[]; locale: 'en' | 'tr' }
const { id, items, locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { check: 'Kontrol', fix: 'Çözüm', reset: 'İşaretleri temizle', done: 'kontrol edildi', of: 'kontrol edildi', all: 'Hepsi kontrol edildi' }
  : { check: 'Check', fix: 'Fix', reset: 'Clear ticks', done: 'checked', of: 'checked', all: 'All checked' };
// pictograms, 40 × 40: muted strokes for the part, accent for what goes wrong
const M = '#616a71', A = '#e2601a', F = 'rgba(197,204,209,0.14)';
const CHIP = 'M-6,1.5 C-4.5,-5 4,-7.5 7,-2 C9,2 5.5,7 0.5,6 C3.5,5 5,2 3.6,-0.6 C2,-3.2 -2.8,-2.6 -6,1.5 Z';   // the plates' chip curl
const s = (d: string, c = M, w = 1.5, extra = '') => `<path d="${d}" stroke="${c}" stroke-width="${w}" ${extra}/>`;
const ICON: Record<Icon, string> = {
  bottom: s('M10 7 V27 L20 33.5 L30 27 V7') + s('M15 2 V22.5 L17 29 H23 L25 22.5 V2', M, 1.5, `fill="${F}"`) + s('M15 8 h1.8 M15 12 h1.8 M15 16 h1.8 M15 20 h1.8 M25 8 h-1.8 M25 12 h-1.8 M25 16 h-1.8 M25 20 h-1.8', M, 1) + s('M15 22.5 L17 29 H23 L25 22.5', A, 1.8) + s('M16 31.2 l-2.2 2.4 M24 31.2 l2.2 2.4 M20 30.8 v3', A, 1.4),
  chips: s('M10 5 V30 Q10 34 14 34 H26 Q30 34 30 30 V5') + s('M15 2 V15 L17 20 H23 L25 15 V2', M, 1.5, `fill="${F}"`) + s('M15 6 h1.8 M15 10 h1.8 M25 6 h-1.8 M25 10 h-1.8', M, 1) + [[14.6, 30.4, 8, 0.5], [21.2, 31.2, -32, 0.5], [26, 26.6, 64, 0.44], [18.2, 25.2, 168, 0.42]].map(([x, y, r, k]) => `<path d="${CHIP}" fill="${A}" transform="translate(${x} ${y}) rotate(${r}) scale(${k})"/>`).join(''),
  hole: s('M20 6 a14 14 0 1 1 0 28 a14 14 0 1 1 0 -28', M, 1.3, 'stroke-dasharray="2.4 2.4"') + s('M20 11 a9 9 0 1 1 0 18 a9 9 0 1 1 0 -18', A, 1.8) + s('M5.5 20 H10 M8.2 18.2 L10 20 L8.2 21.8 M34.5 20 H30 M31.8 18.2 L30 20 L31.8 21.8', M, 1.3) + s('M18 20 h4 M20 18 v4', M, 1),
  align: s('M11 5 V35 M29 5 V35') + s('M20 2 V38', M, 1, 'stroke-dasharray="5 2 1 2"') + `<g transform="rotate(9 20 20)">${s('M16 2 V27 L18 31 H22 L24 27 V2', A, 1.6, `fill="${F}"`)}${s('M20 1 V35', A, 1, 'stroke-dasharray="5 2 1 2"')}</g>`,
  holder: s('M20 6 a14 14 0 1 1 0 28 a14 14 0 1 1 0 -28') + s('M14 14 H26 V26 H14 Z', M, 1.2, 'stroke-dasharray="2 2"') + s('M14 14 H26 V26 H14 Z', A, 1.6, `fill="${F}" transform="rotate(22 20 20)"`) + s('M28.5 5.3 A17 17 0 0 1 36 14.2 M36.9 10.7 L36 14.2 L33.1 12.1', A, 1.5),
  sync: s('M6 14 A7 7 0 1 1 13 21 M16 19 L13 21 L16 23') + s('M29 6 V24 M26.5 21.5 L29 24 L31.5 21.5') + s('M14.5 30 H25.5 M14.5 34 H25.5 M23 27 L17 37', A, 1.6),
  depth: `<rect x="14" y="20" width="12" height="14" fill="${A}" fill-opacity="0.2"/>` + s('M14 4 V34 H26 V4') + s('M7 20 H35', M, 1, 'stroke-dasharray="2 2"') + s('M31 20 V34 M29 22.4 L31 20 L33 22.4 M29 31.6 L31 34 L33 31.6', A, 1.5),
  wear: s('M4 33 H36', M, 1.2) + s('M15.6 16 L20 8 L24.4 16', M, 1.1, 'stroke-dasharray="2 2"') + s('M6 33 L15.6 16 M24.4 16 L34 33') + s('M15.6 16 Q20 12.4 24.4 16', A, 2),
  coolant: `<path d="M10.6 28 H29.4 A10 10 0 0 1 10.6 28 Z" fill="${A}" fill-opacity="0.32"/>` + s('M20 5 C17 10 10 17.5 10 24.5 A10 10 0 0 0 30 24.5 C30 17.5 23 10 20 5 Z') + s('M10.6 28 H29.4', A, 1.5),
  hard: s('M4 26 H36') + s('M7 37 L13 31 M13 37 L19 31 M19 37 L25 31 M25 37 L31 31 M31 37 L35 33', M, 1) + s('M17 26 L20 29 L23 26', M, 1.2) + s('M17 2 V6 M23 2 V6', M, 1.4) + s('M13 6 H27 L20 28.4 Z', A, 1.6, `fill="${A}" fill-opacity="0.22"`),
  // a bar clamped at the left, long overhang, bending at the tip
  overhang: `<rect x="3" y="12" width="9" height="16" fill="${F}" stroke="${M}" stroke-width="1.5"/>` + s('M12 17 H24 Q30 17.5 35 21 M12 23 H24 Q30 23.5 35 27', M, 1.5) + s('M12 17 H35 M12 23 H35', M, 1, 'stroke-dasharray="2 2"') + s('M14 33 H34 M16 31 L14 33 L16 35 M32 31 L34 33 L32 35', A, 1.4),
  // a large and a small nose radius on the same corner
  nose: s('M6 34 L20 8 L34 34', M, 1.1, 'stroke-dasharray="2 2"') + s('M6 34 L15.5 16.5 Q20 9 24.5 16.5 L34 34', M, 1.5) + s('M14.8 18 Q20 7.2 25.2 18', A, 2) + s('M18.2 12.4 Q20 8.6 21.8 12.4', M, 1.4),
  // a speed dial with the needle moved
  speed: s('M7 28 A14 14 0 1 1 33 28', M, 1.5) + s('M20 26 L28 15', A, 2) + `<circle cx="20" cy="26" r="2.2" fill="${A}"/>` + s('M10 22 l2 1 M14 13.5 l1.5 1.6 M20 10 v2 M26 13.5 l-1.5 1.6 M30 22 l-2 1', M, 1.2),
  // a cutter seen from the end with unequal tooth spacing
  pitch: s('M20 6 a14 14 0 1 1 0 28 a14 14 0 1 1 0 -28', M, 1.3) + [0, 80, 150, 235, 300].map((a) => { const r = (a * Math.PI) / 180, x = 20 + 14 * Math.cos(r), y = 20 + 14 * Math.sin(r); return s(`M${(20 + 9 * Math.cos(r)).toFixed(1)} ${(20 + 9 * Math.sin(r)).toFixed(1)} L${x.toFixed(1)} ${y.toFixed(1)}`, A, 2); }).join('') + `<circle cx="20" cy="20" r="3" fill="${F}" stroke="${M}" stroke-width="1.2"/>`,
  // a vice holding a thin part
  clamp: s('M4 32 H36', M, 1.2) + `<rect x="6" y="14" width="8" height="18" fill="${F}" stroke="${M}" stroke-width="1.5"/><rect x="26" y="14" width="8" height="18" fill="${F}" stroke="${M}" stroke-width="1.5"/>` + s('M14 18 H26 V30 H14', A, 1.6) + s('M34 23 H38 M2 23 H6', M, 1.4),
  // a spring and damper between two plates
  damper: s('M6 6 H34 M6 34 H34', M, 1.6) + s('M13 6 V10 L9 13 L17 17 L9 21 L17 25 L13 28 V34', M, 1.3) + s('M27 6 V15 M23 15 H31 V24 H23 Z M27 20 V34', A, 1.5),
  // a long part between centres with a steady rest
  support: `<rect x="5" y="16" width="30" height="8" rx="1.5" fill="${F}" stroke="${M}" stroke-width="1.4"/>` + s('M2 20 L5 17 V23 Z M38 20 L35 17 V23 Z', M, 1.3) + s('M16 24 L13 32 H27 L24 24', A, 1.6) + s('M20 24 v3', A, 1.4),
  // a sharp positive edge against a blunt one
  feed: s('M4 28 H36', M, 1.2) + s('M20 6 L27 26 H13 Z', M, 1.5, `fill="${F}"`) + s('M21 26 Q26 20 31 22', M, 1.1) + s('M32 34 H9 M12.4 31.4 L9 34 L12.4 36.6', A, 1.8),
  osc: s('M4 34 H36', M, 1.2) + s('M4 20 Q8.5 9 13 20 T22 20 T31 20 T38 18', A, 1.8) + s('M26 6 L31 15 H21 Z', M, 1.4, `fill="${F}"`) + s('M8 28 v-4 M17 28 v-2 M26 28 v-4', M, 1.1, 'stroke-dasharray="1.5 1.5"'),
  edge: s('M6 30 L20 8 L34 30', M, 1.1, 'stroke-dasharray="2 2"') + s('M20 8 L12 34', A, 2) + s('M20 8 L34 30', M, 1.5) + s('M18 13 Q22 10 25 14', M, 1.2),
};
const svg = (k: Icon) => `<svg viewBox="0 0 40 40" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[k]}</svg>`;
---
<div class="cl" data-cl={id} data-anim data-of={T.of} data-all={T.all}>
  <div class="head">
    <div class="meter" role="progressbar" aria-valuemin="0" aria-valuemax={items.length} aria-valuenow="0" aria-label={T.of}><i></i></div>
    <span class="count" aria-live="polite"><b data-count>0</b> / {items.length} {T.of}</span>
    <button type="button" class="reset" data-reset hidden>{T.reset}</button>
  </div>
  <ol>
    {items.map((it, i) => (
      <li style={`--i:${i}`} class:list={{ ic: it.icon }}>
        <label class="tick"><input type="checkbox" data-k={i} aria-label={`${it.title}: ${T.done}`} /><span aria-hidden="true"></span></label>
        <div class="body">
          <p class="t"><b class="n">{String(i + 1).padStart(2, '0')}</b>{it.title}</p>
          <dl>
            <div><dt>{T.check}</dt><dd>{it.check}</dd></div>
            <div><dt>{T.fix}</dt><dd>{it.fix}</dd></div>
          </dl>
          {it.src && <p class="src">{it.src}</p>}
        </div>
        {it.icon && <span class="pic" set:html={svg(it.icon)} />}
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cl]').forEach((root) => {
    const key = `ca-checklist-${root.dataset.cl}`;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const meter = root.querySelector<HTMLElement>('.meter')!;
    const count = root.querySelector<HTMLElement>('.count')!;
    const total = boxes.length;
    let saved: number[] = [];
    try { saved = JSON.parse(localStorage.getItem(key) || '[]'); } catch { saved = []; }
    const sync = () => {
      const on = boxes.filter((b) => b.checked).map((b) => Number(b.dataset.k));
      boxes.forEach((b) => b.closest('li')!.classList.toggle('on', b.checked));
      reset.hidden = on.length === 0;
      meter.style.setProperty('--p', String(on.length / total));
      meter.setAttribute('aria-valuenow', String(on.length));
      root.classList.toggle('all', on.length === total);
      count.innerHTML = on.length === total ? root.dataset.all! : `<b>${on.length}</b> / ${total} ${root.dataset.of}`;
      try { localStorage.setItem(key, JSON.stringify(on)); } catch { /* storage unavailable */ }
    };
    boxes.forEach((b) => { if (saved.includes(Number(b.dataset.k))) b.checked = true; b.addEventListener('change', sync); });
    reset.addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); sync(); });
    sync();
  });
</script>

<style>
  .cl { display: grid; gap: 0.7rem; }
  .head { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  .meter { flex: 1 1 6rem; height: 4px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .meter i { display: block; height: 100%; width: 100%; background: var(--data); border-radius: inherit; transform-origin: 0 50%; transform: scaleX(var(--p, 0)); transition: transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 200ms; }
  .count { font: 0.78rem var(--font-mono); color: var(--ink-3); white-space: nowrap; }
  .count :global(b) { color: var(--ink); font-weight: 500; }
  .cl.all .count { color: var(--data); }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; counter-reset: none; }
  li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; padding: 0.85rem 1rem 0.9rem 0.85rem; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 6px; transition: border-color 160ms, background-color 160ms, opacity 160ms; }
  li.ic { grid-template-columns: auto 1fr auto; }
  li::before { content: none !important; }
  /* the rail: from below this step's tick to the next step's tick; it fills once the step is ticked */
  li:not(:last-child)::after { content: ''; position: absolute; z-index: 1; left: calc(0.85rem + 0.675rem - 0.75px); top: 2.55rem; bottom: -1.45rem; width: 1.5px; background: var(--line-strong); transition: background-color 200ms; }
  li.on:not(:last-child)::after { background: var(--data); }
  li.on { border-color: color-mix(in oklab, var(--data) 45%, var(--line)); background: color-mix(in oklab, var(--data) 5%, var(--bg-raised)); }
  li.on .t, li.on dl, li.on .pic { opacity: 0.62; }
  .tick { position: relative; z-index: 2; width: 1.35rem; height: 1.35rem; margin-top: 0.1rem; cursor: pointer; }
  .tick input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .tick span { position: absolute; inset: 0; pointer-events: none; border: 1.5px solid var(--line-strong); border-radius: 4px; background: var(--bg-raised); transition: background-color 160ms, border-color 160ms; }
  .tick:hover span { border-color: var(--data); }
  .tick input:checked + span { background: var(--data); border-color: var(--data); }
  .tick input:checked + span::after { content: ''; position: absolute; left: 0.42rem; top: 0.16rem; width: 0.32rem; height: 0.66rem; border: solid #fbfdff; border-width: 0 2px 2px 0; transform: rotate(42deg); }
  .tick input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .body { display: grid; gap: 0.35rem; min-width: 0; }
  .t { margin: 0; font-weight: 600; color: var(--ink); font-size: 0.98rem; line-height: 1.35; }
  .n { font-family: var(--font-mono); font-weight: 500; font-size: 0.78rem; color: var(--color-spark-400); margin-right: 0.55rem; }
  dl { margin: 0; display: grid; gap: 0.3rem; }
  dl div { display: grid; grid-template-columns: 4.6rem 1fr; gap: 0.6rem; font-size: 0.9rem; line-height: 1.45; }
  @media (max-width: 30rem) { dl div { grid-template-columns: 1fr; gap: 0.05rem; } }
  dt { font: 500 0.72rem var(--font-mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.05em; padding-top: 0.2rem; }
  dd { margin: 0; color: var(--ink-2); }
  .src { margin: 0; font: 0.74rem var(--font-mono); color: var(--ink-3); }
  .pic { display: grid; place-items: center; width: 3.3rem; height: 3.3rem; border-radius: 8px; border: 1px solid var(--line); background: color-mix(in oklab, var(--ink) 3%, transparent); transition: opacity 160ms, border-color 160ms; }
  .pic :global(svg) { width: 2.65rem; height: 2.65rem; }
  li:hover .pic { border-color: var(--line-strong); }
  @media (max-width: 30rem) { .count { font-size: 0.72rem; } .pic { width: 2.4rem; height: 2.4rem; } .pic :global(svg) { width: 1.85rem; height: 1.85rem; } li.ic { gap: 0.6rem; } }
  .reset { font-size: 0.8rem; padding: 0.3rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink-2); background: transparent; }
  .reset:hover { border-color: var(--accent); color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .tick input:checked + span::after { animation: cl-tick 0.28s cubic-bezier(0.2, 0.8, 0.2, 1); }
  }
  @keyframes cl-tick { 0% { transform: rotate(42deg) scale(0); } 70% { transform: rotate(42deg) scale(1.25); } to { transform: rotate(42deg) scale(1); } }
  :global(html.anim) .cl[data-anim]:not([data-in]) :is(li, .head) { opacity: 0; }
  :global(html.anim) .cl[data-anim][data-in] li { animation: ca-rise 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; animation-delay: calc(0.1s + var(--i) * 55ms); }
  :global(html.anim) .cl[data-anim][data-in] .head { animation: ca-fade 0.4s backwards; }
</style>
