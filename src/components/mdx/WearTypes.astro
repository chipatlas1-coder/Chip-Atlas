---
/**
 * The eight wear types of the article's table, each drawn on the same insert corner
 * (main cutting edge on the right). Worn or damaged areas are bright metal or dark gaps,
 * outlined in orange.
 */
import { insertCorner, type V3 } from '../plates/insertgeom';
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const g = insertCorner({ cx: 74, cy: 104, k: 0.62 });
const { path, onMain, onRake, P, f1 } = g;
const names = tr
  ? ['Serbest yüzey aşınması', 'Krater aşınması', 'Çentik aşınması', 'Plastik deformasyon', 'Kenar ufalanması', 'Termal çatlaklar', 'Yığıntı talaş', 'Kırılma']
  : ['Flank wear', 'Crater wear', 'Notch wear', 'Plastic deformation', 'Chipping', 'Thermal cracks', 'Built-up edge', 'Fracture'];
const looks = tr
  ? ['Kenar çizgisinden aşağı büyüyen aşınma bandı', 'Talaş yüzeyinde kenarın arkasında çukur', 'Kesme derinliği çizgisinde yerel hasar', 'Kenar çöker; biçim kalıcı olarak değişir', 'Kenar çizgisinden küçük parçalar kopar', 'Kenara yaklaşık dik, tarak dişi gibi çatlaklar', 'Talaş yüzeyine ya da kenara kaynamış iş malzemesi', 'Kenarın büyük bir kısmı kopar']
  : ['Wear land growing down from the edge line', 'Depression on the rake face behind the edge', 'Local damage at the depth-of-cut line', 'The edge sags; its shape changes for good', 'Small pieces broken out of the edge line', 'Cracks roughly across the edge, like comb teeth', 'Work material welded to the rake face or edge', 'A large part of the edge broken away'];
const poly = (pts: V3[]) => path(pts as number[][]);
const line = (a: V3, b: V3) => `M${f1(P(...a))} L${f1(P(...b))}`;
// 1 flank wear land
const flank = poly([onMain(6, 0.2), onMain(190, 0.2), onMain(190, -22), onMain(6, -22)]);
// 2 crater
const crater = poly(Array.from({ length: 40 }, (_, i) => { const u = (2 * Math.PI * i) / 40; return onRake(110 + 72 * Math.cos(u), 26 + 12 * Math.sin(u)); }));
const craterIn = poly(Array.from({ length: 40 }, (_, i) => { const u = (2 * Math.PI * i) / 40; return onRake(112 + 52 * Math.cos(u), 26 + 7 * Math.sin(u)); }));
// 3 notch at the depth-of-cut line
const notch = poly([onMain(184, 0.3), onMain(212, 0.3), onMain(199, -40)]);
const notchCut = poly([onRake(186, 0), onRake(210, 0), onRake(198, 10)]);
// 4 plastic deformation: edge pushed down near the nose, flank bulges
const sag = Array.from({ length: 16 }, (_, i) => { const d = -10 + i * 12; const z = -18 * Math.exp(-((d - 40) ** 2) / 2600); return onMain(d, z); });
const sagFill = poly([onMain(-10, 0.3), ...sag, onMain(170, 0.3)]);
const bulge = Array.from({ length: 16 }, (_, i) => { const d = -10 + i * 12; const z = -18 * Math.exp(-((d - 40) ** 2) / 2600) - 26; const p = onMain(d, z); return [p[0] + g.nm[0] * 5 * Math.exp(-((d - 40) ** 2) / 2600), p[1] + g.nm[1] * 5 * Math.exp(-((d - 40) ** 2) / 2600), p[2]] as V3; });
// 5 chipping: small bites out of the edge
const bites = [22, 64, 96, 140, 176].map((d, i) => { const w = [18, 12, 22, 14, 16][i]; return poly([onMain(d - w / 2, 0.3), onMain(d + w / 2, 0.3), onMain(d + w / 4, -w * 0.9), onRake(d, w * 0.7)]); });
// 6 thermal cracks across the edge
const cracks = [16, 38, 60, 82, 104, 126, 148, 170].map((d, i) => `${line(onRake(d, 18 + (i % 3) * 6), onMain(d, 0))} ${line(onMain(d, 0), onMain(d + 2, -24 - (i % 2) * 12))}`).join(' ');
// 7 built-up edge
const bue = poly([onMain(-4, 0.5), onMain(96, 0.5), onRake(90, 14), onRake(70, 30), onRake(36, 32), onRake(4, 16)].map((p, i) => [p[0], p[1], i < 2 ? 0.5 : 14] as V3));
// 8 fracture: the corner broken away, jagged boundary across rake face and both flanks
const fr1 = onMain(78, 0.4), fr2 = onRake(60, 34), fr3 = onRake(10, 58);
const sAt = (d: number, z: number): V3 => { const p = [g.s[0] * (g.t + d), g.s[1] * (g.t + d)]; const q = [p[0] - g.ns[0] * (-z * g.cl), p[1] - g.ns[1] * (-z * g.cl)]; return [q[0], q[1], z]; };
const frac = poly([fr1, onMain(66, -14), onMain(52, -26), onMain(30, -44), onMain(0, -62), [0, -14, -62], sAt(0, -62), sAt(18, -40), sAt(34, -18), sAt(48, 0.4), fr3, fr2]);
const panels = [flank, crater, notch, sagFill, '', '', bue, frac];
---
<ul class="weartypes" aria-label={tr ? 'Sekiz aşınma tipi' : 'Eight wear types'}>
  {names.map((name, i) => (
    <li>
      <svg viewBox="0 0 240 170" role="img" aria-label={`${name}: ${looks[i]}`}>
        <path d={poly(g.minorFlank as V3[])} fill="#e2e8ed" />
        <path d={poly(g.noseFlank as V3[])} fill="#c8d1d7" />
        <path d={poly(g.mainFlank as V3[])} fill="url(#ca-carbide)" />
        <path d={poly(g.top as V3[])} fill="url(#ca-face)" />
        {i === 0 && <path d={flank} fill="#f6d9c8" fill-opacity="0.95" stroke="#e2601a" stroke-width="1.2" />}
        {i === 1 && <><path d={crater} fill="#f5f9fd" stroke="#e2601a" stroke-width="1.2" /><path d={craterIn} fill="#fbfdff" /></>}
        {i === 2 && <><path d={notch} fill="#f6d9c8" stroke="#e2601a" stroke-width="1.2" /><path d={notchCut} fill="#7d8893" /></>}
        {i === 3 && <><path d={sagFill} fill="#fbfdff" fill-opacity="0.55" /><path d={'M' + sag.map((p) => f1(P(...p))).join(' L')} fill="none" stroke="#e2601a" stroke-width="1.6" /><path d={'M' + bulge.map((p) => f1(P(...p))).join(' L')} fill="none" stroke="#e2601a" stroke-width="1.1" stroke-dasharray="3 3" /></>}
        {i === 4 && bites.map((b) => <path d={b} fill="#fbfdff" stroke="#e2601a" stroke-width="1.1" />)}
        {i === 5 && <path d={cracks} fill="none" stroke="#e2601a" stroke-width="1.3" />}
        {i === 6 && <path d={bue} fill="url(#ca-metal)" stroke="#e2601a" stroke-width="1.2" />}
        {i === 7 && <path d={frac} fill="#fbfdff" stroke="#e2601a" stroke-width="1.4" stroke-linejoin="round" />}
      </svg>
      <span class="n">{name}</span>
      <span class="l">{looks[i]}</span>
    </li>
  ))}
</ul>

<style>
  .weartypes { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem 0.75rem; }
  @media (max-width: 52rem) { .weartypes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .weartypes li { display: grid; gap: 0.25rem; align-content: start; }
  .weartypes svg { width: 100%; height: auto; background: #fbfdff; border: 1px solid var(--line); border-radius: 6px; }
  .n { font-weight: 600; font-size: 0.86rem; color: var(--ink); margin-top: 0.2rem; }
  .l { font-size: 0.78rem; color: var(--ink-3); line-height: 1.35; }
</style>
