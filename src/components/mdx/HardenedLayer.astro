---
/**
 * Work hardening in austenitic stainless steel, schematic: the previous pass leaves a hardened
 * layer under the machined surface. Left: the depth of cut reaches below the layer and the edge
 * cuts softer material. Right: a light cut stays inside the layer, the edge rubs and hardens it
 * further. No dimensions: the layer depth depends on tool, feed and wear.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? {
      layer: 'pekleşmiş tabaka', good: 'Kesme derinliği tabakanın altında', goodT: 'Kenar daha yumuşak malzemeyi keser; talaş düzgün akar.',
      bad: 'Kesme derinliği tabakanın içinde', badT: 'Kenar sertleşmiş malzemede sürtünür; ısınır, tabakayı daha da sertleştirir ve hızla aşınır.',
      ap: 'ap', aria: ['Kesme derinliği pekleşmiş tabakanın altında', 'Kesme derinliği pekleşmiş tabakanın içinde'],
    }
  : {
      layer: 'work-hardened layer', good: 'Depth of cut below the layer', goodT: 'The edge cuts softer material underneath; the chip flows cleanly.',
      bad: 'Depth of cut inside the layer', badT: 'The edge rubs in hardened material; it heats up, hardens the layer further and wears fast.',
      ap: 'ap', aria: ['Depth of cut below the work-hardened layer', 'Depth of cut inside the work-hardened layer'],
    };
const panels = [
  { ok: true, title: T.good, text: T.goodT, edgeY: 104, aria: T.aria[0] },
  { ok: false, title: T.bad, text: T.badT, edgeY: 84, aria: T.aria[1] },
];
const yS = 72, layer = 22; // machined surface and layer thickness (schematic)
const f1 = (v: number) => v.toFixed(1);
// chip for the good case: shear plane from the uncut surface to the edge (shear angle 45°), then the
// chip runs up the rake face and curls away (same construction as the Fundamentals emblem)
function chipPath(tx: number, ty: number) {
  const ra = Math.atan(6 / 64), u = [Math.sin(ra), -Math.cos(ra)], nn = [-Math.cos(ra), -Math.sin(ra)];
  const ap = ty - yS, phi = Math.PI / 4, S = [tx - ap / Math.tan(phi), yS];
  const hc = 0.8 * ap, lc = 36, R0 = 24; // schematic: chip about as thick as the uncut layer
  const at = (s: number, k: number) => [tx + s * u[0] + k * nn[0], ty + s * u[1] + k * nn[1]];
  const C = at(lc, hc / 2 + R0);
  const curl = (k: number) => Array.from({ length: 33 }, (_, i) => {
    const th = (0.95 * Math.PI * i) / 32, R = R0 * (1 - 0.18 * th / Math.PI), t = (hc / 2) * (1 - 0.25 * th / Math.PI);
    const v = [Math.cos(th) * -nn[0] + Math.sin(th) * -nn[1], -Math.sin(th) * -nn[0] + Math.cos(th) * -nn[1]];
    return [C[0] + (R + k * t) * v[0], C[1] + (R + k * t) * v[1]];
  });
  const pts = [[tx, ty], ...curl(1), ...curl(-1).reverse(), S];
  return 'M' + pts.map((p) => `${f1(p[0])},${f1(p[1])}`).join(' L') + ' Z';
}
---
<div class="hl">
  {panels.map((p) => {
    const tip = [196, p.edgeY];
    const tool = `M${tip[0]},${tip[1]} L${tip[0] + 6},${tip[1] - 64} L${tip[0] + 74},${tip[1] - 64} L${tip[0] + 74},${tip[1] - 6} Z`;
    // uncut layer between the machined surface and the edge depth, cut away to the right of the tool
    const work = `M8,${yS} L${tip[0]},${yS} L${tip[0]},${tip[1]} L292,${tip[1]} L292,170 L8,170 Z`;
    const chip = p.ok ? chipPath(tip[0], tip[1]) : '';
    return (
      <figure class:list={['pn', { ok: p.ok }]}>
        <svg viewBox="0 0 300 180" role="img" aria-label={p.aria}>
          <path d={work} fill="url(#ca-hatch)" />
          {/* hardened layer under the machined surface (left of the tool) and ahead of the edge */}
          <rect x="8" y={yS} width={tip[0] - 8} height={layer} class="lay" />
          <rect x={tip[0]} y={p.edgeY} width={292 - tip[0]} height={Math.max(0, yS + layer - p.edgeY)} class="lay" />
          <rect x={tip[0]} y={p.edgeY} width={292 - tip[0]} height="7" class="lay2" />
          <path d={`M8,${yS} L${tip[0]},${yS} L${tip[0]},${tip[1]} L292,${tip[1]}`} class="edge" />
          <line x1="8" x2={p.ok ? tip[0] - (tip[1] - yS) + (yS + layer - yS) : tip[0]} y1={yS + layer} y2={yS + layer} class="lb" />
          {chip && <path d={chip} fill="url(#ca-chip)" class="cedge" />}
          <path d={tool} fill="url(#ca-carbide)" class="tedge" />
          {!p.ok && <g class="heat">{[0, 1, 2].map((k) => <path d={`M${tip[0] - 4 + k * 8},${tip[1] + 6} q4,6 0,12`} />)}</g>}
          {/* ap dimension */}
          <line x1="22" x2="22" y1={yS} y2={tip[1]} class="dim" marker-start="url(#ca-arr)" marker-end="url(#ca-arr)" />
          <text x="28" y={(yS + tip[1]) / 2 + 4} class="t">{T.ap}</text>
          <text x="40" y={yS + layer + 17} class="t acc">{T.layer}</text>
          <g transform={`translate(270 22)`}>
            <circle r="11" class:list={['badge', { ok: p.ok }]} />
            {p.ok ? <path d="M-5,0 L-1.5,4 L5,-4" class="mk" /> : <path d="M-4,-4 L4,4 M4,-4 L-4,4" class="mk" />}
          </g>
        </svg>
        <figcaption><b>{p.title}</b><span>{p.text}</span></figcaption>
      </figure>
    );
  })}
</div>

<style>
  .hl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  @media (max-width: 40rem) { .hl { grid-template-columns: minmax(0, 1fr); } }
  .pn { margin: 0; padding: 0.4rem 0.5rem 0.65rem; background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 6px; display: grid; gap: 0.35rem; }
  .pn svg { width: 100%; height: auto; display: block; }
  figcaption { display: grid; gap: 0.15rem; font-size: 0.82rem; color: var(--ink-2); line-height: 1.4; padding: 0 0.2rem; }
  figcaption b { color: var(--ink); font-weight: 600; }
  .lay { fill: color-mix(in oklab, #d4520f 30%, transparent); }
  .lay2 { fill: color-mix(in oklab, #d4520f 18%, transparent); }
  .lb { stroke: #e2601a; stroke-dasharray: 4 3; stroke-width: 1; }
  .edge { fill: none; stroke: #2c3033; stroke-width: 1.6; stroke-linejoin: round; }
  .cedge { stroke: #1b1d1e; stroke-width: 1; stroke-linejoin: round; }
  .tedge { stroke: #1b1d1e; stroke-width: 1.4; stroke-linejoin: round; }
  .heat path { fill: none; stroke: #e2601a; stroke-width: 1.6; stroke-linecap: round; }
  .dim { stroke: #474e54; stroke-width: 1; }
  .t { font-family: var(--font-mono); font-size: 12px; fill: var(--ink-2); paint-order: stroke; stroke: #f7fbfe; stroke-width: 3px; }
  .t.acc { fill: #e2601a; }
  .badge { fill: color-mix(in oklab, #d4520f 25%, #f9fbfe); stroke: #d4520f; }
  .badge.ok { fill: color-mix(in oklab, #1e6fd6 25%, #f9fbfe); stroke: #1e6fd6; }
  .mk { fill: none; stroke: #1b1d1e; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 40rem) { .t { font-size: 13px; } }
</style>
