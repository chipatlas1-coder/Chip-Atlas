---
/**
 * Taylor tool life V·T^n = C on log–log axes. Example lines use Groover's representative
 * values (steel work, f = 0.25 mm/rev, d = 2.5 mm); the reader's own line is drawn from n and C.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const L = tr
  ? { n: 'Üs n', C: 'Sabit C (m/min)', V: 'Kesme hızı V (m/min)', T: 'Takım ömrü T', Vat: 'Bu hızda takım ömrü', V15: '15 min ömür için hız', x: 'Takım ömrü T (min, log)', y: 'Kesme hızı V (m/min, log)', hss: 'HSS', wc: 'Karbür', cer: 'Seramik', you: 'Sizin doğrunuz', aria: 'Taylor takım ömrü doğruları, log–log' }
  : { n: 'Exponent n', C: 'Constant C (m/min)', V: 'Cutting speed V (m/min)', T: 'Tool life T', Vat: 'Tool life at this speed', V15: 'Speed for 15 min life', x: 'Tool life T (min, log)', y: 'Cutting speed V (m/min, log)', hss: 'HSS', wc: 'Carbide', cer: 'Ceramic', you: 'Your line', aria: 'Taylor tool life lines, log–log' };
---
<div class="taylor" data-taylor data-locale={locale} data-l={JSON.stringify(L)}>
  <svg viewBox="0 0 640 360" role="img" aria-label={L.aria} data-svg></svg>
  <div class="controls">
    <label class="field"><span>{L.n} <output class="num" data-o="n">{tr ? '0,25' : '0.25'}</output></span><input id={`tay-n-${locale}`} type="range" min="0.05" max="0.8" step="0.005" value="0.25" data-i="n" /></label>
    <label class="field"><span>{L.C} <output class="num" data-o="C">500</output></span><input id={`tay-C-${locale}`} type="range" min="20" max="3000" step="10" value="500" data-i="C" /></label>
    <label class="field"><span>{L.V}</span><input id={`tay-V-${locale}`} type="number" min="1" step="1" value="250" data-i="V" /></label>
  </div>
  <dl class="read">
    <div><dt>{L.Vat}</dt><dd class="num" data-o="T">—</dd></div>
    <div><dt>{L.V15}</dt><dd class="num" data-o="V15">—</dd></div>
  </dl>
</div>

<style>
  .taylor { display: grid; gap: 0.75rem; }
  .controls { display: grid; grid-template-columns: 1fr 1fr 10rem; gap: 1rem; align-items: end; }
  @media (max-width: 40rem) { .controls { grid-template-columns: 1fr; } }
  .controls .field > span { display: flex; gap: 0.35rem; font-size: 0.85rem; }
  .controls output { color: var(--data); }
  .read { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  .read dt { font-size: 0.78rem; color: var(--ink-3); }
  .read dd { color: var(--data); font-size: 1.15rem; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-taylor]').forEach((root) => {
    const L = JSON.parse(root.dataset.l!);
    const tr = root.dataset.locale === 'tr';
    const svg = root.querySelector('[data-svg]') as SVGSVGElement;
    const i = (k: string) => root.querySelector(`[data-i="${k}"]`) as HTMLInputElement;
    const o = (k: string) => root.querySelector(`[data-o="${k}"]`) as HTMLElement;
    const dec = (s: string) => (tr ? s.replace('.', ',') : s);
    // Axes: T 1…1000 min, V 10…5000 m/min. Geometry follows the rendered width (phones get a 360-wide view).
    const tMin = 0, tMax = 3, vMin = 1, vMax = Math.log10(5000);
    let x0 = 80, x1 = 600, y0 = 310, y1 = 30, fs = 12.5;
    const X = (T: number) => x0 + ((Math.log10(T) - tMin) / (tMax - tMin)) * (x1 - x0);
    const Y = (V: number) => y0 - ((Math.log10(V) - vMin) / (vMax - vMin)) * (y0 - y1);
    const line = (n: number, C: number) => { // V = C / T^n, clipped to the frame
      const pts: string[] = [];
      for (let k = 0; k <= 90; k++) {
        const T = 10 ** (tMin + (k / 90) * (tMax - tMin));
        const V = C / T ** n;
        if (V < 10 || V > 5000) continue;
        pts.push(`${X(T).toFixed(1)} ${Y(V).toFixed(1)}`);
      }
      return pts.length ? 'M' + pts.join(' L') : '';
    };
    const examples = [
      { n: 0.125, C: 70, label: L.hss },
      { n: 0.25, C: 500, label: L.wc },
      { n: 0.6, C: 3000, label: L.cer },
    ];
    let narrow = false;
    function geometry() {
      narrow = svg.clientWidth > 0 && svg.clientWidth < 520;
      if (narrow) { x0 = 44; x1 = 334; y0 = 252; y1 = 34; fs = 12; svg.setAttribute('viewBox', '0 0 360 300'); }
      else { x0 = 80; x1 = 600; y0 = 310; y1 = 30; fs = 12.5; svg.setAttribute('viewBox', '0 0 640 360'); }
    }
    function render() {
      const n = Number(i('n').value), C = Number(i('C').value), V = Number(i('V').value);
      o('n').textContent = dec(n.toFixed(3));
      o('C').textContent = String(C);
      const T = (C / V) ** (1 / n);
      o('T').textContent = Number.isFinite(T) ? dec(T >= 100 ? T.toFixed(0) : T >= 10 ? T.toFixed(1) : T.toFixed(2)) + ' min' : '—';
      o('V15').textContent = dec((C / 15 ** n).toFixed(0)) + ' m/min';
      const font = `font-family="IBM Plex Mono, monospace" font-size="${fs}"`;
      const halo = 'style="paint-order:stroke;stroke:#f9fbfe;stroke-width:3.5px"';
      const p: string[] = [];
      // faint 2 and 5 subdivisions, then the decades
      for (const d of [1, 10, 100]) for (const m of [2, 5]) p.push(`<line x1="${X(d * m)}" x2="${X(d * m)}" y1="${y1}" y2="${y0}" stroke="var(--line)" stroke-opacity="0.45"/>`);
      for (const d of [10, 100, 1000]) for (const m of [2, 5]) if (d * m < 5000) p.push(`<line x1="${x0}" x2="${x1}" y1="${Y(d * m)}" y2="${Y(d * m)}" stroke="var(--line)" stroke-opacity="0.45"/>`);
      for (const Tt of [1, 10, 100, 1000]) p.push(`<line x1="${X(Tt)}" x2="${X(Tt)}" y1="${y1}" y2="${y0}" stroke="var(--line)"/><text x="${X(Tt)}" y="${y0 + 18}" ${font} fill="var(--ink-3)" text-anchor="middle">${Tt}</text>`);
      for (const Vv of [10, 100, 1000]) p.push(`<line x1="${x0}" x2="${x1}" y1="${Y(Vv)}" y2="${Y(Vv)}" stroke="var(--line)"/><text x="${x0 - 7}" y="${Y(Vv) + 4}" ${font} fill="var(--ink-3)" text-anchor="end">${Vv}</text>`);
      p.push(`<rect x="${x0}" y="${y1}" width="${x1 - x0}" height="${y0 - y1}" fill="none" stroke="var(--ink-3)"/>`);
      examples.forEach((e) => {
        p.push(`<path d="${line(e.n, e.C)}" fill="none" stroke="var(--ink-3)" stroke-width="1.5" stroke-dasharray="5 4"/>`);
        const Tl = 1.6, Vl = e.C / Tl ** e.n;
        if (Vl > 10 && Vl < 5000) p.push(`<text x="${X(Tl) + 4}" y="${Y(Vl) - 8}" ${font} fill="var(--ink-2)" ${halo}>${e.label} n=${dec(String(e.n))}</text>`);
      });
      p.push(`<path d="${line(n, C)}" fill="none" stroke="var(--accent)" stroke-width="2.5"/>`);
      if (Number.isFinite(T) && T >= 1 && T <= 1000 && V >= 10 && V <= 5000) {
        p.push(`<line x1="${x0}" x2="${X(T)}" y1="${Y(V)}" y2="${Y(V)}" stroke="var(--accent)" stroke-dasharray="2 3"/>`);
        p.push(`<line x1="${X(T)}" x2="${X(T)}" y1="${Y(V)}" y2="${y0}" stroke="var(--accent)" stroke-dasharray="2 3"/>`);
        p.push(`<circle cx="${X(T)}" cy="${Y(V)}" r="5" fill="var(--accent)" stroke="#f9fbfe" stroke-width="2"/>`);
      }
      // label the reader's line near its right end, inside the frame
      // above and to the right of the point: a falling line stays clear of the text there
      let lab = false;
      const tw = L.you.length * fs * 0.6 + 10;
      const Tq = 10 ** (tMax - (tw / (x1 - x0)) * (tMax - tMin)), Vq = C / Tq ** n;
      if (Vq > 14 && Vq < 3000) { p.push(`<text x="${X(Tq) + 4}" y="${Y(Vq) - 9}" ${font} fill="var(--color-spark-400)" ${halo}>${L.you}</text>`); lab = true; }
      if (!lab) p.push(`<text x="${x1 - 6}" y="${y1 + 18}" ${font} fill="var(--color-spark-400)" text-anchor="end">${L.you}</text>`);
      p.push(`<text x="${x1}" y="${y0 + 38}" ${font} fill="var(--ink-2)" text-anchor="end">${L.x}</text>`);
      p.push(`<text x="${narrow ? 4 : x0}" y="${y1 - 12}" ${font} fill="var(--ink-2)">${L.y}</text>`);
      svg.innerHTML = p.join('');
    }
    new ResizeObserver(() => { const was = narrow; geometry(); if (was !== narrow || !svg.innerHTML) render(); }).observe(svg);
    geometry();
    ['n', 'C', 'V'].forEach((k) => i(k).addEventListener('input', render));
    render();
  });
</script>
