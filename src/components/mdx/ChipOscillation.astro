---
/**
 * Oscillation cutting, the mechanism: the feed axis swings back and forth while the spindle turns. Top panel: the
 * tool's axial position with the steady feed taken out, for this pass, against the surface the earlier passes left
 * (the furthest any of them reached at that angle). The chip is the gap; where this pass falls behind that surface
 * the tool runs in air and the chip is cut through. Bottom strip: the chip thickness, one colour per chip.
 * Controls: amplitude in feeds, oscillations per spindle revolution. Geometry in src/lib/oscillation.ts; no
 * maker's settings are implied. Drawn on the client so the drawing can switch to a narrow layout on phones.
 */
interface Props { locale: 'en' | 'tr' }
const { locale } = Astro.props;
const tr = locale === 'tr';
const T = tr
  ? { top: 'takımın eksenel konumu, sabit ilerleme hariç (f cinsinden)', strip: 'ilerleme yönünde talaş kalınlığı', now: 'bu devir', surf: 'önceki devirlerin bıraktığı yüzey', chip: 'talaş (her renk ayrı bir parça)', air: 'boşta', r1: '1. devir', r2: '2. devir', amp: 'Genlik / ilerleme', k: 'Devir başına salınım', breaks: 'Devir başına kırılma', share: 'Boşta geçen süre', yes: 'yollar kesişiyor: talaş kırılıyor', no: 'kesişme yok: talaş tek parça', play: 'Yeniden çiz', aria: 'Salınımlı kesme: ilerleme ekseni ileri geri salınır; bu devrin yolu önceki devirlerin bıraktığı yüzeyin gerisine düştüğünde takım boşta kalır ve talaş kesilir' }
  : { top: 'tool position along the axis, less the steady feed (in f)', strip: 'chip thickness in the feed direction', now: 'this revolution', surf: 'surface left by earlier revolutions', chip: 'chip (one colour per piece)', air: 'air', r1: 'revolution 1', r2: 'revolution 2', amp: 'Amplitude / feed', k: 'Oscillations per revolution', breaks: 'Breaks per revolution', share: 'Time in air', yes: 'paths cross: the chip breaks', no: 'no crossing: one unbroken chip', play: 'Draw again', aria: 'Oscillation cutting: the feed axis swings back and forth; where this revolution falls behind the surface the earlier revolutions left, the tool runs in air and the chip is cut through' };
const KS = [0.5, 1, 1.5, 2.5];
const num = (v: number) => (tr ? String(v).replace('.', ',') : String(v));
---
<div class="ox" data-ox data-locale={locale} data-anim>
  <svg class="plot" role="img" aria-label={T.aria} data-svg viewBox="0 0 640 300"></svg>
  <ul class="legend" aria-hidden="true">
    <li><span class="sw n"></span>{T.now}</li>
    <li><span class="sw s"></span>{T.surf}</li>
    <li><span class="sw c"></span>{T.chip}</li>
  </ul>
  <div class="ctl">
    <button type="button" class="play" data-play aria-label={T.play}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5a5.5 5.5 0 1 1-5.2 3.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M1.6 2.4 L3.2 6.6 L7 4.6 Z" fill="currentColor"/></svg></button>
    <label class="field"><span>{T.amp} <output data-o="a">0,80</output></span><input type="range" min="0" max="1.5" step="0.05" value="0.8" data-i="a" /></label>
    <div class="field"><span>{T.k}</span><div class="seg" data-g="k">{KS.map((k) => <button type="button" data-v={k} aria-pressed={String(k === 1.5)}>{num(k)}</button>)}</div></div>
  </div>
  <dl class="read">
    <div><dt>{T.breaks}</dt><dd class="num" data-o="b">—</dd></div>
    <div><dt>{T.share}</dt><dd class="num" data-o="s">—</dd></div>
    <div class="wide"><dt></dt><dd class="flag" data-o="fl">—</dd></div>
  </dl>
  <script type="application/json" data-text set:html={JSON.stringify(T)} />
</div>

<style>
  .ox { display: grid; gap: 0.75rem; }
  .plot { width: 100%; height: auto; display: block; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.35rem 1.1rem; margin: 0; padding: 0; list-style: none; font-size: 0.8rem; color: var(--ink-2); }
  .legend li { display: flex; align-items: center; gap: 0.4rem; margin: 0; }
  .legend .sw { display: inline-block; width: 1.4rem; height: 0; border-top: 3px solid; border-radius: 2px; }
  .legend .sw.n { border-color: #c94f0c; }
  .legend .sw.s { border-top: 2px dashed #2a6fd6; }
  .legend .sw.c { height: 0.7rem; border: 0; background: linear-gradient(90deg, #e3b23c 0 33%, #13998a 33% 66%, #8b52c9 66%); }
  .ctl { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr); gap: 0.8rem 1rem; align-items: end; }
  @media (max-width: 40rem) { .ctl { grid-template-columns: auto minmax(0, 1fr); } .ctl .field:last-child { grid-column: 1 / -1; } }
  .play { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--bg-raised); color: var(--accent); display: grid; place-items: center; cursor: pointer; }
  .play svg { width: 1.05rem; height: 1.05rem; }
  .field { display: grid; gap: 0.3rem; min-width: 0; }
  .field > span:first-child { font-size: 0.85rem; color: var(--ink-2); }
  .field output { color: var(--data); font-family: var(--font-mono); font-weight: 600; }
  .field input[type='range'] { width: 100%; accent-color: var(--accent); }
  .seg { display: flex; border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
  .seg button { flex: 1; font: inherit; font-size: 0.82rem; padding: 0.35rem 0.3rem; border: 0; background: var(--bg-raised); color: var(--ink-2); cursor: pointer; min-height: 2.1rem; }
  .seg button + button { border-left: 1px solid var(--line-strong); }
  .seg button[aria-pressed='true'] { background: var(--accent); color: #fff; }
  .read { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 0.75rem 1rem; margin: 0; }
  @media (max-width: 40rem) { .read { grid-template-columns: 1fr 1fr; } .read .wide { grid-column: 1 / -1; } }
  .read dt { font-size: 0.75rem; color: var(--ink-3); min-height: 1em; }
  .read dd { margin: 0.1rem 0 0; font: 600 1.05rem var(--font-mono); color: var(--ink); }
  .read dd.flag { font: 600 0.9rem var(--font-sans); align-self: end; }
  .ox[data-breaks] .flag { color: #0f7a6e; }
  .ox:not([data-breaks]) .flag { color: #b23a34; }
  .ox :global(.ax) { stroke: #c8d0d9; stroke-width: 1; }
  .ox :global(.ax0) { stroke: #9aa6b2; stroke-width: 1; stroke-dasharray: 2 3; }
  .ox :global(.cur) { fill: none; stroke: #c94f0c; stroke-width: 2.4; stroke-linejoin: round; }
  .ox :global(.srf) { fill: none; stroke: #2a6fd6; stroke-width: 1.8; stroke-dasharray: 6 4; }
  .ox :global(.t) { font: 12px var(--font-mono); fill: var(--ink-2); paint-order: stroke; stroke: #fff; stroke-width: 3px; }
  .ox :global(.t.h) { font: 600 11px var(--font-sans); fill: var(--ink-3); letter-spacing: 0.02em; }
  .ox :global(.t.air) { fill: #b23a34; font-size: 11px; }
  .ox :global(.pen) { fill: #e2601a; stroke: #fff; stroke-width: 2; }
</style>

<script>
  import { z, surface, thickness, analyse } from '../../lib/oscillation';
  import { whenIn } from '../../lib/motion';
  const COLORS = ['#e3b23c', '#13998a', '#8b52c9', '#e2601a', '#2a6fd6'];
  document.querySelectorAll<HTMLElement>('[data-ox]').forEach((root) => {
    const tr = root.dataset.locale === 'tr';
    const T = JSON.parse((root.querySelector('[data-text]') as HTMLElement).textContent || '{}');
    const q = <E extends Element>(s: string) => root.querySelector(s) as E;
    const svg = q<SVGSVGElement>('[data-svg]'), aIn = q<HTMLInputElement>('[data-i="a"]');
    let k = 1.5, upto = 720, raf = 0;
    const dec = (v: string) => (tr ? v.replace('.', ',') : v);
    const f1 = (v: number) => v.toFixed(1);
    const PHI0 = 360 * 12;                                            // steady state: well past the first revolutions
    const draw = () => {
      const a = Number(aIn.value);
      const narrow = root.clientWidth < 560;
      const W = narrow ? 420 : 640, L = 40, R = W - 14, H = 300;
      const yT0 = 30, yT1 = 176, yS0 = 214, yS1 = 268;               // top panel, strip
      const lo = -2.6, hi = 1.6;
      const X = (deg: number) => L + ((R - L) * deg) / 720;
      const Yt = (v: number) => yT1 - ((v - lo) / (hi - lo)) * (yT1 - yT0);
      const Ys = (h: number) => yS1 - (Math.min(h, 4) / 4) * (yS1 - yS0);
      const n = 720, cur: string[] = [], srf: string[] = [], hs: number[] = [];
      for (let i = 0; i <= n; i++) {
        const d = (720 * i) / n, phi = PHI0 + d;
        hs.push(thickness(phi, a, k));
        if (d > upto) continue;
        cur.push(`${f1(X(d))},${f1(Yt(z(phi, a, k) - phi / 360))}`);
        srf.push(`${f1(X(d))},${f1(Yt(surface(phi, a, k) - phi / 360))}`);
      }
      // chips: runs of h > 0, one colour each, in the top panel (between the paths) and in the strip
      let chips = '', strip = '', airLabel = '', c = 0, i = 0;
      while (i <= n) {
        if (hs[i] <= 1e-9) {
          const s0 = i; while (i <= n && hs[i] <= 1e-9) i++;
          const x0 = X((720 * s0) / n), x1 = X((720 * Math.min(i, n)) / n);
          if (!airLabel && x1 - x0 > 16 && (720 * s0) / n <= upto) airLabel = `<text x="${f1((x0 + x1) / 2)}" y="${f1(yS1 + 14)}" class="t air" text-anchor="middle">${T.air}</text>`;
          continue;
        }
        const s0 = i; while (i <= n && hs[i] > 1e-9) i++;
        const e0 = Math.min(i - 1, Math.floor((upto / 720) * n));
        if (e0 < s0) { c++; continue; }
        const col = COLORS[c++ % COLORS.length];
        const top: string[] = [], bot: string[] = [], st: string[] = [];
        for (let j = s0; j <= e0; j++) {
          const d = (720 * j) / n, phi = PHI0 + d;
          top.push(`${f1(X(d))},${f1(Yt(z(phi, a, k) - phi / 360))}`);
          bot.push(`${f1(X(d))},${f1(Yt(surface(phi, a, k) - phi / 360))}`);
          st.push(`${f1(X(d))},${f1(Ys(hs[j]))}`);
        }
        chips += `<path d="M${top.join(' L')} L${bot.reverse().join(' L')} Z" fill="${col}" fill-opacity="0.45"/>`;
        strip += `<path d="M${f1(X((720 * s0) / n))},${yS1} L${st.join(' L')} L${f1(X((720 * e0) / n))},${yS1} Z" fill="${col}" stroke="${col}" stroke-width="1"/>`;
      }
      const pd = Math.min(upto, 720), pphi = PHI0 + pd;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = `
        <text x="${L}" y="16" class="t h">${T.top}</text>
        <line x1="${L}" x2="${R}" y1="${f1(Yt(0))}" y2="${f1(Yt(0))}" class="ax0"/>
        <line x1="${L}" x2="${R}" y1="${f1(Yt(-1))}" y2="${f1(Yt(-1))}" class="ax0"/>
        <text x="${L - 6}" y="${f1(Yt(0) + 4)}" class="t" text-anchor="end">0</text>
        <text x="${L - 6}" y="${f1(Yt(-1) + 4)}" class="t" text-anchor="end">−f</text>
        <line x1="${f1(X(360))}" x2="${f1(X(360))}" y1="${yT0}" y2="${yS1}" class="ax"/>
        ${chips}
        <polyline points="${srf.join(' ')}" class="srf"/>
        <polyline points="${cur.join(' ')}" class="cur"/>
        <circle cx="${f1(X(pd))}" cy="${f1(Yt(z(pphi, a, k) - pphi / 360))}" r="5" class="pen"/>
        <text x="${L}" y="${yS0 - 10}" class="t h">${T.strip}</text>
        <line x1="${L}" x2="${R}" y1="${yS1}" y2="${yS1}" stroke="#364554" stroke-width="1"/>
        <line x1="${L}" x2="${R}" y1="${f1(Ys(1))}" y2="${f1(Ys(1))}" class="ax0"/>
        <text x="${L - 6}" y="${f1(Ys(1) + 4)}" class="t" text-anchor="end">f</text>
        ${strip}
        ${airLabel}
        <text x="${f1(X(180))}" y="${H - 6}" class="t" text-anchor="middle">${T.r1}</text>
        <text x="${f1(X(540))}" y="${H - 6}" class="t" text-anchor="middle">${T.r2}</text>`;
      const r = analyse(a, k);
      q('[data-o="a"]').textContent = dec(a.toFixed(2));
      q('[data-o="b"]').textContent = dec(String(Math.round(r.breaksPerRev * 10) / 10));
      const pc = Math.round(r.airShare * 100);
      q('[data-o="s"]').textContent = tr ? `%${pc}` : `${pc} %`;
      root.toggleAttribute('data-breaks', r.breaksPerRev > 0);
      q('[data-o="fl"]').textContent = r.breaksPerRev > 0 ? T.yes : T.no;
    };
    const run = () => {
      cancelAnimationFrame(raf);
      const t0 = performance.now(), ms = 4200;
      const step = (now: number) => {
        const u = Math.min(1, (now - t0) / ms);
        upto = 720 * u; draw();
        if (u < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const settle = () => { cancelAnimationFrame(raf); upto = 720; draw(); };
    root.querySelectorAll<HTMLButtonElement>('[data-g="k"] button').forEach((b, _, all) => b.addEventListener('click', () => {
      k = Number(b.dataset.v); all.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); settle();
    }));
    aIn.addEventListener('input', settle);
    q('[data-play]').addEventListener('click', run);
    new ResizeObserver(() => draw()).observe(root);
    draw();
    whenIn(root, run);
  });
</script>
