---
/** A drawing or interactive figure with a caption. Figures run wider than the reading column (see Article). */
interface Props { caption?: string; wide?: boolean }
const { caption, wide = false } = Astro.props;
---
<figure class:list={['fig', { wide }]}>
  <div class="fig-body"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin-block: 2.25rem !important; font-family: var(--font-sans); font-size: 1rem; line-height: 1.5; }
  .fig-body { position: relative; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 14px; padding: 1rem; overflow-x: auto; box-shadow: 0 1px 2px rgba(21, 34, 48, 0.04), 0 8px 24px -12px rgba(21, 34, 48, 0.12); }
  @media (max-width: 40rem) { .fig-body { padding: 0.6rem; border-radius: 10px; } }
  /* each figure carries a thin temper line along its top; it draws in as the figure scrolls into view */
  .fig-body::before { content: ""; position: absolute; left: 14px; right: 14px; top: 0; height: 3px; border-radius: 0 0 3px 3px; background: var(--temper); opacity: 0.9; pointer-events: none; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fig-body::before { animation: fig-temper linear both; animation-timeline: view(); animation-range: entry 10% cover 35%; }
    }
  }
  @keyframes fig-temper { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .fig-body :global(svg) { width: 100%; height: auto; min-width: 0; }
  figcaption { margin-top: 0.75rem; font-family: var(--font-sans); font-size: 0.9rem; color: var(--ink-3); line-height: 1.55; max-width: 52rem; }
</style>
