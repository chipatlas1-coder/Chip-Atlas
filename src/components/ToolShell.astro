---
/**
 * Shared frame for tool pages: reference line, title, lead, the tool
 * itself (default slot), then formulae / notes / sources slots.
 */
import Base from '../layouts/Base.astro';
import { href, routes, t, type Locale, type RouteKey } from '../i18n';
import { sections, sectionPath } from '../data/sections';

interface Props {
  locale: Locale;
  route: RouteKey;
  title: string;
  description: string;
  lead: string;
  sectionN: number;
  sources?: { label: string; url?: string }[];
  review?: boolean;
}
const { locale, route, title, description, lead, sectionN, sources = [], review = false } = Astro.props;
const ui = t(locale);
const other: Locale = locale === 'en' ? 'tr' : 'en';
const sec = sections.find((s) => s.n === sectionN)!;
---
<Base locale={locale} title={title} description={description} path={routes[route][locale]} altPath={routes[route][other]}>
  <article class="sheet tool-page">
    <header class="head">
      <p class="ref">
        <a href={href(routes.tools[locale])}>{ui.common.allTools}</a>
        <span aria-hidden="true"> / </span>
        <a href={href(sectionPath(locale, sec))}>{String(sec.n).padStart(2, '0')} {sec.name[locale]}</a>
      </p>
      <h1 class="h1">{title}</h1>
      <p class="lead">{lead}</p>
      <p class="marks">
        <span class="mark mark-live">{ui.status.live}</span>
        {review && <span class="mark mark-review">{ui.status.review}</span>}
      </p>
    </header>

    <slot />

    {Astro.slots.has('formulae') && (
      <section class="block">
        <h2 class="h2">{ui.common.formulae}</h2>
        <slot name="formulae" />
      </section>
    )}
    {Astro.slots.has('notes') && (
      <section class="block prose">
        <h2 class="h2">{ui.common.notes}</h2>
        <slot name="notes" />
      </section>
    )}
    {sources.length > 0 && (
      <details class="sources-box">
        <summary>{ui.common.sources} ({sources.length})</summary>
        <ol class="sources">
          {sources.map((src) => (
            <li>{src.url ? <a href={src.url} rel="noopener">{src.label}</a> : src.label}</li>
          ))}
        </ol>
      </details>
    )}
  </article>
</Base>

<style>
  .tool-page { padding-block: 2.5rem 1rem; }
  .head { display: grid; gap: 0.75rem; margin-bottom: 2rem; }
  .ref a:hover { color: var(--accent); }
  .marks { display: flex; gap: 1rem; }
  .block { margin-top: 3rem; display: grid; gap: 1rem; }
  /* sources stay in a closed box, as on the article pages */
  .sources-box { margin-top: 3rem; max-width: 42rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-raised); }
  .sources-box summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.95rem 1.15rem; font-weight: 600; font-size: 0.98rem; color: var(--ink-2); }
  .sources-box summary::-webkit-details-marker { display: none; }
  .sources-box summary::after { content: ""; width: 0.55rem; height: 0.55rem; border-right: 2px solid var(--ink-3); border-bottom: 2px solid var(--ink-3); transform: rotate(45deg) translateY(-2px); transition: transform 180ms; }
  .sources-box[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .sources-box summary:hover { color: var(--ink); }
  .sources { display: grid; gap: 0.45rem; font-size: 0.84rem; line-height: 1.45; color: var(--ink-3); padding: 0.25rem 1.15rem 1.15rem 2.4rem; list-style: decimal; }
  .sources a { color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .sources a:hover { color: var(--data); text-decoration-color: currentColor; }
</style>

<style is:global>
  .tool-grid-2 { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 1.5rem; align-items: start; }
  @media (max-width: 60rem) { .tool-grid-2 { grid-template-columns: 1fr; } }
  .inputs { padding: 1.25rem; display: grid; gap: 1rem; }
  .results { padding: 1.25rem; display: grid; gap: 1rem; }
  .results-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem 1.5rem; }
  @media (min-width: 40rem) { .results-grid { grid-template-columns: repeat(3, 1fr); } }
  .figure { background: var(--bg-sunk); border: 1px solid var(--line); border-radius: 4px; padding: 0.5rem; }
  .figure svg { width: 100%; height: auto; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { font-family: var(--font-mono); font-size: 0.8rem; padding: 0.3rem 0.55rem; border: 1px solid var(--line-strong); border-radius: 3px; color: var(--ink-2); }
  .chip:hover { border-color: var(--ink-2); color: var(--ink); }
  .chip[aria-pressed="true"] { border-color: var(--accent); color: var(--ink); }
  .warn { font-size: 0.88rem; color: var(--color-spark-200); border-left: 2px solid var(--accent); padding: 0.4rem 0.75rem; background: color-mix(in oklab, var(--accent) 8%, transparent); border-radius: 0 3px 3px 0; }
  .hint { font-size: 0.85rem; color: var(--ink-3); }
</style>
