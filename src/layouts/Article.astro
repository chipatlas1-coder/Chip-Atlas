---
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import { render } from 'astro:content';
import { href, routes, t, type RouteKey } from '../i18n';
import { sections, sectionPath } from '../data/sections';
import { tools } from '../data/tools';
import { articlePath, alternatePath, articlesFor, type Article } from '../lib/articles';
import Figure from '../components/mdx/Figure.astro';
import Note from '../components/mdx/Note.astro';
import Plate from '../components/plates/Plate.astro';
import { hasPlate } from '../data/plates';

interface Props { entry: Article }
const { entry } = Astro.props;
const { data } = entry;
const locale = data.locale;
const ui = t(locale);
const tr = locale === 'tr';
const sec = sections.find((s) => s.n === data.section)!;
const sub = sec.subsections.find((s) => s.slug.en === data.subsection);
const path = articlePath(entry);
const alt = await alternatePath(entry);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

// Live tools linked from this article (route keys), resolved to names.
const linked = data.tools
  .map((key) => ({ key: key as RouteKey, tool: tools.find((x) => x.route === key && x.status === 'live') }))
  .filter((x) => x.tool && routes[x.key]);

// Previous / next article in the same section.
const siblings = (await articlesFor(locale)).filter((a) => a.data.section === data.section);
const i = siblings.findIndex((a) => a.id === entry.id);
const prev = i > 0 ? siblings[i - 1] : undefined;
const next = i >= 0 && i < siblings.length - 1 ? siblings[i + 1] : undefined;

const dateFmt = new Intl.DateTimeFormat(tr ? 'tr-TR' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const words = (entry.body ?? '').replace(/^---[\s\S]*?---/, '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(2, Math.round(words / 200));
const copy = tr
  ? { updated: 'Güncellendi', review: 'Bu sayfa uzman incelemesinde; değerler kaynaklıdır ancak son onay bekliyor.', onPage: 'Bu sayfada', tools: 'Bu konunun araçları', prev: 'Önceki', next: 'Sonraki', glance: 'Bir bakışta', sources: (n: number) => `Kaynaklar (${n})`, sourcesNote: 'Bu sayfadaki her değer ve alıntı aşağıdaki belgelerden alındı.', read: (m: number) => `${m} dk okuma` }
  : { updated: 'Updated', review: 'This page is in expert review; its values are sourced but await final sign-off.', onPage: 'On this page', tools: 'Tools for this topic', prev: 'Previous', next: 'Next', glance: 'At a glance', sources: (n: number) => `Sources (${n})`, sourcesNote: 'Every value and quotation on this page comes from the documents below.', read: (m: number) => `${m} min read` };
// glance labels are plain text from YAML; *word* marks an English term in italics (TR house style)
const glanceHtml = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\*([^*]+)\*/g, '<em>$1</em>');
---
<Base locale={locale} title={data.title} description={data.description} path={path} altPath={alt}>
  <div class="progress-line" aria-hidden="true"></div>
  <article class="sheet article">
    <header class:list={['head', { 'has-plate': hasPlate(data.key) }]}>
      <div class="head-text">
        <p class="crumb">
          <a href={href(sectionPath(locale, sec))}>{sec.name[locale]}</a>
          {sub && <><span class="sep" aria-hidden="true">/</span><span>{sub.name[locale]}</span></>}
        </p>
        <h1 class="h1">{data.title}</h1>
        <p class="lead">{data.description}</p>
        <p class="marks">
          {data.status === 'live'
            ? <span class="mark mark-live">{ui.status.live}</span>
            : <span class="mark mark-review">{ui.status.review}</span>}
          <span class="muted">{copy.updated} {dateFmt.format(data.updated)}</span>
          <span class="muted">{copy.read(minutes)}</span>
        </p>
        {data.status === 'review' && <p class="hint">{copy.review}</p>}
      </div>
      {hasPlate(data.key) && <div class="head-plate"><Plate k={data.key} locale={locale} mode="hero" /></div>}
    </header>
    <div class="temper" aria-hidden="true"></div>

    {data.glance.length > 0 && (
      <dl class="glance" aria-label={copy.glance}>
        {data.glance.map((g, i) => (
          <div class="g" style={`--i:${i}`}>
            <dt class="g-lab" set:html={glanceHtml(g.label)} />
            <dd class="g-val">{g.value}{g.unit && <small>{g.unit}</small>}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="layout">
      <aside class="side">
        {toc.length > 2 && (
          <nav class="toc" aria-label={copy.onPage}>
            <p class="side-h">{copy.onPage}</p>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )}
        {linked.length > 0 && (
          <div class="side-tools">
            <p class="side-h">{copy.tools}</p>
            {linked.map(({ key, tool }) => (
              <a class="tool-link" href={href(routes[key][locale])}>
                <span class="tool-name">{tool!.name[locale]}</span>
                <span class="tool-go" aria-hidden="true"></span>
              </a>
            ))}
          </div>
        )}
      </aside>
      <div class="main-col">
        <div class="body prose-article">
          <Content components={{ Figure, Note }} />
        </div>

        {data.sources.length > 0 && (
          <details class="sources-box">
            <summary>{copy.sources(data.sources.length)}</summary>
            <p class="sources-note">{copy.sourcesNote}</p>
            <ol class="sources">
              {data.sources.map((src) => (
                <li>{src.url ? <a href={src.url} rel="noopener">{src.label}</a> : src.label}</li>
              ))}
            </ol>
          </details>
        )}

        <nav class="pager" aria-label={tr ? 'Makaleler arası geçiş' : 'Article navigation'}>
          {prev ? <a href={href(articlePath(prev))}><span class="pg-dir">{copy.prev}</span><span class="pg-t">{prev.data.title}</span></a> : <span />}
          {next ? <a class="right" href={href(articlePath(next))}><span class="pg-dir">{copy.next}</span><span class="pg-t">{next.data.title}</span></a> : <span />}
        </nav>
      </div>
    </div>
  </article>
</Base>

<script>
  // Table of contents follows the reader; tables highlight the column under the pointer.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length) {
    const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const heads = [...document.querySelectorAll<HTMLElement>('.prose-article h2[id]')].filter((h) => map.has(h.id));
    const set = (id: string) => links.forEach((a) => a.setAttribute('aria-current', String(map.get(id) === a)));
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) set(visible[0].target.id);
    }, { rootMargin: '-15% 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
  }
  document.querySelectorAll<HTMLTableElement>('.table-frame table').forEach((table) => {
    let col = -1;
    const mark = (i: number) => {
      if (i === col) return;
      col = i;
      table.querySelectorAll('.col-hi').forEach((c) => c.classList.remove('col-hi'));
      if (i < 1) return;
      table.querySelectorAll('tr').forEach((tr) => tr.children[i]?.classList.add('col-hi'));
    };
    table.addEventListener('pointerover', (e) => {
      const cell = (e.target as HTMLElement).closest('td, th') as HTMLTableCellElement | null;
      mark(cell ? cell.cellIndex : -1);
    });
    table.addEventListener('pointerleave', () => mark(-1));
  });
</script>

<style>
  .article { padding-block: 2.75rem 1rem; }
  .head { display: grid; gap: 2rem; margin-bottom: 1.75rem; }
  .head-text { display: grid; gap: 0.9rem; align-content: center; max-width: 50rem; }
  @media (min-width: 64rem) {
    .head.has-plate { grid-template-columns: minmax(0, 1fr) minmax(0, 31rem); gap: 3.5rem; align-items: center; }
  }
  .crumb { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 0.92rem; font-weight: 500; color: var(--ink-3); }
  .crumb a { color: var(--accent-text); }
  .crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .crumb .sep { color: var(--line-strong); }
  .h1 { font-weight: 650; letter-spacing: -0.028em; line-height: 1.04; color: var(--ink); }
  .lead { font-family: var(--font-serif); font-size: clamp(1.12rem, 1rem + 0.45vw, 1.32rem); line-height: 1.55; color: var(--ink-2); max-width: 44rem; }
  .marks { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; align-items: center; font-size: 0.86rem; }
  @media (prefers-reduced-motion: no-preference) {
    .head-text > * { animation: head-in 0.7s cubic-bezier(0.16, 0.84, 0.3, 1) both; }
    .head-text > :nth-child(2) { animation-delay: 60ms; }
    .head-text > :nth-child(3) { animation-delay: 120ms; }
    .head-text > :nth-child(n+4) { animation-delay: 180ms; }
    .temper { animation: temper-in 1.1s 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
    .glance .g { animation: head-in 0.6s cubic-bezier(0.16, 0.84, 0.3, 1) both; animation-delay: calc(700ms + var(--i) * 90ms); }
  }
  @keyframes head-in { from { opacity: 0; transform: translateY(12px); } }
  @keyframes temper-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

  /* the temper strip: heat colours on steel, the page's one signature mark */
  .temper { height: 6px; border-radius: 3px; background: var(--temper); margin-bottom: 2rem; }

  .glance {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.75rem;
    margin-bottom: 3rem;
  }
  .g { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.45rem; padding: 1rem 1.1rem 1.05rem; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 12px; border-top: 4px solid var(--gc); }
  .g:nth-child(4n+1) { --gc: var(--color-temper-blue); }
  .g:nth-child(4n+2) { --gc: var(--color-spark-500); }
  .g:nth-child(4n+3) { --gc: var(--color-temper-teal); }
  .g:nth-child(4n+4) { --gc: var(--color-temper-purple); }
  @media (max-width: 40rem) { .glance { grid-template-columns: 1fr 1fr; gap: 0.5rem; } .g { padding: 0.8rem 0.8rem 0.9rem; } }
  .g-val { font-family: var(--font-sans); font-size: clamp(1.25rem, 1rem + 0.9vw, 1.7rem); font-weight: 650; color: var(--ink); letter-spacing: -0.02em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .g-val small { font-size: 0.8rem; color: var(--ink-3); margin-left: 0.3rem; font-weight: 400; letter-spacing: 0; }
  .g-lab { font-size: 0.86rem; color: var(--ink-2); line-height: 1.4; }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  @media (min-width: 80rem) { .layout { grid-template-columns: 13rem minmax(0, 1fr); gap: 3.5rem; } }
  .side { display: grid; gap: 1.75rem; }
  @media (min-width: 80rem) { .side { position: sticky; top: calc(3.5rem + 1.75rem + env(safe-area-inset-top, 0px)); max-height: calc(100dvh - 6rem); overflow-y: auto; } }
  @media (max-width: 79.99rem) { .toc { display: none; } .side:not(:has(.side-tools)) { display: none; } }
  .side-h { font-size: 0.8rem; font-weight: 600; color: var(--ink-3); margin-bottom: 0.6rem; }
  .toc ol { display: grid; gap: 0.1rem; font-size: 0.9rem; border-left: 2px solid var(--line); }
  .toc a { display: block; color: var(--ink-3); padding: 0.3rem 0 0.3rem 0.9rem; margin-left: -2px; border-left: 2px solid transparent; line-height: 1.35; transition: color 160ms, border-color 160ms; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current="true"] { color: var(--ink); font-weight: 600; border-left-color: var(--accent); }
  .side-tools { display: grid; gap: 0.5rem; }
  .tool-link { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 0.75rem 0.9rem; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 10px; transition: border-color 150ms, box-shadow 150ms; }
  .tool-link:hover { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 14%, transparent); }
  .tool-name { font-weight: 600; font-size: 0.95rem; }
  .tool-go { width: 0.55rem; height: 0.55rem; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); transform: rotate(45deg); flex: none; }

  .sources-box { margin-top: 3.5rem; max-width: 42rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-raised); }
  .sources-box summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.95rem 1.15rem; font-weight: 600; font-size: 0.98rem; color: var(--ink-2); }
  .sources-box summary::-webkit-details-marker { display: none; }
  .sources-box summary::after { content: ""; width: 0.55rem; height: 0.55rem; border-right: 2px solid var(--ink-3); border-bottom: 2px solid var(--ink-3); transform: rotate(45deg) translateY(-2px); transition: transform 180ms; }
  .sources-box[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .sources-box summary:hover { color: var(--ink); }
  .sources-note { padding: 0 1.15rem; font-size: 0.86rem; color: var(--ink-3); }
  .sources { display: grid; gap: 0.45rem; font-size: 0.84rem; line-height: 1.45; color: var(--ink-3); padding: 0.75rem 1.15rem 1.15rem 2.4rem; list-style: decimal; }
  .sources a { color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .sources a:hover { color: var(--link); text-decoration-color: currentColor; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3.5rem; max-width: 62rem; }
  .pager a { display: grid; gap: 0.3rem; padding: 1rem 1.15rem; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 12px; transition: border-color 160ms, box-shadow 160ms; }
  .pager a:hover { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 12%, transparent); }
  .pager .right { text-align: right; grid-column: 2; }
  .pg-dir { font-size: 0.8rem; color: var(--ink-3); }
  .pg-t { font-weight: 600; }
</style>

<style is:global>
  /* Reading column 42 rem in the serif; figures, tables and formulas run wider (62 rem) so the
     animations get room. */
  .prose-article { font-family: var(--font-serif); font-size: 1.125rem; line-height: 1.72; color: var(--ink); min-width: 0; font-optical-sizing: auto; }
  .prose-article > * { max-width: 42rem; }
  .prose-article > .fig, .prose-article > .table-frame, .prose-article > .katex-display, .prose-article > .note { max-width: 62rem; }
  .prose-article > .note { max-width: 46rem; }
  .prose-article > * + * { margin-top: 1.15rem; }
  .prose-article h2 { font-family: var(--font-sans); font-size: var(--text-h2); font-weight: 650; letter-spacing: -0.02em; margin-top: 3.25rem; scroll-margin-top: 5rem; color: var(--ink); }
  .prose-article h3 { font-family: var(--font-sans); font-size: var(--text-h3); font-weight: 650; margin-top: 2.2rem; scroll-margin-top: 5rem; }
  .prose-article h2 + *, .prose-article h3 + * { margin-top: 0.8rem; }
  .prose-article p, .prose-article li { color: var(--ink); }
  .prose-article strong { color: var(--ink); font-weight: 650; }
  .prose-article ul { list-style: disc; padding-left: 1.4rem; display: grid; gap: 0.45rem; }
  .prose-article ol { list-style: decimal; padding-left: 1.4rem; display: grid; gap: 0.45rem; }
  .prose-article li::marker { color: var(--accent); }
  .prose-article a { color: var(--link); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--link) 40%, transparent); text-underline-offset: 3px; }
  .prose-article a:hover { text-decoration-color: currentColor; }
  .prose-article code { font-size: 0.86em; background: #eef2f6; padding: 0.12em 0.38em; border-radius: 4px; }
  .prose-article .katex-display { overflow-x: auto; overflow-y: hidden; padding: 1.1rem 1.25rem; background: var(--bg-raised); border: 1px solid var(--line); border-left: 4px solid var(--data); border-radius: 0 12px 12px 0; margin-block: 1.5rem; }
  .prose-article .katex { font-size: 1.1em; color: var(--ink); }
  .prose-article td, .prose-article th { font-family: var(--font-sans); }
  .prose-article td { color: var(--ink-2); }
  .prose-article .table-frame { margin-block: 1.75rem; }
  .prose-article hr { border: 0; border-top: 1px solid var(--line); margin-block: 2rem; }
</style>
